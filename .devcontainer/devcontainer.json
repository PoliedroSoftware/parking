{
  "name": "Poliedro Parking Mobile",
  "image": "mcr.microsoft.com/dotnet/sdk:10.0",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "dotnet workload install maui-android --skip-manifest-update && dotnet restore parkin-distribuido/parking-movile/ParkingMaui.slnx",
  "forwardPorts": [5221, 5057],
  "portsAttributes": {
    "5221": {
      "label": "Parking API"
    },
    "5057": {
      "label": "Parking frontend"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.dotnet-maui",
        "ms-androidtools.vscode-android"
      ],
      "settings": {
        "dotnet.defaultSolution": "parkin-distribuido/parking-movile/ParkingMaui.slnx"
      }
    }
  }
}
