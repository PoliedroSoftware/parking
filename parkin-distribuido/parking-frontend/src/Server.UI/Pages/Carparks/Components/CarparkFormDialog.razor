@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.AddEdit

@inherits MudComponentBase
@inject IValidationService Validator

<MudDialog>
    <DialogContent>
        <MudForm Model="@_model" @ref="@_form">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField Label="Codigo" @bind-Value="_model.Name.Code" ReadOnly="true" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudTextField Label="Nombre del Parqueadero" @bind-Value="_model.Name.Tc" Required="true"
                                  Variant="Variant.Outlined" RequiredError="El nombre es requerido"></MudTextField>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Direccion" @bind-Value="_model.Address.Tc" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Label="Persona de Contacto" @bind-Value="_model.ContactPerson" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField Label="Telefono" @bind-Value="_model.PhoneNumber" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField Label="Capacidad Carros" @bind-Value="_carCapacity" Min="0" Variant="Variant.Outlined"></MudNumericField>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField Label="Capacidad Motos" @bind-Value="_motoCapacity" Min="0" Variant="Variant.Outlined"></MudNumericField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudLoadingButton Loading="@_saving" OnClick="OnSubmit" Color="Color.Primary" Variant="Variant.Filled">Guardar</MudLoadingButton>
    </DialogActions>
</MudDialog>

@code {
    MudForm _form = new();
    private bool _saving;
    private int _carCapacity;
    private int _motoCapacity;
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [EditorRequired] [Parameter] public AddEditCarparkCommand _model { get; set; } = null!;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(_model.Name.Code))
            _model.Name.Code = $"PK-{DateTime.Now:yyMMdd}-{Random.Shared.Next(100, 999)}";
    }

    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _form.Validate();
            if (!_form.IsValid) return;
            _model.Name.En = _model.Name.Tc;
            _model.Address.En = _model.Address.Tc;
            _model.Description = $"Carros: {_carCapacity}, Motos: {_motoCapacity}";
            var result = await Mediator.Send(_model);
            result.Match(data => { MudDialog.Close(DialogResult.Ok(true)); Snackbar.Add("Parqueadero guardado", Severity.Success); },
                          errors => Snackbar.Add(errors, Severity.Error));
        }
        finally { _saving = false; }
    }

    void Cancel() => MudDialog.Cancel();
}
