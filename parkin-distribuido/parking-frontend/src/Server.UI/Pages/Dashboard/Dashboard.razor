@page "/"
@using CleanArchitecture.Blazor.Domain.Entities
@using CleanArchitecture.Blazor.Server.UI.Services

@inject IApplicationDbContextFactory DbFactory
@inject ParkingSessionService ParkingService
@inject NavigationManager Navigation

<PageTitle>Poliedro Software - Panel</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-2">
    @* Quick Access Cards *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="4" Class="quick-card" Style="background:linear-gradient(135deg,#1a237e 0%,#283593 100%);">
                <MudCardContent>
                    <MudNavLink Href="/pages/tickets" Style="color:inherit;text-decoration:none;width:100%;">
                    <div class="d-flex align-center" style="gap:16px;">
                        <MudIcon Icon="@Icons.Material.Filled.LocalParking" Style="font-size:48px;color:#fff;" />
                        <div>
                            <MudText Typo="Typo.h5" Style="color:#fff;font-weight:700;">PARQUEO</MudText>
                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.8);">Entrada y Salida</MudText>
                        </div>
                    </div>
                    </MudNavLink>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="4" Class="quick-card" Style="background:linear-gradient(135deg,#01579b 0%,#0277bd 100%);">
                <MudCardContent>
                    <MudNavLink Href="/pages/carwashes" Style="color:inherit;text-decoration:none;width:100%;">
                    <div class="d-flex align-center" style="gap:16px;">
                        <MudIcon Icon="@Icons.Material.Filled.LocalCarWash" Style="font-size:48px;color:#fff;" />
                        <div>
                            <MudText Typo="Typo.h5" Style="color:#fff;font-weight:700;">LAVADO</MudText>
                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.8);">Carros y Motos</MudText>
                        </div>
                    </div>
                    </MudNavLink>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudCard Elevation="4" Class="quick-card" Style="background:linear-gradient(135deg,#004d40 0%,#00695c 100%);">
                <MudCardContent>
                    <MudNavLink Href="/pages/members" Style="color:inherit;text-decoration:none;width:100%;">
                    <div class="d-flex align-center" style="gap:16px;">
                        <MudIcon Icon="@Icons.Material.Filled.CardMembership" Style="font-size:48px;color:#fff;" />
                        <div>
                            <MudText Typo="Typo.h5" Style="color:#fff;font-weight:700;">MENSUALIDAD</MudText>
                            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.8);">Miembros y Pagos</MudText>
                        </div>
                    </div>
                    </MudNavLink>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.h5">Resumen - @DateTime.Now.ToString("MMMM yyyy")</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" 
                   OnClick="RefreshData" Size="Size.Small">Actualizar</MudButton>
    </MudStack>

    @* Ingresos por Categoria *@
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Style="background:#e8f5e9;">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Ingresos Parqueo</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Success">$ @_ingresosParqueo.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption">Salidas cobradas: @_totalSalidas</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Style="background:#e3f2fd;">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Ingresos Lavado</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Primary">$ @_ingresosLavado.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption">Servicios: @_totalLavados</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Style="background:#f3e5f5;">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Ingresos Mensualidad</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Tertiary">$ @_ingresosMensualidad.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption">Miembros activos: @_miembrosActivos</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="3" Style="background:#ffebee;">
                <MudCardContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Gastos Operativos</MudText>
                    <MudText Typo="Typo.h4" Color="Color.Error">$ @_gastosTotales.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption">Registros: @_totalGastos</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* UTILIDAD NETA *@
    <MudCard Elevation="4" Class="mb-6">
        <MudCardContent Class="text-center pa-6" Style="background:linear-gradient(135deg,#1a237e,#283593);">
            <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,0.7);">UTILIDAD NETA DEL MES</MudText>
            <MudText Typo="Typo.h2" Style="color:#fff;font-weight:800;font-size:52px;" Class="utilidad-neta">
                $ @_utilidadNeta.ToString("N0")
            </MudText>
        </MudCardContent>
    </MudCard>

    @* Miembros y Parqueos *@
    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Miembros del Mes</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    @if (_miembrosRecientes.Any())
                    {
                        <div class="mud-data-grid-responsive">
                        <MudTable Items="@_miembrosRecientes.Take(8)" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Nombre</MudTh>
                                <MudTh>Placa</MudTh>
                                <MudTh>Telefono</MudTh>
                                <MudTh>Vence</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Name</MudTd>
                                <MudTd><strong>@context.LicensePlate</strong></MudTd>
                                <MudTd>@context.PhoneNumber</MudTd>
                                <MudTd>@context.ExpiryDate.ToString("dd/MM")</MudTd>
                             </RowTemplate>
                        </MudTable>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">Sin miembros registrados</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Parqueos Activos (@ParkingService.ActiveSessionCount)</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    @if (ParkingService.ActiveSessions.Any())
                    {
                        <div class="mud-data-grid-responsive">
                        <MudTable Items="@ParkingService.ActiveSessions.ToList()" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Placa</MudTh>
                                <MudTh>Entrada</MudTh>
                                <MudTh>Tiempo</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><strong>@context.LicensePlate</strong></MudTd>
                                <MudTd>@context.EntryTime.ToString("HH:mm")</MudTd>
                                <MudTd>@FormatDuration(DateTime.Now - context.EntryTime)</MudTd>
                            </RowTemplate>
                        </MudTable>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">No hay parqueos activos</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int _ingresosParqueo;
    private int _ingresosLavado;
    private int _ingresosMensualidad;
    private int _gastosTotales;
    private int _utilidadNeta;
    private int _totalSalidas;
    private int _totalLavados;
    private int _totalGastos;
    private int _miembrosActivos;
    private List<Member> _miembrosRecientes = new();

    protected override async Task OnInitializedAsync()
    {
        try { await LoadData(); }
        catch (Exception ex) { Console.WriteLine($"Dashboard error: {ex.Message}"); }
    }

    private async Task LoadData()
    {
        var firstDay = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        await using var db = await DbFactory.CreateAsync();

        _miembrosRecientes = await db.Members.OrderByDescending(m => m.Id).Take(20).ToListAsync();
        _miembrosActivos = await db.Members.CountAsync(m => m.IsActive);

        _totalLavados = await db.CarWashes.CountAsync(c => c.StartTime.HasValue && c.StartTime.Value >= firstDay);
        var paidWashes = await db.CarWashes
            .Where(c => c.StartTime.HasValue && c.StartTime.Value >= firstDay && c.IsPaid)
            .Select(c => (int?)c.Price).ToListAsync();
        _ingresosLavado = paidWashes.Sum(p => p ?? 0);

        var rentals = await db.MemberRentals
            .Where(r => r.PaymentTime >= firstDay)
            .Select(r => (int?)r.AmountPaid).ToListAsync();
        _ingresosMensualidad = rentals.Sum(r => r ?? 0);

        var expenses = await db.Expenses.Where(e => e.Date >= firstDay).Select(e => (int?)e.Amount).ToListAsync();
        _gastosTotales = expenses.Sum(e => e ?? 0);
        _totalGastos = expenses.Count;

        var parkingRevenue = await db.ParkingRecords
            .Where(p => p.Status == "Completado" && p.ExitTime.HasValue && p.ExitTime.Value >= firstDay)
            .SumAsync(p => (int?)p.Amount) ?? 0;
        _ingresosParqueo = (int)parkingRevenue;
        _totalSalidas = await db.ParkingRecords
            .CountAsync(p => p.Status == "Completado" && p.ExitTime.HasValue && p.ExitTime.Value >= firstDay);

        _utilidadNeta = _ingresosParqueo + _ingresosLavado + _ingresosMensualidad - _gastosTotales;
    }

    private async Task RefreshData()
    {
        try { await LoadData(); await InvokeAsync(StateHasChanged); }
        catch (Exception ex) { Console.WriteLine($"Refresh error: {ex.Message}"); }
    }

    private string FormatDuration(TimeSpan d)
    {
        if (d.TotalHours >= 1) return $"{(int)d.TotalHours}h {d.Minutes}m";
        return $"{d.Minutes} min";
    }
}
