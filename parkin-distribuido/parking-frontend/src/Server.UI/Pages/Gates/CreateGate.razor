@page "/pages/gates/create"
@using CleanArchitecture.Blazor.Application.Features.Gates.Commands.Create

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Gates> L
@attribute [Authorize(Policy = Permissions.Gates.Create)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                 <MudText Typo="Typo.h6">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
        <MudForm Model="@_model" @ref="@_gateForm" Validation="@(Validator.ValidateValue(_model))">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.Name)]" @bind-Value="_model.Name" For="@(() => _model.Name)" Required="true" RequiredError="@L["name is required!"]"></MudTextField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.ZoneId)]" @bind-Value="_model.ZoneId" For="@(() => _model.ZoneId)" Min="0" Required="false" RequiredError="@L["zone id is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudEnumSelect TEnum="Nullable<GateType>" Label="@L[_model.GetMemberDescription(x=>x.GateType)]" @bind-Value="_model.GateType" For="@(() => _model.GateType)" Required="false" RequiredError="@L["gate type is required!"]"></MudEnumSelect>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.LaneNo)]" @bind-Value="_model.LaneNo" For="@(() => _model.LaneNo)" Min="0" Required="false" RequiredError="@L["lane no is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudCheckBox Label="@L[_model.GetMemberDescription(x=>x.IsUpper)]" @bind-Value="_model.IsUpper" For="@(() => _model.IsUpper)" Color="Color.Primary" ></MudCheckBox>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudCheckBox Label="@L[_model.GetMemberDescription(x=>x.IsLefthand)]" @bind-Value="_model.IsLefthand" For="@(() => _model.IsLefthand)" Color="Color.Primary" ></MudCheckBox>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudCheckBox Label="@L[_model.GetMemberDescription(x=>x.IsActive)]" @bind-Value="_model.IsActive" For="@(() => _model.IsActive)" Color="Color.Primary" ></MudCheckBox>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.Description)]"  For="@(() => _model.Description)" @bind-Value="_model.Description"></MudTextField>
                </MudItem> 

            </MudGrid>
        </MudForm>
        </MudCardContent>
         <MudCardActions Class="d-flex justify-end gap-2">
                    <MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
         </MudCardActions>
        </MudCard>
</MudContainer>
 

@code {
    public string? Title { get; private set; }
    MudForm _gateForm = new();
    private bool _saving = false;
    private List<BreadcrumbItem>? _breadcrumbItems;
    private CreateGateCommand _model = new();
    protected override Task OnInitializedAsync()
    {
        Title = L["New Gate"];
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem(L["Home"], href: "/"),
            new BreadcrumbItem(L["Gates"], href: "/pages/gates"),
            new BreadcrumbItem(L["Create Gate"], href:null, disabled:true)
        };
        return Task.CompletedTask;
    }
    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _gateForm.Validate().ConfigureAwait(false);
            if (!_gateForm.IsValid)
                return;
            var result = await Mediator.Send(_model);
            result.Match(
                data=>
                {
                    Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                    Navigation.NavigateTo($"/pages/Gates");
                },
                errors=>
                {
                    Snackbar.Add(errors, MudBlazor.Severity.Error);
                });
        }
        finally
        {
            _saving = false;
        }
    }
}