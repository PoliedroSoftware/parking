@page "/pages/memberrentals/edit/{id:int}"
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Commands.Update
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Queries.GetById
@using CleanArchitecture.Blazor.Server.UI.Components.Sessions
@using CleanArchitecture.Blazor.Domain.Constants
@using CleanArchitecture.Blazor.Domain.Entities

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<MemberRentals> L
@inject IApplicationDbContextFactory DbFactory
@attribute [Authorize(Policy = Permissions.MemberRentals.Edit)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
@if (_model != null)
{
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                 <MudText Typo="Typo.h6">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
        <ActiveUserSession PageComponent="@($"{nameof(EditMemberRental)}/{ _model.Id }")" />
        <MudForm Model="@_model" @ref="@_memberrentalForm" Validation="@(Validator.ValidateValue(_model))">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.MemberId)]" @bind-Value="_model.MemberId" For="@(() => _model.MemberId)" Min="0" Required="false" RequiredError="@L["member id is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.LicensePlate)]" @bind-Value="_model.LicensePlate" For="@(() => _model.LicensePlate)" Required="false" RequiredError="@L["license plate is required!"]"></MudTextField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.CardId)]" @bind-Value="_model.CardId" For="@(() => _model.CardId)" Required="false" RequiredError="@L["card id is required!"]"></MudTextField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudDatePicker ShowToolbar="false" Label="@L[_model.GetMemberDescription(x=>x.StartDate)]" @bind-Date="_model.StartDate" For="@(() => _model.StartDate)" Required="false" RequiredError="@L["start date is required!"]"></MudDatePicker>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudDatePicker ShowToolbar="false" Label="@L[_model.GetMemberDescription(x=>x.ExpiryDate)]" @bind-Date="_model.ExpiryDate" For="@(() => _model.ExpiryDate)" Required="false" RequiredError="@L["expiry date is required!"]"></MudDatePicker>
                </MudItem> 
<MudItem xs="12" md="6">
                        <MudSelect T="int?" Label="Tarifa mensual" Value="_selectedMonthlyRateId" ValueChanged="OnMonthlyRateSelected" Clearable="true">
                            @foreach (var rate in _monthlyRates)
                            {
                                <MudSelectItem T="int?" Value="@((int?)rate.Id)">
                                    @rate.Name - @rate.VehicleType.GetDescription() ($ @rate.MonthlyFee.ToString("N0"))
                                </MudSelectItem>
                            }
                        </MudSelect>
                </MudItem>
<MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.RentalFee)]" @bind-Value="_model.RentalFee" For="@(() => _model.RentalFee)" Min="0.00m" Required="false" RequiredError="@L["rental fee is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.Deposit)]" @bind-Value="_model.Deposit" For="@(() => _model.Deposit)" Min="0.00m" Required="false" RequiredError="@L["deposit is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.AmountDue)]" @bind-Value="_model.AmountDue" For="@(() => _model.AmountDue)" Min="0.00m" Required="false" RequiredError="@L["amount due is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.AmountPaid)]" @bind-Value="_model.AmountPaid" For="@(() => _model.AmountPaid)" Min="0.00m" Required="false" RequiredError="@L["amount paid is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudDatePicker ShowToolbar="false" Label="@L[_model.GetMemberDescription(x=>x.PaymentTime)]" @bind-Date="_model.PaymentTime" For="@(() => _model.PaymentTime)" Required="false" RequiredError="@L["payment time is required!"]"></MudDatePicker>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudEnumSelect TEnum="Nullable<PaymentMethods>" Label="@L[_model.GetMemberDescription(x=>x.PaymentMethodId)]" @bind-Value="_model.PaymentMethodId" For="@(() => _model.PaymentMethodId)" Required="false" RequiredError="@L["payment method id is required!"]"></MudEnumSelect>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.Notes)]" @bind-Value="_model.Notes" For="@(() => _model.Notes)" Required="false" RequiredError="@L["notes is required!"]"></MudTextField>
                </MudItem> 

            </MudGrid>
        </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-end gap-2">
                    <MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
        </MudCardActions>
        </MudCard>
    }
</MudContainer>
 

@code {
    public string? Title { get; private set; }
    [Parameter]
    public int Id { get; set; }
    MudForm _memberrentalForm = new();
    private bool _saving = false;
    private List<BreadcrumbItem>? _breadcrumbItems;
    private UpdateMemberRentalCommand? _model;
    private List<MonthlyRate> _monthlyRates = new();
    private int? _selectedMonthlyRateId;
    protected override async Task OnInitializedAsync()
    {
        Title = L["Edit MemberRental"];
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem(L["Home"], href: "/"),
            new BreadcrumbItem(L["MemberRentals"], href: "/pages/memberrentals")
        };
        await LoadMonthlyRates();
        var result = await Mediator.Send(new GetMemberRentalByIdQuery() { Id = Id });
        result.Map(data =>
        {
            _model = Mapper.Map<UpdateMemberRentalCommand>(data);
            return data;
        }).Match(data =>
        {
            _breadcrumbItems.Add(new BreadcrumbItem(data.CardId, href: $"/pages/memberrentals/edit/{Id}"));
        }, errors =>
        {
            Snackbar.Add($"{errors}", Severity.Error);
        });

    }
    private async Task LoadMonthlyRates()
    {
        await using var db = await DbFactory.CreateAsync();
        _monthlyRates = await db.MonthlyRates
            .AsNoTracking()
            .Where(x => x.IsActive &&
                        (x.Description == null || !x.Description.StartsWith(MonthlyRateDefaults.BaseMarker)))
            .OrderBy(x => x.VehicleType)
            .ThenBy(x => x.Name)
            .ToListAsync();
    }

    private Task OnMonthlyRateSelected(int? monthlyRateId)
    {
        _selectedMonthlyRateId = monthlyRateId;
        var rate = _monthlyRates.FirstOrDefault(x => x.Id == monthlyRateId);
        if (rate is null || _model is null)
            return Task.CompletedTask;

        _model.RentalFee = rate.MonthlyFee;
        _model.Deposit = rate.Deposit;
        _model.AmountDue = rate.MonthlyFee + rate.Deposit;

        return Task.CompletedTask;
    }

    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _memberrentalForm.Validate().ConfigureAwait(false);
            if (!_memberrentalForm.IsValid)
                return;
            var result = await Mediator.Send(_model);
            result.Match(
                data=>
                {
                    Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                    Navigation.NavigateTo("/pages/memberrentals");
                },
                errors=>
                {
                    Snackbar.Add(errors, MudBlazor.Severity.Error);
                });
        }
        finally
        {
            _saving = false;
        }
    }
}
