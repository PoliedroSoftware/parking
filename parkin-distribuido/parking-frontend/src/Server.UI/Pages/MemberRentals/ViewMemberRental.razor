@page "/pages/memberrentals/view/{id:int}"
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.DTOs
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Queries.GetById
@inherits MudComponentBase
@inject IStringLocalizer<MemberRentals> L
@attribute [Authorize(Policy = Permissions.MemberRentals.View)]
<PageTitle>@Title</PageTitle>
<Breadcrumbs  OnGoEditClick="GoEdit" OnDeleteClick="Delete" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
@if (_model != null)
{
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                 <MudText Typo="Typo.h6">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid Spacing="3" Class="readonly-grid">
                <MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.MemberId)]" Value="_model.MemberId"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.LicensePlate)]" Value="_model.LicensePlate"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.CardId)]" Value="_model.CardId"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.StartDate)]" Value="@_model.StartDate?.ToString("d")"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.ExpiryDate)]" Value="@_model.ExpiryDate?.ToString("d")"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.RentalFee)]" Value="_model.RentalFee"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.Deposit)]" Value="_model.Deposit"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.AmountDue)]" Value="_model.AmountDue"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.AmountPaid)]" Value="_model.AmountPaid"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.PaymentTime)]" Value="@_model.PaymentTime?.ToString("d")"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.PaymentMethodId)]" Value="_model.PaymentMethodId?.GetDescription()"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.Notes)]" Value="_model.Notes"></ReadOnlyField>
                </MudItem> 

            </MudGrid>
        </MudCardContent>
        <MudCardActions></MudCardActions>
    </MudCard>
 }
</MudContainer>
 

@code {
    public string? Title { get; private set; }
    [Parameter]
    public int Id { get; set; }
    private List<BreadcrumbItem>? _breadcrumbItems; 
    private MemberRentalDto? _model;
    protected override async Task OnInitializedAsync()
    {
        Title = L["MemberRental"];
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem(L["Home"], href: "/"),
            new BreadcrumbItem(L["MemberRentals"], href: "/pages/memberrentals")
        };
        var result = await Mediator.Send(new GetMemberRentalByIdQuery() { Id = Id });
        result.Map(data =>
        {
            _model = data;
            return data;
        }).Match(data =>
        {
            _breadcrumbItems.Add(new BreadcrumbItem(data.CardId, null, disabled: true));
        }, errors =>
        {
            Snackbar.Add(errors, MudBlazor.Severity.Error);
        });

    }
    void GoEdit()
    {
        Navigation.NavigateTo($"/pages/MemberRentals/edit/{Id}");
    }
    async Task Delete()
    {
        var contentText = string.Format(AppStrings.DeleteConfirmation, _model.CardId);
        var command = new DeleteMemberRentalCommand(new int[] { _model.Id });
        await DialogServiceHelper.ShowDeleteConfirmationDialogAsync(command, AppStrings.DeleteConfirmationTitle, contentText, async () =>
        {
            await InvokeAsync(() =>
            {
                Navigation.NavigateTo($"/pages/MemberRentals");
            });
        });
    }
}
