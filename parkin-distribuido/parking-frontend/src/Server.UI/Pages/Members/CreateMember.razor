@page "/pages/members/create"
@using CleanArchitecture.Blazor.Application.Features.Members.Commands.Create
@using CleanArchitecture.Blazor.Application.Features.Members.DTOs
@using CleanArchitecture.Blazor.Application.Features.Vehicles.DTOs
@using CleanArchitecture.Blazor.Domain.Constants
@using CleanArchitecture.Blazor.Domain.Entities

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Members> L
@inject IApplicationDbContextFactory DbFactory
@attribute [Authorize(Policy = Permissions.Members.Create)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems" AllowdGoBack="true"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudForm Model="@_model" @ref="@_memberForm" Validation="@(Validator.ValidateValue(_model))">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Nombre Completo" @bind-Value="_model.Name" Required="true" RequiredError="El nombre es requerido"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Telefono" @bind-Value="_model.PhoneNumber" Required="true" RequiredError="El telefono es requerido"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudDatePicker ShowToolbar="false" Label="Fecha de Inicio" @bind-Date="_model.StartDate" Required="true"></MudDatePicker>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudDatePicker ShowToolbar="false" Label="Vence" Date="@(_model.StartDate?.AddMonths(1))" ReadOnly="true"></MudDatePicker>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudCheckBox Label="Activo" @bind-Value="_model.IsActive" Color="Color.Primary" Style="margin-top:12px;"></MudCheckBox>
                    </MudItem>

                    <MudItem xs="12">
                        <MudText Typo="Typo.h6" Class="mb-2">Vehiculos</MudText>
                        <MudPaper Elevation="1" Class="pa-3 mb-3" Style="background:#f5f5f5;">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">Seleccione tipo para auto-llenar el valor (editable)</MudText>
                            <MudStack Row Spacing="2">
                                @foreach (var rate in _monthlyRates)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                             Style="cursor:pointer;" OnClick="@(() => ApplyMonthlyRate(rate))">
                                        @rate.Name: $ @rate.MonthlyFee.ToString("N0")
                                    </MudChip>
                                }
                            </MudStack>
                        </MudPaper>
                        <MudStack Row Spacing="2" AlignItems="AlignItems.Start" Class="mb-2" Style="flex-wrap:wrap;">
                            <MudTextField T="string" Placeholder="Placa" @bind-Value="_newVehiclePlate" Style="width:130px;"></MudTextField>
                            <MudNumericField T="decimal" Placeholder="Valor $" @bind-Value="_newVehiclePrice" Min="0" Style="width:130px;"></MudNumericField>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Style="margin-top:6px;">
                                @_newVehicleType.GetDescription()
                            </MudChip>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       OnClick="AddVehicle" StartIcon="@Icons.Material.Filled.Add" Style="margin-top:4px;">Agregar</MudButton>
                        </MudStack>

                        @if (_vehicles.Any())
                        {
                            <MudTable Items="@_vehicles" Dense="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Placa</MudTh>
                                    <MudTh>Tipo</MudTh>
                                    <MudTh Style="text-align:right;">Valor</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><strong>@context.Plate</strong></MudTd>
                                    <MudTd><MudChip T="string" Size="Size.Small">@context.Type.GetDescription()</MudChip></MudTd>
                                    <MudTd Style="text-align:right;">$ @context.Price.ToString("N0")</MudTd>
                                    <MudTd>
                                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       OnClick="@(() => { _vehicles.Remove(context); UpdateTotal(); })"></MudIconButton>
                                    </MudTd>
                                </RowTemplate>
                                <FooterContent>
                                    <MudTd colspan="2"><strong>TOTAL MENSUALIDAD</strong></MudTd>
                                    <MudTd Style="text-align:right;font-size:18px;font-weight:800;color:#1a237e;">$ @_model.Amount?.ToString("N0")</MudTd>
                                    <MudTd></MudTd>
                                </FooterContent>
                            </MudTable>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="my-2">Agregue al menos un vehiculo con su valor mensual</MudText>
                        }
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Notas" @bind-Value="_model.Notes" Lines="2"></MudTextField>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-end gap-2">
            <MudLoadingButton Color="Color.Primary" Variant="Variant.Filled" Loading="@_saving" OnClick="OnSubmit"
                              Disabled="@(!_vehicles.Any())">@AppStrings.Save</MudLoadingButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    [CascadingParameter] private UserProfile? UserProfile { get; set; }
    public string? Title { get; private set; }
    MudForm _memberForm = new();
    private bool _saving = false;
    private string _newVehiclePlate = string.Empty;
    private VehicleTypes _newVehicleType = VehicleTypes.PrivateCar;
    private decimal _newVehiclePrice;
    private List<MonthlyVehicle> _vehicles = new();
    private List<MonthlyRate> _monthlyRates = new();
    private List<BreadcrumbItem>? _breadcrumbItems;
    private CreateMemberCommand _model = new() { IsActive = true, StartDate = DateTime.Today, Amount = 0 };

    protected override async Task OnInitializedAsync()
    {
        Title = "Nueva Mensualidad";
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new(L["Home"], href: "/"), new("Mensualidades", href: "/pages/members"),
            new("Crear Mensualidad", href: null, disabled: true)
        };
        await LoadMonthlyRates();
    }

    private async Task LoadMonthlyRates()
    {
        await using var db = await DbFactory.CreateAsync();
        _monthlyRates = await db.MonthlyRates
            .AsNoTracking()
            .Where(x => x.IsActive &&
                        (x.Description == null || !x.Description.StartsWith(MonthlyRateDefaults.BaseMarker)))
            .OrderBy(x => x.VehicleType)
            .ThenBy(x => x.Name)
            .ToListAsync();
    }

    private void AddVehicle()
    {
        if (string.IsNullOrWhiteSpace(_newVehiclePlate)) return;
        _vehicles.Add(new MonthlyVehicle
        {
            Plate = _newVehiclePlate.Trim().ToUpper(),
            Type = _newVehicleType,
            Price = _newVehiclePrice
        });
        _newVehiclePlate = string.Empty;
        _newVehicleType = VehicleTypes.PrivateCar;
        _newVehiclePrice = 0;
        UpdateTotal();
    }

    private void OnVehicleTypeChange(VehicleTypes type)
    {
        var rate = _monthlyRates.FirstOrDefault(d => d.VehicleType == type);
        if (rate != null) _newVehiclePrice = rate.MonthlyFee;
    }

    private void ApplyMonthlyRate(MonthlyRate rate)
    {
        _newVehicleType = rate.VehicleType;
        _newVehiclePrice = rate.MonthlyFee;
    }

    private void UpdateTotal()
    {
        _model.Amount = _vehicles.Sum(v => v.Price);
        _model.LicensePlate = _vehicles.FirstOrDefault()?.Plate;
    }

    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _memberForm.Validate();
            if (!_memberForm.IsValid)
            {
                Snackbar.Add("Complete los campos requeridos", Severity.Warning);
                return;
            }
            if (!_vehicles.Any())
            {
                Snackbar.Add("Agregue al menos un vehiculo", Severity.Warning);
                return;
            }

            _model.ExpiryDate = (_model.StartDate ?? DateTime.Today).AddMonths(1);
            _model.MemberVehicles = _vehicles.Select(v => new VehicleDto
            {
                Name = v.Plate,
                VehicleTypeId = v.Type,
                ServiceCategoryId = ServiceCategories.Monthly,
                Capacity = 1,
                IsActive = true
            }).ToList();

            var result = await Mediator.Send(_model);
            result.Match(data =>
            {
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                Navigation.NavigateTo("/pages/Members");
            }, errors => Snackbar.Add(errors, MudBlazor.Severity.Error));
        }
        finally { _saving = false; }
    }

    public class MonthlyVehicle
    {
        public string Plate { get; set; } = string.Empty;
        public VehicleTypes Type { get; set; } = VehicleTypes.PrivateCar;
        public decimal Price { get; set; }
    }

}
