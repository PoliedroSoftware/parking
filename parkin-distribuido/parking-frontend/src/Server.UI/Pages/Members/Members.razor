@page "/pages/members"

@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Services
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.DTOs
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Queries.PrintDetails
@using CleanArchitecture.Blazor.Application.Features.Members.Caching
@using CleanArchitecture.Blazor.Application.Features.Members.DTOs
@using CleanArchitecture.Blazor.Application.Features.Members.Specifications
@using CleanArchitecture.Blazor.Application.Features.Members.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Members.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.Members.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Members.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Members.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.DTOs
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Queries.PrintDetails
@using CleanArchitecture.Blazor.Server.UI.Pages.Members.Components
@using CleanArchitecture.Blazor.Server.UI.Services

@inject IStringLocalizer<Members> L
@inject BlazorDownloadFileService BlazorDownloadFileService
@inject ICarparkService CarparkService
@inject TicketService TicketService
@inject PosTicketPrintService PosTicketPrintService
@attribute [Authorize(Policy = Permissions.Members.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
			 FixedHeader="true"
			 FixedFooter="false"
			 Virtualize="false"
			 @bind-RowsPerPage="_defaultPageSize"
			 Loading="@_loading"
			 MultiSelection="true"
			 T="MemberDto"
			 SelectOnRowClick="false"
			 RowClick="@(s=>OnDataGridRowClick(s.Item))"
			 @bind-SelectedItems="_selectedMembers"
			 Hover="true" @ref="_membersGrid">
	<ToolBarContent>
		<MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
			<MudStack Row AlignItems="AlignItems.Start">
				<MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
				<MudStack Spacing="0">
					<MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
					<MudStack Row Spacing="2" AlignItems="AlignItems.Center">
						<MudEnumSelect Style="min-width:100px;flex:1 1 auto" TEnum="MemberListView" ValueChanged="OnListViewChanged" Value="_membersQuery.ListView" Dense="true" Label="@L["List View"]">
						</MudEnumSelect>
						<MudSelect T="CarparkDto" Label="@L["Filter by carpark"]" ValueChanged="OncarparkFilterChanged" Clearable>
							@foreach (var carpark in CarparkService.DataSource)
							{
								<MudSelectItem T="CarparkDto" Value="carpark">@($"{carpark.Name.Code} - {carpark.Name.Tc}") </MudSelectItem>
							}
						</MudSelect>
						<MudSelect T="string" Label="@L["Filter by active"]" ValueChanged="OnActiveFilterChanged" Clearable>
							<MudSelectItem T="string" Value="@("Active")">@L["Active"]</MudSelectItem>
							<MudSelectItem T="string" Value="@("Inactive")">@L["Inactive"]</MudSelectItem>
						</MudSelect>
					</MudStack>
					
				</MudStack>
			</MudStack>
			<MudStack Spacing="2" AlignItems="AlignItems.End">
				<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
					<MudButton Disabled="@_loading" Color="Color.Primary" Variant="Variant.Filled"
							   OnClick="@(() => OnRefresh())"
							   StartIcon="@Icons.Material.Outlined.Refresh">
						@AppStrings.Refresh
					</MudButton>
					@if (_accessRights.Create)
					{
						<MudButton StartIcon="@Icons.Material.Outlined.Add" Color="Color.Primary" Variant="Variant.Filled"
								   OnClick="OnCreate">
							@AppStrings.New
						</MudButton>
					}
					@if (_accessRights.Delete)
					{
						<MudButton Disabled="@(!(_selectedMembers.Count > 0))" Color="Color.Error" Variant="Variant.Filled"
								   StartIcon="@Icons.Material.Outlined.DeleteOutline"
								   OnClick="OnDeleteSelectedMembers">
							@AppStrings.Delete
						</MudButton>
					}

				</MudStack>
				<MudStack Row Spacing="1">
					@if (_accessRights.Search)
					{
						<MudTextField T="string" ValueChanged="@(s => OnLicenseSearch(s))" Value="@_membersQuery.LicensePlate" Placeholder="@L["Search by license plate"]" >
						</MudTextField>
						<MudTextField T="string" ValueChanged="@(s => OnCardIdSearch(s))" Value="@_membersQuery.CardId" Placeholder="@L["Search by card id"]" >
						</MudTextField>
						<MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_membersQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
									  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
						</MudTextField>
					}
				</MudStack>
			</MudStack>
		</MudStack>
	</ToolBarContent>
	<Columns>
		<SelectColumn ShowInFooter="false"></SelectColumn>
		<TemplateColumn HeaderStyle="width:210px" Title="@AppStrings.Actions" Sortable="false">
			<CellTemplate>
				<MudStack Row Spacing="1" AlignItems="AlignItems.Center">
					<MudButton Variant="Variant.Filled" Size="Size.Small"
							   Color="Color.Success"
							   StartIcon="@Icons.Material.Filled.Payment"
							   OnClick="@(() => OpenPayDialog(context.Item))">
						Pagar
					</MudButton>
					<MudButton Variant="Variant.Filled" Size="Size.Small"
							   Color="Color.Info"
							   StartIcon="@Icons.Material.Filled.History"
							   OnClick="@(() => OpenHistoryDialog(context.Item))">
						Historial
					</MudButton>
					@if (_accessRights.Edit || _accessRights.Delete)
					{
						<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
								 Dense="true"
								 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
							@if (_accessRights.Edit)
							{
								<MudMenuItem OnClick="@(() => OnEditMember(context.Item))">@AppStrings.Edit</MudMenuItem>
							}
							@if (_accessRights.Delete)
							{
								<MudMenuItem OnClick="@(() => OnDeleteMember(context.Item))">@AppStrings.Delete</MudMenuItem>
							}
						</MudMenu>
					}
				</MudStack>
			</CellTemplate>
		</TemplateColumn>
        <PropertyColumn Property="x => x.Name" Title="@L[_memberDto.GetMemberDescription(x => x.Name)]">
            <CellTemplate>
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body1">@context.Item.Name</MudText>
                </div>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.LicensePlate" Title="@L[_memberDto.GetMemberDescription(x => x.LicensePlate)]" />
        <PropertyColumn Property="x => x.PhoneNumber" Title="@L[_memberDto.GetMemberDescription(x => x.PhoneNumber)]" />
        <PropertyColumn Property="x => x.StartDate" Title="@L[_memberDto.GetMemberDescription(x => x.StartDate)]" Format="d" />
        <PropertyColumn Property="x => x.ExpiryDate" Title="@L[_memberDto.GetMemberDescription(x => x.ExpiryDate)]" Format="d" />
        <TemplateColumn Title="Estado pago">
            <CellTemplate>
                <MudStack Spacing="0">
                    <MudChip T="string" Size="Size.Small" Color="@GetPaymentStatusColor(context.Item)" Variant="Variant.Filled">
                        @(string.IsNullOrWhiteSpace(context.Item.PaymentStatus) ? "Sin estado" : context.Item.PaymentStatus)
                    </MudChip>
                    @if (!string.IsNullOrWhiteSpace(context.Item.LastPaidMonth))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Pagado hasta @context.Item.LastPaidMonth</MudText>
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.IsActive" Title="@L[_memberDto.GetMemberDescription(x => x.IsActive)]">
            <CellTemplate>
                @if (context.Item.IsActive)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" />
                }
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Notes" Title="@L[_memberDto.GetMemberDescription(x => x.Notes)]" />

    </Columns>
	<NoRecordsContent>
		<MudText>@AppStrings.NoRecords</MudText>
	</NoRecordsContent>
	<LoadingContent>
		<MudText>@AppStrings.Loading</MudText>
	</LoadingContent>
	<PagerContent>
		<MudDataGridPager PageSizeOptions="@(new int[] { 10, 15, 30, 50, 100, 500, 1000 })" />
	</PagerContent>
</MudDataGrid>



@code {
	public string? Title { get; private set; }
	private int _defaultPageSize = 15;
	private HashSet<MemberDto> _selectedMembers = new HashSet<MemberDto>();
	private MudDataGrid<MemberDto> _membersGrid = default!;
	private MemberDto _memberDto = new();
	private bool _loading;
	private bool _uploading;
	private bool _exporting;
	[CascadingParameter]
	private Task<AuthenticationState> AuthState { get; set; } = default!;
	[CascadingParameter]
	private UserProfile? UserProfile { get; set; }


	private MembersWithPaginationQuery _membersQuery { get; set; } = new();
	private MembersAccessRights _accessRights = new();

	protected override async Task OnInitializedAsync()
	{
		Title = L[_memberDto.GetClassDescription()];
		_accessRights = await PermissionService.GetAccessRightsAsync<MembersAccessRights>();
		await CarparkService.RefreshAsync();
	}

	private async Task<GridData<MemberDto>> ServerReload(GridState<MemberDto> state)
	{
		try
		{
			_loading = true;
			_membersQuery.CurrentUser = UserProfile;
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_membersQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
			_membersQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
									  ? SortDirection.Descending.ToString()
									  : SortDirection.Ascending.ToString();
			_membersQuery.PageNumber = state.Page + 1;
			_membersQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_membersQuery).ConfigureAwait(false);
			return new GridData<MemberDto>() { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}

	}
	private async Task OnActiveFilterChanged(string? isActive)
	{
		_selectedMembers.Clear();
		if (string.IsNullOrEmpty( isActive))
		_membersQuery.Active = null;
		else if (isActive == "Active")
			_membersQuery.Active = true;
		else
			_membersQuery.Active = false;
		await _membersGrid.ReloadServerData();
	}
	private async Task OncarparkFilterChanged(CarparkDto? carpark)
	{
		_selectedMembers.Clear();
		_membersQuery.CarparkId = carpark?.Id;
		await _membersGrid.ReloadServerData();
	}
	private async Task OnSearch(string text)
	{
		_selectedMembers.Clear();
		_membersQuery.Keyword = text;
		await _membersGrid.ReloadServerData();
	}
	private async Task OnLicenseSearch(string text)
	{
		_selectedMembers.Clear();
		_membersQuery.LicensePlate = text;
		await _membersGrid.ReloadServerData();
	}
	private async Task OnCardIdSearch(string text)
	{
		_selectedMembers.Clear();
		_membersQuery.CardId = text;
		await _membersGrid.ReloadServerData();
	}
	private async Task OnListViewChanged(MemberListView listview)
	{
		_membersQuery.ListView = listview;
		await _membersGrid.ReloadServerData();
	}
	private async Task OnRefresh()
	{
		MemberCacheKey.Refresh();
		_selectedMembers.Clear();
		_membersQuery.Keyword = string.Empty;
		await _membersGrid.ReloadServerData();
	}
	private Task ShowEditFormDialog(string title, AddEditMemberCommand command)
	{
		return DialogServiceHelper.ShowFormDialogAsync<MemberFormDialog, AddEditMemberCommand>(
			title,
			new DialogParameters<MemberFormDialog>()
			{
				{x => x._model, command }
			},
			async () =>
			{
				await _membersGrid.ReloadServerData();
				_selectedMembers.Clear();
			});
	}
	private void OnDataGridRowClick(MemberDto dto)
	{
		Navigation.NavigateTo($"/pages/members/view/{dto.Id}");
	}
	private Task OnCreate()
	{
		Navigation.NavigateTo($"/pages/members/create/");
		return Task.CompletedTask;
	}

	private Task OnEditMember(MemberDto dto)
	{
		//var command = Mapper.Map<AddEditMemberCommand>(dto);
		//return ShowEditFormDialog(L["Edit Member"], command);
		Navigation.NavigateTo($"/pages/members/edit/{dto.Id}");
		return Task.CompletedTask;
	}

	private Task OnDeleteMember(MemberDto dto)
	{
		var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Name);
		var command = new DeleteMemberCommand(new int[] { dto.Id });
		return DeleteMembersInternal(command, contentText);
	}

	private Task OnDeleteSelectedMembers()
	{
		var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedMembers.Count);
		var command = new DeleteMemberCommand(_selectedMembers.Select(x => x.Id).ToArray());
		return DeleteMembersInternal(command, contentText);
	}

	private Task DeleteMembersInternal(DeleteMemberCommand command, string contentText)
	{
		return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
			command,
			AppStrings.DeleteConfirmationTitle,
			contentText,
			async () =>
			{
				await _membersGrid.ReloadServerData();
				_selectedMembers.Clear();
			});
	}

    private async Task OpenPayDialog(MemberDto dto)
    {
        var parameters = new DialogParameters<MemberRentalPayDialog> { { x => x.Member, dto } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var dialog = await DialogService.ShowAsync<MemberRentalPayDialog>($"Pagar - {dto.Name}", parameters, options);
        var result = await dialog.Result;
        if (result?.Data is MemberRentalPayDialog.PayResult payResult && payResult.TotalAmount > 0)
        {
            var cmd = new AddEditMemberRentalCommand
            {
                Member = dto,
                MemberId = dto.Id,
                LicensePlate = dto.LicensePlate,
                CardId = dto.CardId,
                StartDate = DateTime.Today,
                ExpiryDate = DateTime.Today.AddMonths(1),
                RentalFee = payResult.TotalAmount,
                AmountDue = payResult.TotalAmount,
                AmountPaid = payResult.TotalAmount,
                PaymentTime = DateTime.Now,
                PaymentMethodId = payResult.PaymentMethod
            };

            var sendResult = await Mediator.Send(cmd);
            if (sendResult.Succeeded)
            {
                MovementTracker.AddMovement(new MovementRecord
                {
                    Time = DateTime.Now,
                    Type = "Mensualidad",
                    LicensePlate = dto.LicensePlate ?? "",
                    CustomerName = dto.Name ?? "",
                    Amount = payResult.TotalAmount
                });

                Snackbar.Add("Pago registrado exitosamente", Severity.Success);
                await _membersGrid.ReloadServerData();

                var rentalId = sendResult.Data;
                var printQuery = new GetMonthlyReceiptPrintDetailsQuery { MemberRentalId = rentalId };
                var printResult = await Mediator.Send(printQuery);
                if (printResult.Succeeded && printResult.Data is not null)
                {
                    var details = printResult.Data;
                    var ticketData = BuildTicketData(details);
                    var posResult = await PosTicketPrintService.PrintAsync(ticketData);
                    var sev = posResult.PrintedDirectly ? Severity.Success
                        : posResult.PreviewOpened ? Severity.Warning : Severity.Error;
                    Snackbar.Add(posResult.Message, sev);
                }
            }
            else
            {
                Snackbar.Add(sendResult.Errors.FirstOrDefault() ?? "Error al registrar el pago", Severity.Error);
            }
        }
    }

    private static TicketData BuildTicketData(MonthlyReceiptPrintDetailsDto details)
    {
        var vehicles = details.Vehicles
            .Select(x => new TicketVehicleData
            {
                LicensePlate = x.LicensePlate,
                VehicleType = x.VehicleTypeDescription,
                Price = x.MonthlyFee
            }).ToList();

        return new TicketData
        {
            Type = TicketType.Monthly,
            LicensePlate = vehicles.FirstOrDefault()?.LicensePlate ?? details.LicensePlate ?? "",
            VehicleType = vehicles.Count == 1 ? vehicles[0].VehicleType : "",
            DateTime = details.PaymentTime ?? DateTime.Now,
            TicketNumber = $"TK-{DateTime.Now:yyMMdd}-{details.MemberRentalId}",
            Amount = details.AmountPaid,
            PaymentMethod = details.PaymentMethodId?.GetDescription(),
            BillingPeriod = string.IsNullOrWhiteSpace(details.PaidMonth) ? "Periodo no definido" : details.PaidMonth,
            MemberName = details.MemberName,
            OperatorName = "Operador",
            Vehicles = vehicles,
            PendingWashes = details.PendingWashes.Select(x => new TicketPendingWashData
            {
                LicensePlate = x.LicensePlate,
                Service = x.WashServiceDescription,
                Status = x.StatusDescription,
                Amount = x.Price
            }).ToList()
        };
    }

    private async Task OpenHistoryDialog(MemberDto dto)
    {
        var parameters = new DialogParameters<MemberRentalHistoryDialog> { { x => x._member, dto } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        await DialogService.ShowAsync<MemberRentalHistoryDialog>($"Pagos de {dto.Name}", parameters, options);
    }

    private static Color GetPaymentStatusColor(MemberDto member)
    {
        if (member.MonthsOverdue <= 0)
            return Color.Success;

        return member.MonthsOverdue == 1 ? Color.Warning : Color.Error;
    }

	private async Task OnPrintMonthlyReceipt(MemberDto dto)
	{
		var details = await GetMonthlyReceiptPrintDetails(dto.Id);
		if (details is null)
			return;

		var ticketData = BuildMonthlyTicketData(details);

		MovementTracker.AddMovement(new MovementRecord
		{
			Time = DateTime.Now,
			Type = "Mensualidad",
			LicensePlate = ticketData.LicensePlate,
			CustomerName = details.MemberName ?? "",
			Amount = (int)details.AmountPaid
		});

		await PrintPosTicket(ticketData);
	}

	private async Task<MonthlyReceiptPrintDetailsDto?> GetMonthlyReceiptPrintDetails(int memberId)
	{
		var result = await Mediator.Send(new GetMonthlyReceiptPrintDetailsQuery { MemberId = memberId });
		if (result.Succeeded && result.Data is not null)
			return result.Data;

		Snackbar.Add(result.Errors.FirstOrDefault() ?? "No se pudo cargar la mensualidad para imprimir.", Severity.Error);
		return null;
	}

	private TicketData BuildMonthlyTicketData(MonthlyReceiptPrintDetailsDto details)
	{
		var vehicles = details.Vehicles
			.Select(x => new TicketVehicleData
			{
				LicensePlate = x.LicensePlate,
				VehicleType = x.VehicleTypeDescription,
				Price = x.MonthlyFee
			})
			.ToList();

		var primaryPlate = vehicles.Count > 0
			? vehicles[0].LicensePlate
			: details.LicensePlate ?? "";

		return new TicketData
		{
			Type = TicketType.Monthly,
			LicensePlate = primaryPlate,
			VehicleType = vehicles.Count == 1 ? vehicles[0].VehicleType : "",
			DateTime = details.PaymentTime ?? DateTime.Now,
			TicketNumber = TicketService.GenerateTicketNumber(),
			Amount = details.AmountPaid,
			PaymentMethod = details.PaymentMethodId?.GetDescription(),
			BillingPeriod = string.IsNullOrWhiteSpace(details.PaidMonth) ? "Periodo no definido" : details.PaidMonth,
			MemberName = details.MemberName,
			Duration = details.StartDate.HasValue && details.ExpiryDate.HasValue
				? details.ExpiryDate.Value - details.StartDate.Value
				: null,
			OperatorName = UserProfile?.DisplayName ?? "Operador",
			Vehicles = vehicles,
			PendingWashes = details.PendingWashes.Select(x => new TicketPendingWashData
			{
				LicensePlate = x.LicensePlate,
				Service = x.WashServiceDescription,
				Status = x.StatusDescription,
				Amount = x.Price
			}).ToList()
		};
	}

	private async Task PrintPosTicket(TicketData ticketData)
	{
		var result = await PosTicketPrintService.PrintAsync(ticketData);
		var severity = result.PrintedDirectly
			? Severity.Success
			: result.PreviewOpened ? Severity.Warning : Severity.Error;
		Snackbar.Add(result.Message, severity);
	}


	private async Task OnExport()
	{
		_exporting = true;
		var request = new ExportMembersQuery()
		{
			Keyword = _membersQuery.Keyword,
			CurrentUser = UserProfile,
			ListView = _membersQuery.ListView,
			OrderBy = _membersGrid.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
			SortDirection = (_membersGrid.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
		};
		var result = await Mediator.Send(request);
		await result.MatchAsync(
			async data =>
			{
				await BlazorDownloadFileService.DownloadFileAsync($"{L["Members"]}.xlsx", result.Data, contentType: "application/octet-stream");
				Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
			},
			errors =>
			{
				Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
				return Task.CompletedTask;
			});
		_exporting = false;
	}
	private async Task OnImportData(IBrowserFile file)
	{
		_uploading = true;
		var stream = new MemoryStream();
		await file.OpenReadStream().CopyToAsync(stream);
		var command = new ImportMembersCommand(file.Name, stream.ToArray());
		var result = await Mediator.Send(command);
		await result.MatchAsync(
			async data =>
			{
				await _membersGrid.ReloadServerData();
				Snackbar.Add($"{AppStrings.ImportSuccess}", MudBlazor.Severity.Info);
			}, errors =>
			{
				Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
				return Task.CompletedTask;
			});
		_uploading = false;
	}

}
