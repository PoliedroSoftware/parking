@page "/pages/reporte"

@using CleanArchitecture.Blazor.Server.UI.Services
@using CleanArchitecture.Blazor.Domain.Entities
@using System.Globalization

@inject IApplicationDbContextFactory DbFactory
@inject PosTicketPrintService PosTicketPrintService
@inject ReportTicketService ReportTicketService

@attribute [Authorize]

<PageTitle>Reporte Mensual</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h3" Style="font-weight:700;">Reporte Mensual</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        @_reportDate.ToString("MMMM yyyy") - Ingresos vs Gastos
    </MudText>

    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="6" sm="3">
            <MudCard Elevation="3" Style="background:#e8f5e9;">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.body2">Parqueo</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Success">$ @_ingresosParqueo.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="3" Style="background:#e3f2fd;">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.body2">Lavado</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Primary">$ @_ingresosLavado.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="3" Style="background:#f3e5f5;">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.body2">Mensualidad</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Tertiary">$ @_ingresosMensualidad.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudCard Elevation="3" Style="background:#ffebee;">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.body2">Gastos</MudText>
                    <MudText Typo="Typo.h5" Color="Color.Error">$ @_gastosTotales.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudCard Elevation="4" Class="mb-6">
        <MudCardContent Class="text-center pa-6" Style="background:linear-gradient(135deg,#1a237e,#283593);">
            <MudText Typo="Typo.body1" Style="color:rgba(255,255,255,0.8);">RESULTADO NETO DEL MES</MudText>
            <MudText Typo="Typo.h3" Style="color:#fff;font-weight:800;font-size:42px;" Class="reporte-net-value">
                $ @_resultadoNeto.ToString("N0")
            </MudText>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="3" Class="mb-6">
        <MudCardHeader>
            <CardHeaderContent><MudText Typo="Typo.h6">Detalle Diario</MudText></CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_detalleDiario.Any())
            {
                <div class="mud-data-grid-responsive">
                <MudTable Items="@_detalleDiario" Dense="true" FixedHeader="true" Height="400px">
                    <HeaderContent>
                        <MudTh>Dia</MudTh>
                        <MudTh Style="text-align:right;">Parqueo</MudTh>
                        <MudTh Style="text-align:right;">Lavado</MudTh>
                        <MudTh Style="text-align:right;">Mensualidad</MudTh>
                        <MudTh Style="text-align:right;">Ingresos</MudTh>
                        <MudTh Style="text-align:right;">Gastos</MudTh>
                        <MudTh Style="text-align:right;">Neto</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><strong>@context.Day</strong></MudTd>
                        <MudTd Style="text-align:right;">$ @context.Parking.ToString("N0")</MudTd>
                        <MudTd Style="text-align:right;">$ @context.Wash.ToString("N0")</MudTd>
                        <MudTd Style="text-align:right;">$ @context.Monthly.ToString("N0")</MudTd>
                        <MudTd Style="text-align:right;font-weight:700;color:#2e7d32;">$ @context.Ingresos.ToString("N0")</MudTd>
                        <MudTd Style="text-align:right;color:#c62828;">$ @context.Expenses.ToString("N0")</MudTd>
                        <MudTd Style="text-align:right;font-weight:800;">
                            <MudText Style="@GetNetoColor(context.Neto)">$ @context.Neto.ToString("N0")</MudText>
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd><strong>TOTAL</strong></MudTd>
                        <MudTd Style="text-align:right;"><strong>$ @_ingresosParqueo.ToString("N0")</strong></MudTd>
                        <MudTd Style="text-align:right;"><strong>$ @_ingresosLavado.ToString("N0")</strong></MudTd>
                        <MudTd Style="text-align:right;"><strong>$ @_ingresosMensualidad.ToString("N0")</strong></MudTd>
                        <MudTd Style="text-align:right;font-weight:800;color:#2e7d32;font-size:15px;">
                            <strong>$ @(_ingresosParqueo + _ingresosLavado + _ingresosMensualidad).ToString("N0")</strong>
                        </MudTd>
                        <MudTd Style="text-align:right;font-weight:700;color:#c62828;font-size:15px;">
                            <strong>$ @_gastosTotales.ToString("N0")</strong>
                        </MudTd>
                        <MudTd Style="text-align:right;font-weight:800;font-size:18px;">
                            <strong>$ @_resultadoNeto.ToString("N0")</strong>
                        </MudTd>
                    </FooterContent>
                </MudTable>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="text-align:center;padding:20px;">
                    Sin movimientos para este mes
                </MudText>
            }
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="3" Class="mb-6">
        <MudCardHeader>
            <CardHeaderContent><MudText Typo="Typo.h6">Gastos del Mes</MudText></CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_gastos.Any())
            {
                <div class="mud-data-grid-responsive">
                <MudTable Items="@_gastos" Dense="true" FixedHeader="true" Height="350px">
                    <HeaderContent>
                        <MudTh>Fecha</MudTh>
                        <MudTh>Categoria</MudTh>
                        <MudTh>Descripcion</MudTh>
                        <MudTh Style="text-align:right;">Valor</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Date.ToString("dd/MM")</MudTd>
                        <MudTd><MudChip T="string" Size="Size.Small">@context.Category</MudChip></MudTd>
                        <MudTd>@context.Description</MudTd>
                        <MudTd Style="text-align:right;">$ @context.Amount.ToString("N0")</MudTd>
                    </RowTemplate>
                </MudTable>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="text-align:center;padding:20px;">
                    Sin gastos registrados
                </MudText>
            }
        </MudCardContent>
    </MudCard>

    <div style="text-align:center;margin-top:20px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   OnClick="PrintReport" StartIcon="@Icons.Material.Filled.Print">IMPRIMIR REPORTE</MudButton>
    </div>
</MudContainer>

@code {
    private DateTime _reportDate = DateTime.Today;
    private int _ingresosParqueo;
    private int _ingresosLavado;
    private int _ingresosMensualidad;
    private int _gastosTotales;
    private int _resultadoNeto;
    private List<DayDetail> _detalleDiario = new();
    private List<Expense> _gastos = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var firstDay = new DateTime(_reportDate.Year, _reportDate.Month, 1);
        var lastDay = firstDay.AddMonths(1).AddDays(-1);

        await using var db = await DbFactory.CreateAsync();

        var parkingByDay = (await db.ParkingRecords
            .Where(p => p.Status == "Completado" && p.ExitTime.HasValue
                && p.ExitTime.Value >= firstDay && p.ExitTime.Value <= lastDay)
            .Select(p => new { p.ExitTime, p.Amount })
            .ToListAsync())
            .GroupBy(p => p.ExitTime!.Value.Date)
            .ToDictionary(g => g.Key, g => (int)g.Sum(p => p.Amount));

        var washByDay = (await db.CarWashes
            .Where(c => c.StartTime.HasValue && c.IsPaid
                && c.StartTime.Value >= firstDay && c.StartTime.Value <= lastDay)
            .Select(c => new { c.StartTime, Price = (int?)c.Price })
            .ToListAsync())
            .GroupBy(c => c.StartTime!.Value.Date)
            .ToDictionary(g => g.Key, g => g.Sum(c => c.Price ?? 0));

        var monthlyByDay = (await db.MemberRentals
            .Where(r => r.PaymentTime >= firstDay && r.PaymentTime <= lastDay)
            .Select(r => new { r.PaymentTime, r.AmountPaid })
            .ToListAsync())
            .GroupBy(r => r.PaymentTime.Date)
            .ToDictionary(g => g.Key, g => (int)g.Sum(r => r.AmountPaid));

        _gastos = await db.Expenses
            .Where(e => e.Date >= firstDay && e.Date <= lastDay)
            .OrderByDescending(e => e.Date).ToListAsync();

        var expensesByDay = _gastos
            .GroupBy(e => e.Date.Date)
            .ToDictionary(g => g.Key, g => (int)g.Sum(e => e.Amount));

        _ingresosParqueo = parkingByDay.Values.Sum();
        _ingresosLavado = washByDay.Values.Sum();
        _ingresosMensualidad = monthlyByDay.Values.Sum();
        _gastosTotales = expensesByDay.Values.Sum();
        _resultadoNeto = _ingresosParqueo + _ingresosLavado + _ingresosMensualidad - _gastosTotales;

        var allDays = new HashSet<DateTime>();
        foreach (var d in parkingByDay.Keys) allDays.Add(d);
        foreach (var d in washByDay.Keys) allDays.Add(d);
        foreach (var d in monthlyByDay.Keys) allDays.Add(d);
        foreach (var d in expensesByDay.Keys) allDays.Add(d);

        _detalleDiario = allDays
            .OrderBy(d => d)
            .Select(day =>
            {
                var parking = parkingByDay.GetValueOrDefault(day);
                var wash = washByDay.GetValueOrDefault(day);
                var monthly = monthlyByDay.GetValueOrDefault(day);
                var expenses = expensesByDay.GetValueOrDefault(day);
                var ingresos = parking + wash + monthly;

                return new DayDetail
                {
                    Day = day.ToString("ddd dd", new CultureInfo("es-CO")),
                    Parking = parking,
                    Wash = wash,
                    Monthly = monthly,
                    Ingresos = ingresos,
                    Expenses = expenses,
                    Neto = ingresos - expenses
                };
            })
            .ToList();
    }

    private async Task PrintReport()
    {
        try
        {
            var data = new IngresosReportData
            {
                Date = _reportDate,
                ParkingRevenue = _ingresosParqueo,
                WashRevenue = _ingresosLavado,
                MonthlyRevenue = _ingresosMensualidad,
                TotalExpenses = _gastosTotales,
                NetRevenue = _resultadoNeto,
                Days = _detalleDiario.Select(d => new DayRevenueData
                {
                    Day = d.Day,
                    Parking = d.Parking,
                    Wash = d.Wash,
                    Monthly = d.Monthly,
                    Total = d.Ingresos
                }).ToList(),
                Expenses = _gastos.Select(e => new ExpenseItemData
                {
                    Date = e.Date.ToString("dd/MM"),
                    Category = e.Category ?? "",
                    Description = e.Description ?? "",
                    Amount = (int)e.Amount
                }).ToList()
            };

            var (tagged, html) = await ReportTicketService.GenerateIngresosTicketAsync(data);
            var result = await PosTicketPrintService.PrintReportAsync(tagged, html);

            var severity = result.PrintedDirectly
                ? Severity.Success
                : result.PreviewOpened ? Severity.Warning : Severity.Error;
            Snackbar.Add(result.Message, severity);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al imprimir: {ex.Message}", Severity.Error);
        }
    }

    public class DayDetail
    {
        public string Day { get; set; } = "";
        public int Parking { get; set; }
        public int Wash { get; set; }
        public int Monthly { get; set; }
        public int Ingresos { get; set; }
        public int Expenses { get; set; }
        public int Neto { get; set; }
    }

    private static string GetNetoColor(int neto) => neto >= 0 ? "color:#2e7d32" : "color:#c62828";
}
