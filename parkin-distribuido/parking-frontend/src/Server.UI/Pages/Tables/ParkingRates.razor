@page "/tables/parking-rates"
@using CleanArchitecture.Blazor.Domain.Constants
@using CleanArchitecture.Blazor.Domain.Entities
@using CleanArchitecture.Blazor.Domain.Enums

@inject IApplicationDbContextFactory DbFactory
@inject ISnackbar Snackbar
@attribute [Authorize]

<PageTitle>Tarifas de Parqueo</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <div>
            <MudText Typo="Typo.h4" Style="font-weight:800;">Tarifas de Parqueo</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Configure valores por hora, dia y noche para cada tipo de vehiculo.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadData">
            Actualizar
        </MudButton>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5">
            <MudCard Elevation="0" Outlined="true">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@(_editingRateId.HasValue ? "Editar tarifa" : "Nueva tarifa")</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Nombre" @bind-Value="_rateEditor.Name"
                                          Required="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSelect T="VehicleTypes" Label="Tipo de vehiculo" @bind-Value="_rateEditor.VehicleType"
                                       Required="true" Margin="Margin.Dense">
                                @foreach (var vehicleType in _vehicleTypes)
                                {
                                    <MudSelectItem T="VehicleTypes" Value="@vehicleType">@vehicleType.GetDescription()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal" Label="Hora" @bind-Value="_rateEditor.HourlyRate"
                                             Min="0" Required="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal" Label="Dia" @bind-Value="_rateEditor.DayRate"
                                             Min="0" Required="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal" Label="Noche" @bind-Value="_rateEditor.NightRate"
                                             Min="0" Required="true" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudCheckBox T="bool" Label="Activa" @bind-Value="_rateEditor.IsActive"
                                         Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" Label="Descripcion" @bind-Value="_rateEditor.Description"
                                          Lines="2" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" OnClick="ResetRateEditor">Limpiar</MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRate"
                               Disabled="@_saving">
                        Guardar tarifa
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudCard Elevation="0" Outlined="true">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Tarifas registradas</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTable Items="@_rates" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Nombre</MudTh>
                            <MudTh>Vehiculo</MudTh>
                            <MudTh Style="text-align:right;">Hora</MudTh>
                            <MudTh Style="text-align:right;">Dia</MudTh>
                            <MudTh Style="text-align:right;">Noche</MudTh>
                            <MudTh>Estado</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@context.VehicleType.GetDescription()</MudTd>
                            <MudTd Style="text-align:right;font-weight:700;">$ @context.HourlyRate.ToString("N0")</MudTd>
                            <MudTd Style="text-align:right;font-weight:700;">$ @context.DayRate.ToString("N0")</MudTd>
                            <MudTd Style="text-align:right;font-weight:700;">$ @context.NightRate.ToString("N0")</MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                                    @(context.IsActive ? "Activa" : "Inactiva")
                                </MudChip>
                            </MudTd>
                            <MudTd Style="text-align:right;">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                               OnClick="@(() => EditRate(context))" />
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteRate(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary">No hay tarifas registradas.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private readonly VehicleTypes[] _vehicleTypes = Enum.GetValues<VehicleTypes>()
        .Where(x => x != VehicleTypes.None)
        .ToArray();

    private List<ParkingRate> _rates = new();
    private ParkingRate _rateEditor = NewRateEditor();
    private int? _editingRateId;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateAsync();
        await NormalizeLegacyBaseRowsAsync(db);

        _rates = await db.ParkingRates
            .AsNoTracking()
            .Where(p => p.Description == null || !p.Description.StartsWith(ParkingRateDefaults.BaseMarker))
            .OrderByDescending(p => p.IsActive)
            .ThenBy(p => p.VehicleType)
            .ThenBy(p => p.Name)
            .ToListAsync();
    }

    private static async Task NormalizeLegacyBaseRowsAsync(IApplicationDbContext db)
    {
        var rates = await db.ParkingRates.ToListAsync();
        foreach (var rate in ParkingRateDefaults.Rates)
        {
            var baseName = $"Base - {rate.Name}";
            var legacyBase = rates.FirstOrDefault(x =>
                ParkingRateDefaults.IsMarkedBase(x.Description) &&
                x.VehicleType == rate.VehicleType &&
                !x.Name.Equals(baseName, StringComparison.OrdinalIgnoreCase));

            if (legacyBase is null)
                continue;

            legacyBase.Name = baseName;
            legacyBase.HourlyRate = rate.HourlyRate;
            legacyBase.DayRate = rate.DayRate;
            legacyBase.NightRate = rate.NightRate;
            legacyBase.IsActive = true;
            legacyBase.Description = ParkingRateDefaults.MarkDescription(rate.Description);

            var visibleExists = rates.Any(x =>
                !ParkingRateDefaults.IsMarkedBase(x.Description) &&
                x.VehicleType == rate.VehicleType);

            if (!visibleExists)
                db.ParkingRates.Add(new ParkingRate
                {
                    Name = rate.Name,
                    VehicleType = rate.VehicleType,
                    HourlyRate = rate.HourlyRate,
                    DayRate = rate.DayRate,
                    NightRate = rate.NightRate,
                    IsActive = true,
                    Description = rate.Description
                });
        }

        await db.SaveChangesAsync(CancellationToken.None);
    }

    private async Task SaveRate()
    {
        if (string.IsNullOrWhiteSpace(_rateEditor.Name))
        {
            Snackbar.Add("El nombre de la tarifa es requerido.", Severity.Warning);
            return;
        }

        if (_rateEditor.VehicleType == VehicleTypes.None)
        {
            Snackbar.Add("Seleccione tipo de vehiculo.", Severity.Warning);
            return;
        }

        if (_rateEditor.HourlyRate <= 0)
        {
            Snackbar.Add("El valor por hora debe ser mayor a cero.", Severity.Warning);
            return;
        }

        try
        {
            _saving = true;
            await using var db = await DbFactory.CreateAsync();
            var duplicated = await db.ParkingRates.AnyAsync(p =>
                p.Id != (_editingRateId ?? 0) &&
                (p.Description == null || !p.Description.StartsWith(ParkingRateDefaults.BaseMarker)) &&
                p.VehicleType == _rateEditor.VehicleType);

            if (duplicated)
            {
                Snackbar.Add("Ya existe una tarifa para ese tipo de vehiculo.", Severity.Warning);
                return;
            }

            if (_editingRateId.HasValue)
            {
                var existing = await db.ParkingRates.FindAsync(_editingRateId.Value);
                if (existing is null)
                {
                    Snackbar.Add("La tarifa ya no existe.", Severity.Error);
                    return;
                }

                if (IsBaseRate(existing))
                {
                    Snackbar.Add("La tarifa base interna no se puede editar desde esta pantalla.", Severity.Warning);
                    return;
                }

                existing.Name = _rateEditor.Name.Trim();
                existing.VehicleType = _rateEditor.VehicleType;
                existing.HourlyRate = _rateEditor.HourlyRate;
                existing.DayRate = _rateEditor.DayRate;
                existing.NightRate = _rateEditor.NightRate;
                existing.IsActive = _rateEditor.IsActive;
                existing.Description = _rateEditor.Description;
            }
            else
            {
                db.ParkingRates.Add(new ParkingRate
                {
                    Name = _rateEditor.Name.Trim(),
                    VehicleType = _rateEditor.VehicleType,
                    HourlyRate = _rateEditor.HourlyRate,
                    DayRate = _rateEditor.DayRate,
                    NightRate = _rateEditor.NightRate,
                    IsActive = _rateEditor.IsActive,
                    Description = _rateEditor.Description
                });
            }

            await db.SaveChangesAsync(CancellationToken.None);
            Snackbar.Add("Tarifa de parqueo guardada.", Severity.Success);
            ResetRateEditor();
            await LoadData();
        }
        finally
        {
            _saving = false;
        }
    }

    private void EditRate(ParkingRate rate)
    {
        _editingRateId = rate.Id;
        _rateEditor = new ParkingRate
        {
            Id = rate.Id,
            Name = rate.Name,
            VehicleType = rate.VehicleType,
            HourlyRate = rate.HourlyRate,
            DayRate = rate.DayRate,
            NightRate = rate.NightRate,
            IsActive = rate.IsActive,
            Description = ParkingRateDefaults.CleanDescription(rate.Description)
        };
    }

    private async Task DeleteRate(ParkingRate rate)
    {
        if (IsBaseRate(rate))
        {
            Snackbar.Add("Esta tarifa base no se puede eliminar.", Severity.Warning);
            return;
        }

        await using var db = await DbFactory.CreateAsync();
        var existing = await db.ParkingRates.FindAsync(rate.Id);
        if (existing is null)
            return;

        if (IsBaseRate(existing))
        {
            Snackbar.Add("Esta tarifa base no se puede eliminar.", Severity.Warning);
            return;
        }

        db.ParkingRates.Remove(existing);
        await db.SaveChangesAsync(CancellationToken.None);
        Snackbar.Add("Tarifa eliminada.", Severity.Info);
        ResetRateEditor();
        await LoadData();
    }

    private static bool IsBaseRate(ParkingRate rate)
    {
        return ParkingRateDefaults.IsMarkedBase(rate.Description);
    }

    private void ResetRateEditor()
    {
        _editingRateId = null;
        _rateEditor = NewRateEditor();
    }

    private static ParkingRate NewRateEditor() => new()
    {
        VehicleType = VehicleTypes.PrivateCar,
        IsActive = true
    };
}
