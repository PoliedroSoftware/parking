@page "/pages/zones"

@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Services
@using CleanArchitecture.Blazor.Application.Features.Zones.Caching
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.Specifications
@using CleanArchitecture.Blazor.Application.Features.Zones.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Zones.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.Zones.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Zones.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Zones.Commands.AddEdit
@using CleanArchitecture.Blazor.Server.UI.Pages.Zones.Components

@inject IStringLocalizer<Zones> L
@inject BlazorDownloadFileService BlazorDownloadFileService
@inject ICarparkService CarparkService
@attribute [Authorize(Policy = Permissions.Zones.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
			 FixedHeader="true"
			 FixedFooter="false"
			 Virtualize="false"
			 @bind-RowsPerPage="_defaultPageSize"
			 Loading="@_loading"
			 MultiSelection="true"
			 T="ZoneDto"
			 SelectOnRowClick="false"
			 RowClick="@(s=>OnDataGridRowClick(s.Item))"
			 @bind-SelectedItems="_selectedZones"
			 Hover="true" @ref="_zonesGrid">
	<ToolBarContent>
		<MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
			<MudStack Row AlignItems="AlignItems.Start">
				<MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
				<MudStack Spacing="0">
					<MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
					<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
						<MudEnumSelect Style="min-width:100px;flex:1 1 auto" TEnum="ZoneListView" ValueChanged="OnListViewChanged" Value="_zonesQuery.ListView" Dense="true" Label="@L["List View"]">
						</MudEnumSelect>
						<MudSelect T="CarparkDto" Label="@L["Filter by carpark"]" ValueChanged="OncarparkFilterChanged" Clearable>

							@foreach (var carpark in CarparkService.DataSource)
							{
								<MudSelectItem T="CarparkDto" Value="carpark">@($"{carpark.Name.Code} - {carpark.Name.Tc}") </MudSelectItem>
							}
						</MudSelect>
					</MudStack>
				</MudStack>
			</MudStack>
			<MudStack Spacing="2" AlignItems="AlignItems.End">
				<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
					<MudButton Disabled="@_loading" Color="Color.Primary" Variant="Variant.Filled"
							   OnClick="@(() => OnRefresh())"
							   StartIcon="@Icons.Material.Outlined.Refresh">
						@AppStrings.Refresh
					</MudButton>
					@if (_accessRights.Create)
					{
						<MudButton StartIcon="@Icons.Material.Outlined.Add" Color="Color.Primary" Variant="Variant.Filled"
								   OnClick="OnCreate">
							@AppStrings.New
						</MudButton>
					}
					@if (_accessRights.Delete)
					{
						<MudButton Disabled="@(!(_selectedZones.Count > 0))" Color="Color.Error" Variant="Variant.Filled"
								   StartIcon="@Icons.Material.Outlined.DeleteOutline"
								   OnClick="OnDeleteSelectedZones">
							@AppStrings.Delete
						</MudButton>
					}

				</MudStack>
				<MudStack Row Spacing="1">
					@if (_accessRights.Search)
					{
						<MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_zonesQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
									  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
						</MudTextField>
					}
				</MudStack>
			</MudStack>
		</MudStack>
	</ToolBarContent>
	<Columns>
		<SelectColumn ShowInFooter="false"></SelectColumn>
		<TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
			<CellTemplate>
				@if (_accessRights.Edit || _accessRights.Delete)
				{
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
							 Dense="true"
							 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						@if (_accessRights.Edit)
						{
							<MudMenuItem OnClick="@(() => OnEditZone(context.Item))">@AppStrings.Edit</MudMenuItem>
						}
						@if (_accessRights.Delete)
						{
							<MudMenuItem OnClick="@(() => OnDeleteZone(context.Item))">@AppStrings.Delete</MudMenuItem>
						}
					</MudMenu>
				}
				else
				{
					<MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
						<MudIconButton Variant="Variant.Outlined"
									   Disabled="true"
									   Icon="@Icons.Material.Filled.DoNotTouch"
									   Size="Size.Small"
									   Color="Color.Surface">
							@AppStrings.NoAllowed
						</MudIconButton>
					</MudTooltip>
				}
			</CellTemplate>
		</TemplateColumn>
        <PropertyColumn Property="x => x.CarparkId" Title="Parqueadero">
            <CellTemplate>
                <MudText>@context.Item.Carpark?.Name.Code</MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Name.Code" Title="Codigo">
            <CellTemplate><strong>@context.Item.Name.Code</strong></CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Name.Tc" Title="Nombre">
            <CellTemplate>@context.Item.Name.Tc</CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.IsMain" Title="Principal">
            <CellTemplate>
                @if (context.Item.IsMain) { <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" /> }
                else { <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" /> }
            </CellTemplate>
        </PropertyColumn>
    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
	<PagerContent>
		<MudDataGridPager PageSizeOptions="@(new int[] { 10, 15, 30, 50, 100, 500, 1000 })" />
	</PagerContent>
</MudDataGrid>



@code {
	public string? Title { get; private set; }
	private int _defaultPageSize = 15;
	private HashSet<ZoneDto> _selectedZones = new HashSet<ZoneDto>();
	private MudDataGrid<ZoneDto> _zonesGrid = default!;
	private ZoneDto _zoneDto = new() { Name = new MultiCodeName("", "", "") };
	private bool _loading;
	private bool _uploading;
	private bool _exporting;
	[CascadingParameter]
	private Task<AuthenticationState> AuthState { get; set; } = default!;
	[CascadingParameter]
	private UserProfile? UserProfile { get; set; }


	private ZonesWithPaginationQuery _zonesQuery { get; set; } = new();
	private ZonesAccessRights _accessRights = new();

	protected override async Task OnInitializedAsync()
	{
		Title = L[_zoneDto.GetClassDescription()];
		_accessRights = await PermissionService.GetAccessRightsAsync<ZonesAccessRights>();
		await CarparkService.RefreshAsync();
	}

	private async Task<GridData<ZoneDto>> ServerReload(GridState<ZoneDto> state)
	{
		try
		{
			_loading = true;
			_zonesQuery.CurrentUser = UserProfile;
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_zonesQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
			_zonesQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
											? SortDirection.Descending.ToString()
											: SortDirection.Ascending.ToString();
			_zonesQuery.PageNumber = state.Page + 1;
			_zonesQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_zonesQuery).ConfigureAwait(false);
			return new GridData<ZoneDto>() { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}

	}
	private async Task OnSearch(string text)
	{
		_selectedZones.Clear();
		_zonesQuery.Keyword = text;
		await _zonesGrid.ReloadServerData();
	}
	private async Task OncarparkFilterChanged(CarparkDto? carpark)
	{
		_zonesQuery.CarparkId = carpark?.Id;
		_selectedZones.Clear();
		await _zonesGrid.ReloadServerData();
	}
	private async Task OnListViewChanged(ZoneListView listview)
	{
		_zonesQuery.ListView = listview;
		await _zonesGrid.ReloadServerData();
	}
	private async Task OnRefresh()
	{
		ZoneCacheKey.Refresh();
		_selectedZones.Clear();
		_zonesQuery.Keyword = string.Empty;
		await _zonesGrid.ReloadServerData();
	}
	private Task ShowEditFormDialog(string title, AddEditZoneCommand command)
	{
		return DialogServiceHelper.ShowFormDialogAsync<ZoneFormDialog, AddEditZoneCommand>(
			title,
			new DialogParameters<ZoneFormDialog>()
			{
				{x => x._model, command }
			},
			async () =>
			{
				await _zonesGrid.ReloadServerData();
				_selectedZones.Clear();
			});
	}
	private void OnDataGridRowClick(ZoneDto dto)
	{
		//Navigation.NavigateTo($"/pages/zones/view/{dto.Id}");
	}
	private Task OnCreate()
	{
		var command = new AddEditZoneCommand() { Name = new MultiCodeName("", "", "") };
		return ShowEditFormDialog(L["New Zone"], command);
	}

	private Task OnEditZone(ZoneDto dto)
	{
		var command = Mapper.Map<AddEditZoneCommand>(dto);
		return ShowEditFormDialog(L["Edit Zone"], command);

	}

	private Task OnDeleteZone(ZoneDto dto)
	{
		var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Name);
		var command = new DeleteZoneCommand(new int[] { dto.Id });
		return DeleteZonesInternal(command, contentText);
	}

	private Task OnDeleteSelectedZones()
	{
		var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedZones.Count);
		var command = new DeleteZoneCommand(_selectedZones.Select(x => x.Id).ToArray());
		return DeleteZonesInternal(command, contentText);
	}

	private Task DeleteZonesInternal(DeleteZoneCommand command, string contentText)
	{
		return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
			command,
			AppStrings.DeleteConfirmationTitle,
			contentText,
			async () =>
			{
				await _zonesGrid.ReloadServerData();
				_selectedZones.Clear();
			});
	}




}
