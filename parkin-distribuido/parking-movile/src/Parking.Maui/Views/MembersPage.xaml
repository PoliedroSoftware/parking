<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parking.Maui.Views.MembersPage" Title="Mensualidades">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Mensualidades" FontSize="20" FontAttributes="Bold" />
        <Button Text="Actualizar" Clicked="OnRefresh" BackgroundColor="#1976d2" TextColor="White" />
        <CollectionView x:Name="ItemsList">
            <CollectionView.ItemTemplate><DataTemplate><Frame Padding="8" Margin="0,4" CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout><Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                    <Label Text="{Binding LicensePlate}" FontSize="12" /></VerticalStackLayout>
                    <Button Grid.Column="1" Text="PAGAR" BackgroundColor="#4caf50" TextColor="White" CommandParameter="{Binding .}" Clicked="OnPay" />
                    <Button Grid.Column="2" Text="HISTORIAL" BackgroundColor="#2196f3" TextColor="White" CommandParameter="{Binding .}" Clicked="OnHistory" />
                </Grid>
            </Frame></DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
