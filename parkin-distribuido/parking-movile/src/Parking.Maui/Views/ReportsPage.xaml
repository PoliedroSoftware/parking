<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Parking.Maui.Views.ReportsPage" Title="Reportes">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Reportes" FontSize="20" FontAttributes="Bold" />
        <Button Text="Arqueo de Caja" Clicked="OnArqueo" BackgroundColor="#1976d2" TextColor="White" />
        <Button Text="Estatus de Turno" Clicked="OnEstatus" BackgroundColor="#2196f3" TextColor="White" />
        <Label x:Name="ResultLabel" FontSize="14" />
    </VerticalStackLayout>
</ContentPage>
