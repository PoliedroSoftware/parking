@using Microsoft.AspNetCore.Antiforgery
@inject IHttpContextAccessor accessor
@inject IAntiforgery Antiforgery
@{
    var tokens = accessor.HttpContext is not null
        ? Antiforgery.GetAndStoreTokens(accessor.HttpContext)
        : null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet"/>
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet"/>
    <link href="@Assets["css/app.css"]" rel="stylesheet"/>
    <HeadOutlet @rendermode="RenderModeForPage"/>
    <ImportMap />
    <meta name="xsrf-token" content="@(tokens?.RequestToken)" />
    <!-- Enhanced SEO Meta Tags -->
    <meta name="description" content="Blazor Parking – Intelligent cloud-based parking management platform built on Blazor Server & .NET 9. Real-time occupancy, license plate recognition, dynamic pricing, subscriptions, EV charging integration, multi-tenant operations, and advanced analytics." />
    <meta name="keywords" content="Blazor Parking, Smart Parking, Parking Management System, License Plate Recognition, LPR, Dynamic Pricing, EV Charging, Multi-tenant, Real-time Occupancy, Parking Analytics, Blazor Server, .NET 9" />
    <meta name="author" content="Blazor Parking Team" />
    <meta name="robots" content="index, follow" />
    <meta name="application-name" content="Blazor Parking" />
    <meta name="generator" content="Blazor Server (.NET 10)" />
    <meta name="theme-color" content="#1976d2" />
    
    <!-- Open Graph Tags -->
    <meta property="og:title" content="Blazor Parking – Smart Parking Management Platform" />
    <meta property="og:description" content="Blazor Parking delivers intelligent, real-time parking operations: occupancy monitoring, LPR, subscriptions, dynamic tariffs, EV charging & analytics – powered by Blazor Server & .NET 9." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://blazorparking.blazorserver.com" />
    <meta property="og:site_name" content="Blazor Parking" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://architecture.blazorserver.com/img/blazorstudio.png" />
    <meta property="og:image:alt" content="Blazor Parking Smart Parking Dashboard" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    
    <!-- Twitter Card Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Blazor Parking – Smart Parking Management" />
    <meta name="twitter:description" content="Real-time smart parking: occupancy, LPR, subscriptions, dynamic pricing, EV charging, analytics – Blazor Parking on Blazor Server." />
    <meta name="twitter:image" content="https://architecture.blazorserver.com/img/blazorstudio.png" />
    <meta name="twitter:image:alt" content="Blazor Parking Smart Parking Dashboard" />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebApplication",
        "name": "Blazor Parking",
        "description": "Blazor Parking is an intelligent cloud-based parking management platform providing real-time occupancy, license plate recognition, dynamic pricing, subscriptions, EV charging integration, and advanced analytics.",
        "url": "https://Blazorparking.app",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web Browser",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "featureList": [
            "Real-time Occupancy & Telemetry",
            "License Plate Recognition (LPR)",
            "Dynamic & Subscription Pricing",
            "Multi-tenant Management",
            "Role & Permission Based Access Control",
            "EV Charging Integration",
            "Advanced Reporting & Analytics",
            "API & Event-driven Extensibility"
        ]
    }
    </script>
    
    <title>Blazor Parking – Smart Parking Management Platform</title>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W1TQBGC3QH"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-W1TQBGC3QH');
    </script>
</head>

<body>
    <Routes @rendermode="RenderModeForPage"/>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" integrity="sha512-CNgIRecGo7nphbeZ04Sc13ka07paqdeTu0WR1IM4kNcpmBAUSHSQX0FslNhTDadL4O5SAGapGt4FodqL8My0mA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</body>

</html>

@code {
   private IComponentRenderMode? RenderModeForPage =>  new InteractiveServerRenderMode(false);

    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

}
