@using CleanArchitecture.Blazor.Application.Features.LoginAudits.DTOs
@using CleanArchitecture.Blazor.Application.Features.LoginAudits.Queries.GetRiskSummaryStatistics
@using CleanArchitecture.Blazor.Domain.Enums
@using MudBlazor

@inject IStringLocalizer<SecurityRiskDashboard> L
<!-- HEADER SECTION -->
<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">@L["Security Risk Analysis"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["Real-time user account security assessment"]</MudText>
    </div>
    <!-- Action Buttons -->
    <MudStack Row="true" Spacing="2">
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Refresh" 
                   OnClick="LoadStatistics"
                   Disabled="@_loading">
            @(_loading ? L["Loading..."] : L["Refresh Data"])
        </MudButton>
    </MudStack>
</div>

<MudGrid Spacing="3" Class="mb-5">
    <MudItem xs="12">
        <MudPaper Outlined="true" Class="pa-6">
            @if (_loading)
            {
                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="py-8">
                    <MudText Class="mt-2">@L["Analyzing security data..."]</MudText>
                </MudStack>
            }
            else if (_statistics != null)
            {
                <MudGrid>
                    <!-- Left: Main Stats (Total Users & Action Required) -->
                    <MudItem xs="12" md="3" Class="d-flex flex-column justify-center border-end-md">
                        <MudText Typo="Typo.overline" >@L["Total Accounts Monitored"]</MudText>
                        <MudText Typo="Typo.h3" Color="Color.Primary" Class="my-2" Style="font-weight: 600;">
                            @_statistics.TotalUsers.ToString("N0")
                        </MudText>
                        
                        <!-- High Risk Alert Indicator -->
                        <div class="d-flex align-center gap-1">
                            @if ((_statistics.HighRiskUsers + _statistics.CriticalRiskUsers) > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                                <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight: 700;">
                                    @(_statistics.HighRiskUsers + _statistics.CriticalRiskUsers) 
                                </MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">@L["accounts require attention"]</MudText>
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">@L["All accounts look safe"]</MudText>
                            }
                        </div>
                    </MudItem>

                    <!-- Center: Bar Chart - Daily Login Counts (Last 30 Days) -->
                    <MudItem xs="12" md="6" Class="d-flex justify-center align-center">
                        @if (_statistics.DailyLoginCountsLast30Days != null && _statistics.DailyLoginCountsLast30Days.Any())
                        {
                            <div class="d-flex align-end justify-center mud-height-full py-4" style="height: 150px; width: 100%; gap: 2px;">
                                @foreach (var dayData in _statistics.DailyLoginCountsLast30Days)
                                {
                                    var barHeight = CalculateBarHeight(dayData.Value);
                                    <MudPaper Height="@barHeight" 
                                              Width="6px" 
                                              Square="true" 
                                              Class="mud-primary rounded-t" 
                                              Style="cursor: pointer;"
                                              title="@($"{dayData.Key}: {dayData.Value} logins")"/>
                                }
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["No data to visualize"]</MudText>
                        }
                    </MudItem>

                    <!-- Right: Detailed Breakdown -->
                    <MudItem xs="12" md="3" Class="d-flex flex-column justify-center px-4">
                        <MudText Typo="Typo.subtitle1" Class="mb-3">@L["Risk Distribution"]</MudText>
                        <MudStack Spacing="2">
                            <!-- Low Risk -->
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.caption">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Success" Class="mr-1" Style="font-size: 0.75rem;" /> 
                                    @L["Low Risk"]
                                </MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@_statistics.LowRiskUsers</MudText>
                            </div>
                            

                            <!-- Medium Risk -->
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.caption">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Warning" Class="mr-1" Style="font-size: 0.75rem;" /> 
                                    @L["Medium Risk"]
                                </MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@_statistics.MediumRiskUsers</MudText>
                            </div>

                            <!-- High & Critical Risk -->
                            <div class="d-flex justify-space-between align-center">
                                <MudText Typo="Typo.caption">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Color="Color.Error" Class="mr-1" Style="font-size: 0.75rem;" /> 
                                    @L["High / Critical"]
                                </MudText>
                                <MudText Typo="Typo.caption" Style="font-weight: 700;">@(_statistics.HighRiskUsers + _statistics.CriticalRiskUsers)</MudText>
                            </div>

                            <!-- Safety Score Bar -->
                            <div class="mt-2">
                                <div class="d-flex justify-space-between mb-1">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["Safety Score"]</MudText>
                                    <MudText Typo="Typo.caption" Style="font-weight: 700;">@_safetyScore%</MudText>
                                </div>
                                <MudProgressLinear Color="@GetScoreColor(_safetyScore)" Value="@_safetyScore" Rounded="true" Size="Size.Small" />
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["No security analysis data available"]</MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
	private RiskSummaryStatisticsDto? _statistics;
	private bool _loading = true;
	private double _safetyScore = 0;

	protected override async Task OnInitializedAsync()
	{
		await LoadStatistics();
	}

	private async Task LoadStatistics()
	{
		try
		{
			_loading = true;
			var query = new GetRiskSummaryStatisticsQuery();
			_statistics = await Mediator.Send(query);

			if (_statistics != null)
			{
				CalculateSafetyScore();
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error loading security statistics: {ex.Message}");
		}
		finally
		{
			_loading = false;
		}
	}

	private void CalculateSafetyScore()
	{
		if (_statistics == null || _statistics.TotalUsers == 0)
		{
			_safetyScore = 0;
			return;
		}

		var safeUsers = _statistics.LowRiskUsers;
		_safetyScore = Math.Round((double)safeUsers / _statistics.TotalUsers * 100, 1);
	}

	private string CalculateBarHeight(int value)
	{
		if (_statistics?.DailyLoginCountsLast30Days == null || !_statistics.DailyLoginCountsLast30Days.Any())
			return "0%";

		var maxValue = _statistics.DailyLoginCountsLast30Days.Max(x => x.Value);
		if (maxValue == 0) return "0%";

		var percentage = (double)value / maxValue * 100;
		var minHeight = 5;
		var adjustedPercentage = Math.Max(percentage, minHeight);
		
		return $"{adjustedPercentage:F1}%";
	}

    private Color GetScoreColor(double score) => score switch
    {
        >= 90 => Color.Success,
        >= 70 => Color.Warning,
        _ => Color.Error
    };
}