@page "/pages/ajustes/impresora"
@inject IPrinterService PrinterService
@inject IJSRuntime JSRuntime
@inject TicketService TicketService
@attribute [Authorize]

<PageTitle>Impresora POS - Poliedro</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-3">
    <MudText Typo="Typo.h4" Class="mb-2">Configuracion de Impresora POS</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Configure la impresora termica para tickets y reportes.
        Los tickets se abriran en la vista previa de impresion del navegador.
    </MudText>

    <MudCard Elevation="3">
        <MudCardContent>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="8">
                    <MudSelect T="string" Label="Impresora Instalada"
                               Value="_printerName" ValueChanged="OnPrinterChanged"
                               Variant="Variant.Outlined"
                               AdornmentIcon="@Icons.Material.Filled.Print"
                               Adornment="Adornment.End">
                        @foreach (var p in _printers)
                        {
                            <MudSelectItem Value="@p">@p</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudButton Variant="Variant.Filled" Color="Color.Info"
                               OnClick="RefreshPrinters" StartIcon="@Icons.Material.Filled.Refresh"
                               Style="margin-top:8px;">
                        Buscar Impresoras
                    </MudButton>
                </MudItem>
                <MudItem xs="12">
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               OnClick="ClearQueue" StartIcon="@Icons.Material.Filled.DeleteSweep"
                               Disabled="@(string.IsNullOrWhiteSpace(_printerName) || _printing)">
                        Limpiar cola de impresion
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <MudAlert Severity="@_statusSeverity" Class="mt-4" Variant="Variant.Filled">
            @_statusMessage
        </MudAlert>
    }

    <MudCard Elevation="3" Class="mt-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Probar Impresion</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body2" Class="mb-2">
                Abra la vista previa del navegador y seleccione la impresora termica de 80 mm.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="PrintTest" StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@_printing">
                @if (_printing)
                {
                    <MudText>Abriendo...</MudText>
                }
                else
                {
                    <MudText>ABRIR VISTA PREVIA DE PRUEBA</MudText>
                }
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private string _printerName = string.Empty;
    private List<string> _printers = new();
    private string _statusMessage = string.Empty;
    private Severity _statusSeverity = Severity.Info;
    private bool _printing;

    protected override void OnInitialized()
    {
        _printerName = PrinterService.PrinterName;
        LoadPrinters();
    }

    private void RefreshPrinters()
    {
        LoadPrinters();
    }

    private void OnPrinterChanged(string name)
    {
        _printerName = name;
        PrinterService.PrinterName = name;
        _statusMessage = $"Impresora guardada: {name}";
        _statusSeverity = Severity.Success;
    }

    private async Task PrintTest()
    {
        try
        {
            _printing = true;
            var ticketData = new TicketData
            {
                Type = TicketType.Entry,
                CarparkName = "Poliedro Parking",
                LicensePlate = "TEST-80",
                VehicleType = "Prueba",
                DateTime = DateTime.Now,
                TicketNumber = "TEST",
                OperatorName = "Sistema"
            };

            var repairedJobs = await PrinterService.RepairQueueBeforePrintAsync();
            if (repairedJobs < 0)
            {
                _statusMessage = "Windows no permitio limpiar la cola. Se abre la vista previa; si no imprime, ejecute la app como administrador.";
                _statusSeverity = Severity.Warning;
            }

            await JSRuntime.InvokeVoidAsync("openTicketWindow",
                TicketService.GenerateTicketHtmlForWindow(ticketData));
            if (repairedJobs >= 0)
            {
                _statusMessage = "Vista previa de prueba abierta";
                _statusSeverity = Severity.Success;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
            _statusSeverity = Severity.Error;
        }
        finally { _printing = false; }
    }

    private async Task ClearQueue()
    {
        try
        {
            _printing = true;
            var deleted = await PrinterService.RepairQueueBeforePrintAsync();
            if (deleted < 0)
            {
                _statusMessage = "Windows no permitio limpiar la cola. Ejecute la app como administrador o limpie la cola manualmente.";
                _statusSeverity = Severity.Warning;
                return;
            }

            _statusMessage = deleted == 1
                ? "Se reparo la cola y se elimino 1 trabajo"
                : $"Se reparo la cola y se eliminaron {deleted} trabajos";
            _statusSeverity = Severity.Success;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error limpiando cola: {ex.Message}";
            _statusSeverity = Severity.Error;
        }
        finally
        {
            _printing = false;
        }
    }

    private void LoadPrinters()
    {
        try
        {
            _printers = PrinterService.GetInstalledPrinters().ToList();
            _statusMessage = $"Se encontraron {_printers.Count} impresora(s)";
            _statusSeverity = Severity.Success;
        }
        catch (Exception ex)
        {
            _printers = new List<string>();
            _statusMessage = $"Error buscando impresoras: {ex.Message}";
            _statusSeverity = Severity.Error;
        }
    }
}
