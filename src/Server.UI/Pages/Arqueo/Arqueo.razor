@page "/pages/arqueo"

@using CleanArchitecture.Blazor.Server.UI.Services
@using System.Globalization

@inject IJSRuntime JSRuntime
@inject PosTicketPrintService PosTicketPrintService
@inject ReportTicketService ReportTicketService

<PageTitle>Arqueo de Caja</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:8px;">
        <div>
            <MudText Typo="Typo.h3" Style="font-weight:700;">Arqueo de Caja</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Resumen y detalle del dia</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                   OnClick="PrintClosingReport" StartIcon="@Icons.Material.Filled.Print"
                   Style="height:48px;">
            IMPRIMIR CIERRE
        </MudButton>
    </div>

    @{
        var summary = MovementTracker.GetDaySummary();
    }

    @* SUMMARY CARDS *@
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="6" sm="4" md="2">
            <MudCard Elevation="3">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Entradas</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Info">@summary.TotalEntries</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Elevation="3">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Salidas</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Success">@summary.TotalExits</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Elevation="3">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Lavados</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Warning">@summary.TotalWashes</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Elevation="3">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Mensualidades</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Primary">@summary.TotalMonthly</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Elevation="3" Style="background:#e8f5e9;">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.caption">Total Operaciones</MudText>
                    <MudText Typo="Typo.h3" Style="font-weight:700;">@(summary.TotalEntries + summary.TotalExits + summary.TotalWashes + summary.TotalMonthly)</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudCard Elevation="3" Style="background:#fff3e0;">
                <MudCardContent Class="text-center">
                    <MudText Typo="Typo.caption">TOTAL DEL DIA</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Error" Style="font-weight:800;">$ @summary.TotalRevenue.ToString("N0")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* REVENUE BREAKDOWN *@
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" md="4">
            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Parqueo</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.h4" Color="Color.Primary">$ @summary.TotalParkingRevenue.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption">@summary.TotalExits salidas cobradas</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Lavado</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.h4" Color="Color.Primary">$ @summary.TotalWashRevenue.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption">@summary.TotalWashes servicios</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Mensualidades</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.h4" Color="Color.Primary">$ @summary.TotalMonthlyRevenue.ToString("N0")</MudText>
                    <MudText Typo="Typo.caption">@summary.TotalMonthly pagos</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* DETAIL TABLE *@
    <MudCard Elevation="3">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Detalle de Movimientos - @summary.Date.ToString("dd/MM/yyyy")</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (summary.Movements.Any())
            {
                <div class="mud-data-grid-responsive">
                <MudTable Items="@summary.Movements" Hover="true" Dense="true" Striped="true" FixedHeader="true" Height="450px">
                    <HeaderContent>
                        <MudTh>#</MudTh>
                        <MudTh>Hora</MudTh>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Placa</MudTh>
                        <MudTh>Cliente</MudTh>
                        <MudTh>Duracion</MudTh>
                        <MudTh Style="text-align:right;">Valor</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@(summary.Movements.IndexOf(context) + 1)</MudTd>
                        <MudTd>@FormatTime(context.Time, includeSeconds: true)</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetMovementColor(context)">
                                @GetMovementLabel(context)
                            </MudChip>
                        </MudTd>
                        <MudTd><strong>@context.LicensePlate</strong></MudTd>
                        <MudTd>@(string.IsNullOrEmpty(context.CustomerName) ? "Consumidor Final" : context.CustomerName)</MudTd>
                        <MudTd>@context.FormattedDuration</MudTd>
                        <MudTd Style="text-align:right;">$ @context.Amount.ToString("N0")</MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="6" Style="text-align:right;font-weight:700;font-size:16px;">TOTAL</MudTd>
                        <MudTd Style="text-align:right;font-weight:700;font-size:18px;color:#d32f2f;">$ @summary.TotalRevenue.ToString("N0")</MudTd>
                    </FooterContent>
                </MudTable>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary" Style="text-align:center;padding:40px;">
                    Sin movimientos registrados para este dia
                </MudText>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private Color GetMovementColor(MovementRecord m)
    {
        if (m.Type == "Lavado") return Color.Warning;
        if (m.Type == "Mensualidad") return Color.Primary;
        return m.Status == "Activo" ? Color.Info : Color.Success;
    }

    private string GetMovementLabel(MovementRecord m)
    {
        if (m.Type == "Lavado") return "LAVADO";
        if (m.Type == "Mensualidad") return "MENSUAL";
        return m.Status == "Activo" ? "PARQUEO ACTIVO" : "PARQUEO";
    }

    private static string FormatTime(DateTime value, bool includeSeconds = false)
    {
        var format = includeSeconds ? "hh:mm:ss tt" : "hh:mm tt";
        return value.ToString(format, CultureInfo.InvariantCulture);
    }

    private async Task PrintClosingReport()
    {
        try
        {
            var summary = MovementTracker.GetDaySummary();

            var data = new CierreReportData
            {
                Date = summary.Date,
                TotalEntries = summary.TotalEntries,
                TotalExits = summary.TotalExits,
                TotalWashes = summary.TotalWashes,
                TotalMonthly = summary.TotalMonthly,
                TotalParkingRevenue = summary.TotalParkingRevenue,
                TotalWashRevenue = summary.TotalWashRevenue,
                TotalMonthlyRevenue = summary.TotalMonthlyRevenue,
                TotalRevenue = summary.TotalRevenue,
                Movements = summary.Movements.Select(m => new CierreMovementData
                {
                    Time = m.Time,
                    Type = m.Type,
                    LicensePlate = m.LicensePlate,
                    CustomerName = m.CustomerName,
                    FormattedDuration = m.FormattedDuration,
                    Amount = m.Amount
                }).ToList()
            };

            var (tagged, html) = await ReportTicketService.GenerateCierreTicketAsync(data);
            var result = await PosTicketPrintService.PrintReportAsync(tagged, html);

            var severity = result.PrintedDirectly
                ? Severity.Success
                : result.PreviewOpened ? Severity.Warning : Severity.Error;
            Snackbar.Add(result.Message, severity);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al imprimir: {ex.Message}", Severity.Error);
        }
    }
}
