@page "/pages/carwashes"

@using CleanArchitecture.Blazor.Application.Features.CarWashes.Caching
@using CleanArchitecture.Blazor.Application.Features.CarWashes.DTOs
@using CleanArchitecture.Blazor.Application.Features.CarWashes.Specifications
@using CleanArchitecture.Blazor.Application.Features.CarWashes.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.CarWashes.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.CarWashes.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.CarWashes.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.CarWashes.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Zones.Services
@using CleanArchitecture.Blazor.Server.UI.Services
@using CleanArchitecture.Blazor.Server.UI.Pages.CarWashes.Components

@inject IStringLocalizer<CarWashes> L
@inject BlazorDownloadFileService BlazorDownloadFileService
@inject IZoneService ZoneService
@inject TicketService TicketService
@inject TicketPdfService TicketPdfService
@inject IPrinterService PrinterService
@inject BlazorDownloadFileService BlazorDownloadFileService
@attribute [Authorize(Policy = Permissions.CarWashes.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             Virtualize="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             MultiSelection="true"
             T="CarWashDto"
             SelectOnRowClick="false"
             @bind-SelectedItems="_selectedCarWashes"
             Hover="true" @ref="_carWashesGrid">
    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.LocalCarWash" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudEnumSelect Style="min-width:100px;flex:1 1 auto" TEnum="CarWashListView" ValueChanged="OnListViewChanged" Value="_carWashesQuery.ListView" Dense="true" Label="@L["List View"]">
                        </MudEnumSelect>
                        <MudSelect T="string" Label="@L["Filtrar por estado"]" ValueChanged="OnStatusFilterChanged" Clearable>
                            <MudSelectItem T="string" Value="@("Pending")">En Cola</MudSelectItem>
                            <MudSelectItem T="string" Value="@("InProgress")">Lavando</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Completed")">Lavado</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Cancelled")">Entregado</MudSelectItem>
                        </MudSelect>
                    </MudStack>
                </MudStack>
            </MudStack>
            <MudStack Spacing="2" AlignItems="AlignItems.End">
                <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                    <MudButton Disabled="@_loading" Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                    <MudButton StartIcon="@Icons.Material.Outlined.Add" Color="Color.Primary" Variant="Variant.Filled"
                               OnClick="OnCreate">
                            @AppStrings.New
                        </MudButton>
                    }
                    @if (_accessRights.Delete)
                    {
                        <MudButton Disabled="@(!(_selectedCarWashes.Count > 0))" Color="Color.Error" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Outlined.DeleteOutline"
                                   OnClick="OnDeleteSelectedCarWashes">
                            @AppStrings.Delete
                        </MudButton>
                    }
                </MudStack>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Search)
                    {
                        <MudTextField T="string" ValueChanged="@(s => OnLicenseSearch(s))" Value="@_carWashesQuery.LicensePlate" Placeholder="@L["Buscar por placa"]">
                        </MudTextField>
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_carWashesQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>
        <TemplateColumn HeaderStyle="width:130px" Title="@AppStrings.Actions" Sortable="false">
            <CellTemplate>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Edit)
                    {
                        <MudIconButton Variant="Variant.Outlined" Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => OnEditCarWash(context.Item))" />
                    }
                    <MudIconButton Variant="Variant.Outlined" Size="Size.Small"
                                   Icon="@Icons.Material.Filled.Print"
                                   Color="Color.Info"
                                   OnClick="@(() => PrintTicketDirect(context.Item))" />
                    @if (_accessRights.Delete)
                    {
                        <MudIconButton Variant="Variant.Outlined" Size="Size.Small"
                                       Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       OnClick="@(() => OnDeleteCarWash(context.Item))" />
                    }
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.QueueNumber" Title="#" Sortable="false" HeaderStyle="width:48px">
            <CellTemplate>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                         Style="font-weight:700;min-width:36px;text-align:center;">@($"#{context.Item.QueueNumber}")</MudChip>
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Estado" Sortable="false" HeaderStyle="width:130px">
            <CellTemplate>
                <MudSelect T="CarWashStatus" Value="context.Item.Status ?? CarWashStatus.Pending"
                           ValueChanged="@(v => OnStatusChanged(context.Item, v))"
                           Dense="true" Size="Size.Small" Style="min-width:110px;">
                    <MudSelectItem Value="CarWashStatus.Pending">En Cola</MudSelectItem>
                    <MudSelectItem Value="CarWashStatus.InProgress">Lavando</MudSelectItem>
                    <MudSelectItem Value="CarWashStatus.Completed">Lavado</MudSelectItem>
                    <MudSelectItem Value="CarWashStatus.Cancelled">Entregado</MudSelectItem>
                </MudSelect>
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.LicensePlate" Title="@L[_carWashDto.GetMemberDescription(x => x.LicensePlate)]">
            <CellTemplate>
                <MudText Typo="Typo.body1" Style="font-weight:bold">@context.Item.LicensePlate</MudText>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.VehicleType" Title="@L[_carWashDto.GetMemberDescription(x => x.VehicleType)]">
            <CellTemplate>
                <MudChip T="string" Value="@context.Item.VehicleType?.GetDescription()" />
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.WashServiceType" Title="@L[_carWashDto.GetMemberDescription(x => x.WashServiceType)]">
            <CellTemplate>
                <MudChip T="string" Value="@context.Item.WashServiceType?.GetDescription()"
                         Color="@GetWashColor(context.Item.WashServiceType)" Size="Size.Small" />
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Price" Title="@L[_carWashDto.GetMemberDescription(x => x.Price)]" Format="C" />
        <TemplateColumn Title="Entrega Est." Sortable="false" HeaderStyle="width:140px">
            <CellTemplate>
                <MudStack Row Spacing="0" AlignItems="AlignItems.Center">
                    @if (context.Item.EstimatedDelivery.HasValue)
                    {
                        var isLate = context.Item.EstimatedDelivery.Value < DateTime.Now && (context.Item.Status == CarWashStatus.Pending || context.Item.Status == CarWashStatus.InProgress);
                        <MudChip T="string" Size="Size.Small" Color="@(isLate ? Color.Error : Color.Success)"
                                 Variant="@(isLate ? Variant.Filled : Variant.Outlined)" Style="cursor:pointer;"
                                 OnClick="@(() => OnEditDeliveryTime(context.Item))">
                            @context.Item.EstimatedDelivery.Value.ToString("h:mm tt")
                            @if (isLate) { <span>&nbsp;RETRASADO</span> }
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined"
                                 Style="cursor:pointer;" OnClick="@(() => OnEditDeliveryTime(context.Item))">
                            --:--
                        </MudChip>
                    }
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Schedule" OnClick="@(() => OnEditDeliveryTime(context.Item))" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Pago" Sortable="false" HeaderStyle="width:140px">
            <CellTemplate>
                @if (context.Item.IsPaid)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">@context.Item.PaymentMethod?.GetDescription()</MudChip>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Print" Color="Color.Info"
                                    OnClick="@(() => PrintTicketDirect(context.Item))" />
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.PictureAsPdf" Color="Color.Error"
                                    OnClick="@(() => DownloadWashPdf(context.Item))" />
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               OnClick="@(() => OnPayClick(context.Item))" StartIcon="@Icons.Material.Filled.Payment"
                               Style="font-size:11px;">COBRAR</MudButton>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Notes" Title="@L[_carWashDto.GetMemberDescription(x => x.Notes)]" />
    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[] { 10, 15, 30, 50, 100, 500, 1000 })" />
    </PagerContent>
</MudDataGrid>

@code {
    public string? Title { get; private set; }
    private int _defaultPageSize = 15;
    private HashSet<CarWashDto> _selectedCarWashes = new HashSet<CarWashDto>();
    private MudDataGrid<CarWashDto> _carWashesGrid = default!;
    private CarWashDto _carWashDto = new();
    private bool _loading;
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter]
    private UserProfile? UserProfile { get; set; }

    private CarWashesWithPaginationQuery _carWashesQuery { get; set; } = new();
    private CarWashesAccessRights _accessRights = new();

    protected override async Task OnInitializedAsync()
    {
        Title = L[_carWashDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<CarWashesAccessRights>();
        await ZoneService.RefreshAsync();
    }

    private async Task<GridData<CarWashDto>> ServerReload(GridState<CarWashDto> state)
    {
        try
        {
            _loading = true;
            _carWashesQuery.CurrentUser = UserProfile;
            var sortDefinition = state.SortDefinitions.FirstOrDefault();
            _carWashesQuery.OrderBy = sortDefinition?.SortBy ?? "QueueNumber";
            _carWashesQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
                                      ? SortDirection.Descending.ToString()
                                      : SortDirection.Ascending.ToString();
            _carWashesQuery.PageNumber = state.Page + 1;
            _carWashesQuery.PageSize = state.PageSize;
            var result = await Mediator.Send(_carWashesQuery).ConfigureAwait(false);
            return new GridData<CarWashDto>() { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStatusFilterChanged(string? status)
    {
        _selectedCarWashes.Clear();
        if (string.IsNullOrEmpty(status))
            _carWashesQuery.Status = null;
        else if (status == "Pending")
            _carWashesQuery.Status = CarWashStatus.Pending;
        else if (status == "InProgress")
            _carWashesQuery.Status = CarWashStatus.InProgress;
        else if (status == "Completed")
            _carWashesQuery.Status = CarWashStatus.Completed;
        else if (status == "Cancelled")
            _carWashesQuery.Status = CarWashStatus.Cancelled;
        await _carWashesGrid.ReloadServerData();
    }

    private async Task OnSearch(string text)
    {
        _selectedCarWashes.Clear();
        _carWashesQuery.Keyword = text;
        await _carWashesGrid.ReloadServerData();
    }

    private async Task OnLicenseSearch(string text)
    {
        _selectedCarWashes.Clear();
        _carWashesQuery.LicensePlate = text;
        await _carWashesGrid.ReloadServerData();
    }

    private async Task OnListViewChanged(CarWashListView listview)
    {
        _carWashesQuery.ListView = listview;
        await _carWashesGrid.ReloadServerData();
    }

    private async Task OnRefresh()
    {
        CarWashCacheKey.Refresh();
        _selectedCarWashes.Clear();
        _carWashesQuery.Keyword = string.Empty;
        await _carWashesGrid.ReloadServerData();
    }

    private Task OnCreate()
    {
        Navigation.NavigateTo($"/pages/carwashes/create");
        return Task.CompletedTask;
    }

    private Task OnEditCarWash(CarWashDto dto)
    {
        Navigation.NavigateTo($"/pages/carwashes/edit/{dto.Id}");
        return Task.CompletedTask;
    }

    private Task OnDeleteCarWash(CarWashDto dto)
    {
        var contentText = string.Format(AppStrings.DeleteConfirmation, dto.LicensePlate);
        var command = new DeleteCarWashCommand(new int[] { dto.Id });
        return DeleteCarWashesInternal(command, contentText);
    }

    private Task OnDeleteSelectedCarWashes()
    {
        var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedCarWashes.Count);
        var command = new DeleteCarWashCommand(_selectedCarWashes.Select(x => x.Id).ToArray());
        return DeleteCarWashesInternal(command, contentText);
    }

    private Task DeleteCarWashesInternal(DeleteCarWashCommand command, string contentText)
    {
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                await _carWashesGrid.ReloadServerData();
                _selectedCarWashes.Clear();
            });
    }

    private async Task OnEditDeliveryTime(CarWashDto dto)
    {
        var parameters = new DialogParameters<DeliveryTimeDialog> { { x => x.CarWashDto, dto } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<DeliveryTimeDialog>("Hora de Entrega", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is DateTime newTime)
        {
            dto.EstimatedDelivery = newTime;
            var cmd = new AddEditCarWashCommand
            {
                Id = dto.Id, LicensePlate = dto.LicensePlate, VehicleType = dto.VehicleType,
                WashServiceType = dto.WashServiceType, Status = dto.Status, Price = dto.Price,
                CommissionTotal = dto.CommissionTotal, WeekendSurcharge = dto.WeekendSurcharge,
                IsPaid = dto.IsPaid, PaymentMethod = dto.PaymentMethod, Notes = dto.Notes,
                QueueNumber = dto.QueueNumber, EstimatedDelivery = newTime,
                ChargeToMonthly = dto.ChargeToMonthly, MemberId = dto.MemberId,
                Additionals = dto.Additionals, Operators = dto.Operators
            };
            await Mediator.Send(cmd);
            await _carWashesGrid.ReloadServerData();
        }
    }

    private async void OnStatusChanged(CarWashDto dto, CarWashStatus newStatus)
    {
        dto.Status = newStatus;
        var cmd = new AddEditCarWashCommand
        {
            Id = dto.Id,
            LicensePlate = dto.LicensePlate,
            VehicleType = dto.VehicleType,
            WashServiceType = dto.WashServiceType,
            Status = newStatus,
            Price = dto.Price,
            CommissionTotal = dto.CommissionTotal,
            WeekendSurcharge = dto.WeekendSurcharge,
            IsPaid = dto.IsPaid,
            PaymentMethod = dto.PaymentMethod,
            Notes = dto.Notes,
            QueueNumber = dto.QueueNumber,
            EstimatedDelivery = dto.EstimatedDelivery,
            ChargeToMonthly = dto.ChargeToMonthly,
            MemberId = dto.MemberId,
            Additionals = dto.Additionals,
            Operators = dto.Operators
        };
        var result = await Mediator.Send(cmd);
        if (result.Succeeded)
            Snackbar.Add($"Estado: {newStatus.GetDescription()}", Severity.Info);
        await _carWashesGrid.ReloadServerData();
    }

    private async Task OnPayClick(CarWashDto dto)
    {
        var parameters = new DialogParameters<PaymentDialog> { { x => x.CarWashDto, dto } };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<PaymentDialog>("Cobrar Lavado", parameters, options);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is PaymentMethods pm)
        {
            dto.IsPaid = true;
            dto.PaymentMethod = pm;
            var cmd = new AddEditCarWashCommand
            {
                Id = dto.Id, LicensePlate = dto.LicensePlate, VehicleType = dto.VehicleType,
                WashServiceType = dto.WashServiceType, Status = dto.Status, Price = dto.Price,
                CommissionTotal = dto.CommissionTotal, WeekendSurcharge = dto.WeekendSurcharge,
                IsPaid = true, PaymentMethod = pm, Notes = dto.Notes, QueueNumber = dto.QueueNumber,
                EstimatedDelivery = dto.EstimatedDelivery, ChargeToMonthly = dto.ChargeToMonthly,
                MemberId = dto.MemberId, Additionals = dto.Additionals, Operators = dto.Operators
            };
            await Mediator.Send(cmd);

            MovementTracker.AddMovement(new MovementRecord
            {
                Time = DateTime.Now, Type = "Lavado", LicensePlate = dto.LicensePlate ?? "",
                Amount = (int)dto.Price
            });

            await PrintTicketDirect(dto);
            await _carWashesGrid.ReloadServerData();
        }
    }

    private async Task PrintTicketDirect(CarWashDto dto)
    {
        var operatorNames = dto.Operators?.Any() == true ? string.Join(", ", dto.Operators.Select(o => o.OperatorName)) : null;
        var additionalsTotal = dto.Additionals?.Sum(a => a.Price) ?? 0;
        var ticketData = new TicketData
        {
            Type = TicketType.Wash, LicensePlate = dto.LicensePlate ?? "",
            VehicleType = dto.VehicleType?.GetDescription() ?? "", Amount = dto.Price,
            BasePrice = dto.Price - additionalsTotal - dto.WeekendSurcharge,
            AdditionalsTotal = additionalsTotal, Surcharge = dto.WeekendSurcharge,
            PaymentMethod = dto.PaymentMethod?.GetDescription(), WashServiceType = dto.WashServiceType?.GetDescription(),
            Notes = string.Join(", ", dto.Additionals?.Select(a => a.AdditionalName) ?? Array.Empty<string>()),
            CustomerName = dto.Member?.Name, OperatorName = operatorNames, QueueNumber = dto.QueueNumber,
            DateTime = dto.StartTime ?? DateTime.Now, TicketNumber = TicketService.GenerateTicketNumber()
        };

        if (!await EnsurePrinterQueueReady())
            return;

        var html = TicketService.GenerateTicketHtmlForWindow(ticketData);
        await JS.InvokeVoidAsync("openTicketWindow", html);
        Snackbar.Add("Vista previa de impresion abierta", Severity.Info);
    }

    private async Task DownloadWashPdf(CarWashDto dto)
    {
        var additionalsTotal = dto.Additionals?.Sum(a => a.Price) ?? 0;
        var operatorNames = dto.Operators?.Any() == true ? string.Join(", ", dto.Operators.Select(o => o.OperatorName)) : null;
        var pdf = TicketPdfService.GenerateTicketPdf(new TicketData
        {
            Type = TicketType.Wash, LicensePlate = dto.LicensePlate ?? "",
            VehicleType = dto.VehicleType?.GetDescription() ?? "", Amount = dto.Price,
            BasePrice = dto.Price - additionalsTotal - dto.WeekendSurcharge,
            AdditionalsTotal = additionalsTotal, Surcharge = dto.WeekendSurcharge,
            PaymentMethod = dto.PaymentMethod?.GetDescription(), WashServiceType = dto.WashServiceType?.GetDescription(),
            Notes = string.Join(", ", dto.Additionals?.Select(a => a.AdditionalName) ?? Array.Empty<string>()),
            CustomerName = dto.Member?.Name, OperatorName = operatorNames, QueueNumber = dto.QueueNumber,
            DateTime = dto.StartTime ?? DateTime.Now, TicketNumber = TicketService.GenerateTicketNumber()
        });
        await BlazorDownloadFileService.DownloadFileAsync($"Lavado_{dto.LicensePlate}_{dto.Id}.pdf", pdf, "application/pdf");
        Snackbar.Add("PDF descargado", Severity.Success);
    }

    private Color GetStatusColor(CarWashStatus? status)
    {
        return status switch
        {
            CarWashStatus.Pending => Color.Warning,
            CarWashStatus.InProgress => Color.Info,
            CarWashStatus.Completed => Color.Success,
            CarWashStatus.Cancelled => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetWashColor(WashServiceType? type)
    {
        return type switch
        {
            WashServiceType.Basic => Color.Info,
            WashServiceType.Premium => Color.Warning,
            WashServiceType.FullDetail => Color.Primary,
            _ => Color.Default
        };
    }

    private async Task<bool> EnsurePrinterQueueReady()
    {
        try
        {
            var repairedJobs = await PrinterService.RepairQueueBeforePrintAsync();
            if (repairedJobs < 0)
            {
                Snackbar.Add("Windows no permitio limpiar la cola. Se abre la vista previa; si no imprime, ejecute la app como administrador.", Severity.Warning);
                return true;
            }

            if (repairedJobs > 0)
            {
                Snackbar.Add($"Cola de impresion limpiada: {repairedJobs} trabajo(s).", Severity.Warning);
            }

            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"No se pudo limpiar la cola de impresion: {ex.Message}", Severity.Error);
            return false;
        }
    }
}
