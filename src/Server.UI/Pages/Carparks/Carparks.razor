@page "/pages/carparks"

@using CleanArchitecture.Blazor.Application.Features.Carparks.Caching
@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Specifications
@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.Carparks.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Carparks.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.AddEdit
@using CleanArchitecture.Blazor.Server.UI.Pages.Carparks.Components

@inject IStringLocalizer<Carparks> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.Carparks.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
			 FixedHeader="true"
			 FixedFooter="false"
			 Virtualize="false"
			 @bind-RowsPerPage="_defaultPageSize"
			 Loading="@_loading"
			 MultiSelection="true"
			 T="CarparkDto"
			 SelectOnRowClick="false"
			 RowClick="@(s=>OnDataGridRowClick(s.Item))"
			 @bind-SelectedItems="_selectedCarparks"
			 Hover="true" @ref="_carparksGrid">
	<ToolBarContent>
		<MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
			<MudStack Row AlignItems="AlignItems.Start">
				<MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
				<MudStack Spacing="0">
					<MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
					<MudEnumSelect Style="min-width:120px" TEnum="CarparkListView" ValueChanged="OnListViewChanged" Value="_carparksQuery.ListView" Dense="true" Label="@L["List View"]">
					</MudEnumSelect>
				</MudStack>
			</MudStack>
			<MudStack Spacing="0" AlignItems="AlignItems.End">
				<MudToolBar Dense WrapContent="true" Class="py-1 px-0">
					<MudButton Disabled="@_loading"
							   OnClick="@(() => OnRefresh())"
							   StartIcon="@Icons.Material.Outlined.Refresh">
						@AppStrings.Refresh
					</MudButton>
					@if (_accessRights.Create)
					{
						<MudButton StartIcon="@Icons.Material.Outlined.Add"
								   OnClick="OnCreate">
							@AppStrings.New
						</MudButton>
					}
					@if (_accessRights.Delete)
					{
						<MudButton Disabled="@(!(_selectedCarparks.Count > 0))"
								   StartIcon="@Icons.Material.Outlined.DeleteOutline"
								   OnClick="OnDeleteSelectedCarparks">
							@AppStrings.Delete
						</MudButton>
					}
					<MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">
		

						@if (_accessRights.Export)
						{
							<MudMenuItem Disabled="@_exporting"
										 OnClick="OnExport">
								@AppStrings.Export
							</MudMenuItem>
						}
						@if (_accessRights.Import)
						{
							<MudMenuItem>
								<MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
									<ActivatorContent>
										<MudButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
												   Variant="Variant.Text"
												   Disabled="@_uploading">
											@AppStrings.Import
										</MudButton>
									</ActivatorContent>
								</MudFileUpload>
							</MudMenuItem>
						}
					</MudMenu>
				</MudToolBar>
				<MudStack Row Spacing="1">
					@if (_accessRights.Search)
					{
						<MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_carparksQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
									  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
						</MudTextField>
					}
				</MudStack>
			</MudStack>
		</MudStack>
	</ToolBarContent>
	<Columns>
		<SelectColumn ShowInFooter="false"></SelectColumn>
		<TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
			<CellTemplate>
				@if (_accessRights.Edit || _accessRights.Delete)
				{
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
							 Dense="true"
							 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						@if (_accessRights.Edit)
						{
							<MudMenuItem OnClick="@(() => OnEditCarpark(context.Item))">@AppStrings.Edit</MudMenuItem>
						}
						@if (_accessRights.Delete)
						{
							<MudMenuItem OnClick="@(() => OnDeleteCarpark(context.Item))">@AppStrings.Delete</MudMenuItem>
						}
					</MudMenu>
				}
				else
				{
					<MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
						<MudIconButton Variant="Variant.Outlined"
									   Disabled="true"
									   Icon="@Icons.Material.Filled.DoNotTouch"
									   Size="Size.Small"
									   Color="Color.Surface">
							@AppStrings.NoAllowed
						</MudIconButton>
					</MudTooltip>
				}
			</CellTemplate>
		</TemplateColumn>
		<PropertyColumn Property="x => x.Name" Title="@L[_carparkDto.GetMemberDescription(x => x.Name)]">
			<CellTemplate>
				<div class="d-flex flex-column">
					<MudText Typo="Typo.body1">@($"{context.Item.Name.Code} - {context.Item.Name.Tc}")</MudText>
					<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Name.En</MudText>
				</div>
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.Address" Title="@L[_carparkDto.GetMemberDescription(x => x.Address)]">
			<CellTemplate>
				<div class="d-flex flex-column">
					<MudText Typo="Typo.body1">@($"{context.Item.Address.Tc}")</MudText>
					<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Address.En</MudText>
				</div>
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.CompanyName" Title="@L[_carparkDto.GetMemberDescription(x => x.CompanyName)]">
			<CellTemplate>
				<div class="d-flex flex-column">
					<MudText Typo="Typo.body1">@($"{context.Item.CompanyName.Tc}")</MudText>
					<MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.CompanyName.En</MudText>
				</div>
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.ContactPerson" Title="@L[_carparkDto.GetMemberDescription(x => x.ContactPerson)]" />
		<PropertyColumn Property="x => x.PhoneNumber" Title="@L[_carparkDto.GetMemberDescription(x => x.PhoneNumber)]" />
		<PropertyColumn Property="x => x.Fax" Title="@L[_carparkDto.GetMemberDescription(x => x.Fax)]" />
		<PropertyColumn Property="x => x.Email" Title="@L[_carparkDto.GetMemberDescription(x => x.Email)]" />
		<PropertyColumn Property="x => x.Identified" Title="@L[_carparkDto.GetMemberDescription(x => x.Identified)]" />


	</Columns>
	<NoRecordsContent>
		<MudText>@AppStrings.NoRecords</MudText>
	</NoRecordsContent>
	<LoadingContent>
		<MudText>@AppStrings.Loading</MudText>
	</LoadingContent>
	<PagerContent>
		<MudDataGridPager PageSizeOptions="@(new int[] { 10, 15, 30, 50, 100, 500, 1000 })" />
	</PagerContent>
</MudDataGrid>



@code {
	public string? Title { get; private set; }
	private int _defaultPageSize = 15;
	private HashSet<CarparkDto> _selectedCarparks = new HashSet<CarparkDto>();
	private MudDataGrid<CarparkDto> _carparksGrid = default!;
	private CarparkDto _carparkDto = new();
	private bool _loading;
	private bool _uploading;
	private bool _exporting;
	[CascadingParameter]
	private Task<AuthenticationState> AuthState { get; set; } = default!;
	[CascadingParameter]
	private UserProfile? UserProfile { get; set; }


	private CarparksWithPaginationQuery _carparksQuery { get; set; } = new();
	private CarparksAccessRights _accessRights = new();

	protected override async Task OnInitializedAsync()
	{
		Title = L[_carparkDto.GetClassDescription()];
		_accessRights = await PermissionService.GetAccessRightsAsync<CarparksAccessRights>();
	}

	private async Task<GridData<CarparkDto>> ServerReload(GridState<CarparkDto> state)
	{
		try
		{
			_loading = true;
			_carparksQuery.CurrentUser = UserProfile;
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_carparksQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
			_carparksQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
									  ? SortDirection.Descending.ToString()
									  : SortDirection.Ascending.ToString();
			_carparksQuery.PageNumber = state.Page + 1;
			_carparksQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_carparksQuery).ConfigureAwait(false);
			return new GridData<CarparkDto>() { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}

	}
	private async Task OnSearch(string text)
	{
		_selectedCarparks.Clear();
		_carparksQuery.Keyword = text;
		await _carparksGrid.ReloadServerData();
	}
	private async Task OnListViewChanged(CarparkListView listview)
	{
		_carparksQuery.ListView = listview;
		await _carparksGrid.ReloadServerData();
	}
	private async Task OnRefresh()
	{
		CarparkCacheKey.Refresh();
		_selectedCarparks.Clear();
		_carparksQuery.Keyword = string.Empty;
		await _carparksGrid.ReloadServerData();
	}
	private Task ShowEditFormDialog(string title, AddEditCarparkCommand command)
	{
		return DialogServiceHelper.ShowFormDialogAsync<CarparkFormDialog, AddEditCarparkCommand>(
			title,
			new DialogParameters<CarparkFormDialog>()
			{
				{x => x._model, command }
			},
			async () =>
			{
				await _carparksGrid.ReloadServerData();
				_selectedCarparks.Clear();
			});
	}
	private void OnDataGridRowClick(CarparkDto dto)
	{
		Navigation.NavigateTo($"/pages/carparks/view/{dto.Id}");
	}
	private Task OnCreate()
	{
		Navigation.NavigateTo($"/pages/carparks/create");
		return Task.CompletedTask;
	}
	
	private Task OnEditCarpark(CarparkDto dto)
	{
		//var command = Mapper.Map<AddEditCarparkCommand>(dto);
		//return ShowEditFormDialog(L["Edit Carpark"], command);
		Navigation.NavigateTo($"/pages/carparks/edit/{dto.Id}");
		return Task.CompletedTask;
	}

	private Task OnDeleteCarpark(CarparkDto dto)
	{
		var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Name);
		var command = new DeleteCarparkCommand(new int[] { dto.Id });
		return DeleteCarparksInternal(command, contentText);
	}

	private Task OnDeleteSelectedCarparks()
	{
		var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedCarparks.Count);
		var command = new DeleteCarparkCommand(_selectedCarparks.Select(x => x.Id).ToArray());
		return DeleteCarparksInternal(command, contentText);
	}

	private Task DeleteCarparksInternal(DeleteCarparkCommand command, string contentText)
	{
		return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
			command,
			AppStrings.DeleteConfirmationTitle,
			contentText,
			async () =>
			{
				await _carparksGrid.ReloadServerData();
				_selectedCarparks.Clear();
			});
	}


	private async Task OnExport()
	{
		_exporting = true;
		var request = new ExportCarparksQuery()
		{
			Keyword = _carparksQuery.Keyword,
			CurrentUser = UserProfile,
			ListView = _carparksQuery.ListView,
			OrderBy = _carparksGrid.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
			SortDirection = (_carparksGrid.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
		};
		var result = await Mediator.Send(request);
		await result.MatchAsync(
			async data =>
			{
				await BlazorDownloadFileService.DownloadFileAsync($"{L["Carparks"]}.xlsx", result.Data, contentType: "application/octet-stream");
				Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
			},
			errors =>
			{
				Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
				return Task.CompletedTask;
			});
		_exporting = false;
	}
	private async Task OnImportData(IBrowserFile file)
	{
		_uploading = true;
		var stream = new MemoryStream();
		await file.OpenReadStream().CopyToAsync(stream);
		var command = new ImportCarparksCommand(file.Name, stream.ToArray());
		var result = await Mediator.Send(command);
		await result.MatchAsync(
			async data =>
			{
				await _carparksGrid.ReloadServerData();
				Snackbar.Add($"{AppStrings.ImportSuccess}", MudBlazor.Severity.Info);
			}, errors =>
			{
				Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
				return Task.CompletedTask;
			});
		_uploading = false;
	}

}
