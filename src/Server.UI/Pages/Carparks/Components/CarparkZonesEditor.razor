@using CleanArchitecture.Blazor.Application.Features.Gates.DTOs
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.DTOs
@using CleanArchitecture.Blazor.Application.Features.Vehicles.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Charges.DTOs
@using CleanArchitecture.Blazor.Domain.Enums
@inject IStringLocalizer<Carparks> L

<MudStack Row Spacing="2" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.subtitle2" Class="mt-2">@L["Zones"]</MudText>
    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddZone">@L["Add"]</MudButton>
</MudStack>
@if (Zones != null && Zones.Any())
{
    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" @bind-ActivePanelIndex="_activeIndex">
        @foreach (var zone in Zones)
        {
            <MudTabPanel Text="@zone.Name.Code">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudTextField Label="@L["Zone Code"]" @bind-Value="zone.Name.Code" T="string" Required="true" RequiredError="@L["zone code is required!"]"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Label="@L["Zone Name"]" @bind-Value="zone.Name.Tc" T="string" Required="true" RequiredError="@L["zone name is required!"]"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Label="@L["Zone En Name"]" @bind-Value="zone.Name.En" T="string" Required="true" RequiredError="@L["zone en name is required!"]"></MudTextField>
                    </MudItem>
                    <MudItem xs="4">
                        <MudCheckBox  Color="Color.Primary" Label="@L["Is Main"]" @bind-Value="zone.IsMain" T="bool"></MudCheckBox>
                    </MudItem>
                    <MudItem xs="4">
                        <MudCheckBox  Color="Color.Primary" Label="@L["Is Open Cashbox"]" @bind-Value="zone.IsOpenCashbox" T="bool"></MudCheckBox>
                    </MudItem>
                    <MudItem xs="4">
                        <MudTextField Label="@L["Description"]" @bind-Value="zone.Description" T="string"></MudTextField>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText>@L["Holiday Options"]</MudText>
                        <MudStack Row Spacing="2">
                            <MudCheckBox  Color="Color.Primary" Label="@L["PH"]" Value="@(zone.HolidaySets!.Split(',')[0] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 0))"></MudCheckBox>
                            <MudCheckBox  Color="Color.Primary" Label="@L["Mon"]" Value="@(zone.HolidaySets!.Split(',')[1] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 1))"></MudCheckBox>
                            <MudCheckBox  Color="Color.Primary" Label="@L["Tue"]" Value="@(zone.HolidaySets!.Split(',')[2] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 2))"></MudCheckBox>
                            <MudCheckBox  Color="Color.Primary" Label="@L["Wed"]" Value="@(zone.HolidaySets!.Split(',')[3] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 3))"></MudCheckBox>
                            <MudCheckBox  Color="Color.Primary" Label="@L["Thu"]" Value="@(zone.HolidaySets!.Split(',')[4] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 4))"></MudCheckBox>
                            <MudCheckBox  Color="Color.Primary" Label="@L["Fri"]" Value="@(zone.HolidaySets!.Split(',')[5] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 5))"></MudCheckBox>
                            <MudCheckBox  Color="Color.Primary" Label="@L["Sat"]" Value="@(zone.HolidaySets!.Split(',')[6] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 6))"></MudCheckBox>
                            <MudCheckBox  Color="Color.Primary" Label="@L["Sun"]" Value="@(zone.HolidaySets!.Split(',')[7] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 7))"></MudCheckBox>
                        </MudStack>
                    </MudItem>
					<MudItem xs="12">
						<MudTabs Elevation="1" ApplyEffectsToContainer="true" PanelClass="pa-6">
							<MudTabPanel Text="@L["Hourly Sets"]">
								<MudGrid Spacing="2">
									<MudItem xs="6">
										<MudSelect T="PermitTypes" MultiSelection="true" Label="@L["Permit Types"]" @bind-SelectedValues="zone.HourlySets.Permits" Required="true" RequiredError="@L["permit type is required!"]">
											@foreach (var item in Enum.GetValues<PermitTypes>())
											{
												<MudSelectItem T="PermitTypes" Value="item">@item.GetDisplayTc()</MudSelectItem>
											}
										</MudSelect>
									</MudItem>
									<MudItem xs="6">
										<MudSelect T="LicensePlateVerifications" MultiSelection="true" Label="@L["Plate Verifications"]" @bind-SelectedValues="zone.HourlySets.PlateVerifications" Required="true" RequiredError="@L["plate verifications is required!"]">
											@foreach (var item in Enum.GetValues<LicensePlateVerifications>())
											{
												<MudSelectItem T="LicensePlateVerifications" Value="item">@item.GetDisplayTc()</MudSelectItem>
											}
										</MudSelect>

									</MudItem>
									<MudItem xs="6">
										<MudNumericField Label="@L["Capacity"]" @bind-Value="zone.HourlySets.Capacity" For="@(() => zone.HourlySets.Capacity)" Min="0" Required="true" RequiredError="@L["capacity is required!"]"></MudNumericField>
									</MudItem>
									<MudItem xs="6">
										<MudNumericField Label="@L["Adjustment"]" @bind-Value="zone.HourlySets.Adjustment" For="@(() => zone.HourlySets.Adjustment)" Min="0" RequiredError="@L["capacity is required!"]"></MudNumericField>
									</MudItem>
									<MudItem xs="6">
										<MudCheckBox  Color="Color.Primary" Label="@L["Manual Full"]" @bind-Value="zone.HourlySets.ManualFull"></MudCheckBox>
									</MudItem>
									<MudItem xs="6">
										<MudNumericField Label="@L["Grace Period"]" @bind-Value="zone.HourlySets.GracePeriod" For="@(() => zone.HourlySets.GracePeriod)" Min="0"></MudNumericField>
									</MudItem>
									<MudItem xs="6">
										<MudNumericField Label="@L["Exit Buffer"]" @bind-Value="zone.HourlySets.ExitBuffer" For="@(() => zone.HourlySets.ExitBuffer)" Min="0"></MudNumericField>
									</MudItem>
									<MudItem xs="6">
										<MudNumericField Label="@L["Lost Ticket Fee"]" @bind-Value="zone.HourlySets.LostTicketFee" For="@(() => zone.HourlySets.LostTicketFee)" Min="0"></MudNumericField>
									</MudItem>
									<MudItem xs="6">
									</MudItem>
								</MudGrid>
							</MudTabPanel>
							<MudTabPanel Text="@L["Monthly Sets"]">
								<MudGrid Spacing="2">
									<MudItem xs="6">
										<MudSelect T="PermitTypes" MultiSelection="true" Label="@L["Permit Types"]" @bind-SelectedValues="zone.MonthlySets.Permits" Required="true" RequiredError="@L["permit type is required!"]">
											@foreach (var item in Enum.GetValues<PermitTypes>())
											{
												<MudSelectItem T="PermitTypes" Value="item">@item.GetDisplayTc()</MudSelectItem>
											}
										</MudSelect>
									</MudItem>
									<MudItem xs="6">
										<MudSelect T="LicensePlateVerifications" MultiSelection="true" Label="@L["Plate Verifications"]" @bind-SelectedValues="zone.MonthlySets.PlateVerifications" Required="true" RequiredError="@L["plate verifications is required!"]">
											@foreach (var item in Enum.GetValues<LicensePlateVerifications>())
											{
												<MudSelectItem T="LicensePlateVerifications" Value="item">@item.GetDisplayTc()</MudSelectItem>
											}
										</MudSelect>

									</MudItem>
									<MudItem xs="6">
										<MudSelect T="AntiPassbackControls" MultiSelection="true" Label="@L["Permit Types"]" @bind-SelectedValues="zone.MonthlySets.AntiPassbacks" Required="true" RequiredError="@L["anti passbacks is required!"]">
											@foreach (var item in Enum.GetValues<AntiPassbackControls>())
											{
												<MudSelectItem T="AntiPassbackControls" Value="item">@item.GetDisplayTc()</MudSelectItem>
											}
										</MudSelect>
									</MudItem>
									<MudItem xs="6">
										<MudSelect T="MonthlyConversions" MultiSelection="true" Label="@L["Plate Verifications"]" @bind-SelectedValues="zone.MonthlySets.Conversions" Required="true" RequiredError="@L["conversions is required!"]">
											@foreach (var item in Enum.GetValues<MonthlyConversions>())
											{
												<MudSelectItem T="MonthlyConversions" Value="item">@item.GetDisplayTc()</MudSelectItem>
											}
										</MudSelect>

									</MudItem>
									<MudItem xs="6">

										<MudNumericField Label="@L["Deposit"]" @bind-Value="zone.MonthlySets.Deposit" For="@(() => zone.MonthlySets.Deposit)" Min="0" RequiredError="@L["deposit is required!"]"></MudNumericField>

									</MudItem>

								</MudGrid>
							</MudTabPanel>
						</MudTabs>
					</MudItem>
                </MudGrid>
                <MudGrid Spacing="2">
                    <MudItem xs="12" Class="mt-4">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudText>@L["Vehicles Allowed in the Zone"]</MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddVehicleToZone(zone))">@L["Add"]</MudButton>
                        </MudStack>

                    </MudItem>
                    @if (zone.Vehicles != null && zone.Vehicles.Any())
                    {
                        <MudItem xs="12">
                            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                                @foreach (var vehicle in zone.Vehicles)
                                {
                                    <MudExpansionPanel Text="@vehicle.Name" Expanded="true">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" md="4">
                                                <MudTextField Label="@L["Vehicle Name"]" @bind-Value="vehicle.Name" T="string" Required="true" RequiredError="@L["vehicle name is required!"]"></MudTextField>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudEnumSelect TEnum="Nullable<ServiceCategories>" Label="@L["Service Categorie"]" @bind-Value="vehicle.ServiceCategoryId" Required="true" RequiredError="@L["service is required!"]"></MudEnumSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudEnumSelect TEnum="Nullable<VehicleTypes>" Label="@L["Vehicle Types"]" @bind-Value="vehicle.VehicleTypeId" Required="true" RequiredError="@L["vehicle type is required!"]"></MudEnumSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <ChargeAutocomplete T="ChargeDto" Label="@L["Charge"]" @bind-Value="vehicle.Charge" Required="true" RequiredError="@L["charge is required!"]"></ChargeAutocomplete>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudNumericField Label="@L["Capacity"]" @bind-Value="vehicle.Capacity" T="int"></MudNumericField>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudNumericField Label="@L["Occupied"]" @bind-Value="vehicle.Occupied" T="int"></MudNumericField>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Available"]" Value="@(vehicle.Available == 1)" T="bool" ReadOnly></MudCheckBox>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Allow Entry When Full"]" @bind-Value="vehicle.AllowEntryWhenFull" T="bool"></MudCheckBox>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Manual Full"]" @bind-Value="vehicle.ManualFull" T="bool"></MudCheckBox>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Can Recognize Plate"]" @bind-Value="vehicle.CanRecognizePlate" T="bool"></MudCheckBox>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Is Active"]" @bind-Value="vehicle.IsActive" T="bool"></MudCheckBox>
                                            </MudItem>
                                        </MudGrid>

                                        <MudStack Row Justify="Justify.FlexEnd">
                                            <MudButton Class="" StartIcon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => zone.Vehicles.Remove(vehicle))">@L["Remove"]</MudButton>
                                        </MudStack>
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>
                        </MudItem>
                    }
                </MudGrid>
                <MudGrid Spacing="2">
                    <MudItem xs="12" Class="mt-4">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudText>@L["Space Group in the Zone"]</MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddSpaceGroupToZone(zone))">@L["Add"]</MudButton>
                        </MudStack>
                        @if (zone.SpaceGroups != null && zone.SpaceGroups.Any())
                        {
                            @foreach (var item in zone.SpaceGroups)
                            {
                                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator"></MudIcon>
                                    <MudStack Row Spacing="2">
                                        <MudTextField Label="@L["Name"]" @bind-Value="item.Name" T="string"></MudTextField>
                                        <MudNumericField Label="@L["Capacity"]" @bind-Value="item.Capacity" T="int"></MudNumericField>
                                        <MudTextField Label="@L["Description"]" @bind-Value="item.Description" T="string"></MudTextField>
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => zone.SpaceGroups.Remove(item))">Delete</MudIconButton>
                                    </MudStack>
                                </MudStack>
                            }
                        }
                    </MudItem>

                </MudGrid>
                <MudGrid Spacing="2">
                    <MudItem xs="12" Class="mt-4">
                        <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                            <MudText>@L["Gate in the Zone"]</MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddGateToZone(zone))">@L["Add"]</MudButton>
                        </MudStack>
                    </MudItem>
                    @if (zone.Gates != null && zone.Gates.Any())
                    {
                        <MudItem xs="12">
                            <MudExpansionPanels MultiExpansion="true" Elevation="1">
                                @foreach (var item in zone.Gates)
                                {
                                    <MudExpansionPanel Text="@item.Name" Expanded="true">
                                        <MudGrid Spacing="2">
                                            <MudItem xs="12" md="4">
                                                <MudTextField Label="@L["Gate Name"]" @bind-Value="item.Name" T="string" Required="true" RequiredError="@L["gate name is required!"]"></MudTextField>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudEnumSelect TEnum="Nullable<GateType>" Label="@L["Gate Types"]" @bind-Value="item.GateType" Required="true" RequiredError="@L["gate type is required!"]"></MudEnumSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudNumericField T="int" Label="@L["Lane No"]" @bind-Value="item.LaneNo" Required="true" RequiredError="@L["LaneNo is required!"]"></MudNumericField>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudSelect T="PermitTypes" MultiSelection="true" Label="@L["Hourly Permit Types"]" @bind-SelectedValues="item.HourlyPermitTypes">
                                                    @foreach (var permitType in Enum.GetValues<PermitTypes>())
                                                    {
                                                        <MudSelectItem T="PermitTypes" Value="permitType">@permitType.GetDisplayTc()</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudSelect T="PermitTypes" MultiSelection="true" Label="@L["Monthly Permit Types"]" @bind-SelectedValues="item.MonthlyPermitTypes">
                                                    @foreach (var permitType in Enum.GetValues<PermitTypes>())
                                                    {
                                                        <MudSelectItem T="PermitTypes" Value="permitType">@permitType.GetDisplayTc()</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Is Upper"]" @bind-Value="item.IsUpper" T="bool"></MudCheckBox>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Is Left hand"]" @bind-Value="item.IsLefthand" T="bool"></MudCheckBox>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudCheckBox  Color="Color.Primary" Label="@L["Is Active"]" @bind-Value="item.IsActive" T="bool"></MudCheckBox>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudTextField Label="@L["Description"]" @bind-Value="item.Description" T="string"></MudTextField>
                                            </MudItem>
                                        </MudGrid>

                                        <MudStack Row Justify="Justify.FlexEnd">
                                            <MudButton Class="" StartIcon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="@(() => zone.Gates.Remove(item))">@L["Remove"]</MudButton>
                                        </MudStack>
                                    </MudExpansionPanel>
                                }

                            </MudExpansionPanels>
                        </MudItem>

                    }
                </MudGrid>
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    [Parameter] public List<ZoneDto>? Zones { get; set; }
    [Parameter] public Func<Task<bool>>? ValidateParent { get; set; }

    private int _activeIndex = 0;

    private async Task<bool> EnsureValidAsync()
    {
        if (ValidateParent is not null)
        {
            return await ValidateParent.Invoke();
        }
        return true;
    }

    private async Task AddZone()
    {
        if (!await EnsureValidAsync()) return;
        Zones ??= new List<ZoneDto>();
        var count = Zones.Count;
        Zones.Add(new ZoneDto
        {
            Name = new MultiCodeName("Z-" + (count + 1), "", ""),
            IsMain = Zones.Count == 0,
            IsOpenCashbox = false,
            Gates = new List<GateDto>() { new GateDto() { Name = "Z-1-G-1", IsActive = true } },
            Vehicles = new List<VehicleDto>() { new VehicleDto() { Name = "Z-1-V-1" } },
            SpaceGroups = new List<SpaceGroupDto>() { new SpaceGroupDto() { Name = "Z-1-SG-1", Capacity = 1 } },
            HolidaySets = "0,0,0,0,0,0,0,0"
        });
        _activeIndex = Zones.Count - 1;
    }

    private async Task AddVehicleToZone(ZoneDto zone)
    {
        if (!await EnsureValidAsync()) return;
        zone.Vehicles ??= new List<VehicleDto>();
        var count = zone.Vehicles.Count;
        zone.Vehicles.Add(new VehicleDto() { Name =zone.Name.Code + "-V-" + (count + 1) });
    }

    private async Task AddSpaceGroupToZone(ZoneDto zone)
    {
        if (!await EnsureValidAsync()) return;
        zone.SpaceGroups ??= new List<SpaceGroupDto>();
        var count = zone.SpaceGroups.Count;
        zone.SpaceGroups.Add(new SpaceGroupDto() { Name =zone.Name.Code + "-SG-" + (count + 1), Capacity = 1 });
    }

    private async Task AddGateToZone(ZoneDto zone)
    {
        if (!await EnsureValidAsync()) return;
        zone.Gates ??= new List<GateDto>();
        var count = zone.Gates.Count;
        zone.Gates.Add(new GateDto() { Name = zone.Name.Code + "-G-" + (count + 1), IsActive = true });
    }

    void HolidayValueChange(ZoneDto zone, bool value, int index)
    {
        var holidaySets = zone.HolidaySets?.Split(',') ?? new string[] { "0", "0", "0", "0", "0", "0", "0", "0" };
        holidaySets[index] = value ? "1" : "0";
        zone.HolidaySets = string.Join(',', holidaySets);
    }
}
