@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Charges.DTOs
@using CleanArchitecture.Blazor.Domain.Enums
@inject IStringLocalizer<Carparks> L

@if (Zones != null && Zones.Any())
{
	<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" @bind-ActivePanelIndex="_activeIndex">
		@foreach (var zone in Zones)
		{
			<MudTabPanel Text="@zone.Name.Code">
				<MudGrid Spacing="2">
					<MudItem xs="12" md="4">
						<ReadOnlyField Label="@L["Zone Code"]" Value="@zone.Name.Code" />
					</MudItem>
					<MudItem xs="12" md="4">
						<ReadOnlyField Label="@L["Zone Name"]" Value="@zone.Name.Tc" />
					</MudItem>
					<MudItem xs="12" md="4">
						<ReadOnlyField Label="@L["Zone En Name"]" Value="@zone.Name.En" />
					</MudItem>
					<MudItem xs="4">
						<ReadOnlyField CheckBox="true" Label="@L["Is Main"]" Value="@zone.IsMain" />
					</MudItem>
					<MudItem xs="4">
						<ReadOnlyField CheckBox="true" Label="@L["Is Open Cashbox"]" Value="@zone.IsOpenCashbox" />
					</MudItem>
					<MudItem xs="4">
						<ReadOnlyField Label="@L["Description"]" Value="@zone.Description" />
					</MudItem>
					<MudItem xs="12">
						<MudText>@L["Holiday Options"]</MudText>
						<MudStack Row Spacing="2">
							<ReadOnlyField CheckBox="true" Label="@L["PH"]" Value="@IsHoliday(zone, 0)" />
							<ReadOnlyField CheckBox="true" Label="@L["Mon"]" Value="@IsHoliday(zone, 1)" />
							<ReadOnlyField CheckBox="true" Label="@L["Tue"]" Value="@IsHoliday(zone, 2)" />
							<ReadOnlyField CheckBox="true" Label="@L["Wed"]" Value="@IsHoliday(zone, 3)" />
							<ReadOnlyField CheckBox="true" Label="@L["Thu"]" Value="@IsHoliday(zone, 4)" />
							<ReadOnlyField CheckBox="true" Label="@L["Fri"]" Value="@IsHoliday(zone, 5)" />
							<ReadOnlyField CheckBox="true" Label="@L["Sat"]" Value="@IsHoliday(zone, 6)" />
							<ReadOnlyField CheckBox="true" Label="@L["Sun"]" Value="@IsHoliday(zone, 7)" />
						</MudStack>
					</MudItem>
					<MudItem xs="12">
						<MudTabs Elevation="1" ApplyEffectsToContainer="true" PanelClass="pa-6">
							<MudTabPanel Text="@L["Hourly Sets"]">
								<MudGrid Spacing="2">
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Permit Types"]" Value="zone.HourlySets.Permits?.Select(x => x.GetDisplayTc())">
											 
										</ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Plate Verifications"]" Value="zone.HourlySets.PlateVerifications?.Select(x => x.GetDisplayTc())">
											 
										</ReadOnlyField>

									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Capacity"]" Value="zone.HourlySets.Capacity" ></ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Adjustment"]" Value="zone.HourlySets.Adjustment" ></ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Manual Full"]" Value="zone.HourlySets.ManualFull"></ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Grace Period"]" Value="zone.HourlySets.GracePeriod"></ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Exit Buffer"]" Value="zone.HourlySets.ExitBuffer"></ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Lost Ticket Fee"]" Value="zone.HourlySets.LostTicketFee"></ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
									</MudItem>
								</MudGrid>
							</MudTabPanel>
							<MudTabPanel Text="@L["Monthly Sets"]">
								<MudGrid Spacing="2">
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Permit Types"]" Value="zone.MonthlySets.Permits?.Select(x=>x.GetDisplayTc())" >
											
										</ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Plate Verifications"]" Value="zone.MonthlySets.PlateVerifications?.Select(x=>x.GetDisplayTc())" >
									
										</ReadOnlyField>

									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Permit Types"]" Value="zone.MonthlySets.AntiPassbacks?.Select(x => x.GetDisplayTc())">
											
										</ReadOnlyField>
									</MudItem>
									<MudItem xs="6">
										<ReadOnlyField Label="@L["Plate Verifications"]" Value="zone.MonthlySets.Conversions?.Select(x => x.GetDisplayTc())">
											 
										</ReadOnlyField>

									</MudItem>
									<MudItem xs="6">

										<ReadOnlyField Label="@L["Deposit"]" Value="zone.MonthlySets.Deposit"></ReadOnlyField>

									</MudItem>

								</MudGrid>
							</MudTabPanel>
						</MudTabs>
					</MudItem>
				</MudGrid>
				<MudGrid Spacing="2">
					<MudItem xs="12" Class="mt-4">
						<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
							<MudText>@L["Vehicles Allowed in the Zone"]</MudText>
						</MudStack>
					</MudItem>
					@if (zone.Vehicles != null && zone.Vehicles.Any())
					{
						<MudItem xs="12">
							<MudExpansionPanels MultiExpansion="true" Elevation="1">
								@foreach (var vehicle in zone.Vehicles)
								{
									<MudExpansionPanel Text="@vehicle.Name" Expanded="false">
										<MudGrid Spacing="2">
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Vehicle Name"]" Value="@vehicle.Name" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Service Categorie"]" Value="@vehicle.ServiceCategoryId?.GetDisplayTc()" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Vehicle Types"]" Value="@vehicle.VehicleTypeId?.GetDisplayTc()" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Charge"]" Value="@vehicle.Charge?.Name" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Capacity"]" Value="@vehicle.Capacity" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Occupied"]" Value="@vehicle.Occupied" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Available"]" Value="@(vehicle.Available == 1)" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Allow Entry When Full"]" Value="@vehicle.AllowEntryWhenFull" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Manual Full"]" Value="@vehicle.ManualFull" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Can Recognize Plate"]" Value="@vehicle.CanRecognizePlate" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Is Active"]" Value="@vehicle.IsActive" />
											</MudItem>
										</MudGrid>
									</MudExpansionPanel>
								}
							</MudExpansionPanels>
						</MudItem>
					}
				</MudGrid>
				<MudGrid Spacing="2">
					<MudItem xs="12" Class="mt-4">
						<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
							<MudText>@L["Space Group in the Zone"]</MudText>
						</MudStack>
						@if (zone.SpaceGroups != null && zone.SpaceGroups.Any())
						{
							@foreach (var item in zone.SpaceGroups)
							{
								<MudStack Row AlignItems="AlignItems.Center" Justify="Justify.FlexStart">
									<MudIcon Icon="@Icons.Material.Filled.DragIndicator"></MudIcon>
									<MudStack Row Spacing="2">
										<ReadOnlyField Label="@L["Name"]" Value="@item.Name" />
										<ReadOnlyField Label="@L["Capacity"]" Value="@item.Capacity" />
										<ReadOnlyField Label="@L["Description"]" Value="@item.Description" />
									</MudStack>
								</MudStack>
							}
						}
					</MudItem>
				</MudGrid>
				<MudGrid Spacing="2">
					<MudItem xs="12" Class="mt-4">
						<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
							<MudText>@L["Gate in the Zone"]</MudText>
						</MudStack>
					</MudItem>
					@if (zone.Gates != null && zone.Gates.Any())
					{
						<MudItem xs="12">
							<MudExpansionPanels MultiExpansion="true" Elevation="1">
								@foreach (var item in zone.Gates)
								{
									<MudExpansionPanel Text="@item.Name" Expanded="false">
										<MudGrid Spacing="2">
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Gate Name"]" Value="@item.Name" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Gate Types"]" Value="@item.GateType?.GetDisplayTc()" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Lane No"]" Value="@item.LaneNo" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Hourly Permit Types"]" Value="@FormatPermitTypes(item.HourlyPermitTypes)" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Monthly Permit Types"]" Value="@FormatPermitTypes(item.MonthlyPermitTypes)" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Is Upper"]" Value="@item.IsUpper" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Is Left hand"]" Value="@item.IsLefthand" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField CheckBox="true" Label="@L["Is Active"]" Value="@item.IsActive" />
											</MudItem>
											<MudItem xs="12" md="4">
												<ReadOnlyField Label="@L["Description"]" Value="@item.Description" />
											</MudItem>
										</MudGrid>
									</MudExpansionPanel>
								}
							</MudExpansionPanels>
						</MudItem>
					}
				</MudGrid>
			</MudTabPanel>
		}
	</MudTabs>
}

@code {
	[Parameter] public List<ZoneDto>? Zones { get; set; }
	private int _activeIndex = 0;

	private bool IsHoliday(ZoneDto zone, int index)
	{
		var holidaySets = zone.HolidaySets?.Split(',') ?? new string[] { "0", "0", "0", "0", "0", "0", "0", "0" };
		if (index < 0 || index >= holidaySets.Length) return false;
		return holidaySets[index] == "1";
	}

	private string? FormatPermitTypes(IEnumerable<PermitTypes>? types)
	{
		if (types == null || !types.Any()) return null;
		return string.Join(", ", types.Select(t => t.GetDisplayTc()));
	}
}
