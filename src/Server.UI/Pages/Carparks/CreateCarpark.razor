@page "/pages/carparks/create"
@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.Create
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Carparks> L
@attribute [Authorize(Policy = Permissions.Carparks.Create)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
	<MudCard Class="pa-2">
		<MudCardHeader>
			<CardHeaderContent>
				<MudText Typo="Typo.h6">@Title</MudText>
			</CardHeaderContent>
		</MudCardHeader>
		<MudCardContent>
			<MudForm Model="@_model" @ref="@_carparkForm" Validation="@(Validator.ValidateValue(_model))">
				<MudGrid Spacing="2">
					<MudItem xs="12" md="4">
						<MudTextField Label="@L["Code"]" @bind-Value="_model.Name.Code" T="string" Required="true" RequiredError="@L["code is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L["Name"]" @bind-Value="_model.Name.Tc" T="string" Required="true" RequiredError="@L["tc is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L["En Name"]" @bind-Value="_model.Name.En" T="string" Required="true" RequiredError="@L["en is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L["Company Name"]" @bind-Value="_model.CompanyName.Tc" T="string" Required="true" RequiredError="@L["company name is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L["Company En Name"]" @bind-Value="_model.CompanyName.En" T="string" Required="true" RequiredError="@L["company name is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L["Address"]" @bind-Value="_model.Address.Tc" T="string" Required="true" RequiredError="@L["address name is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L["En Address"]" @bind-Value="_model.Address.En" T="string" Required="true" RequiredError="@L["address name is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.AppKey)]" @bind-Value="_model.AppKey" For="@(() => _model.AppKey)" Required="false" RequiredError="@L["app key is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.MachineCode)]" @bind-Value="_model.MachineCode" For="@(() => _model.MachineCode)" Required="false" RequiredError="@L["machine code is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.RegistrationCode)]" @bind-Value="_model.RegistrationCode" For="@(() => _model.RegistrationCode)" Required="false" RequiredError="@L["registration code is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.ContactPerson)]" @bind-Value="_model.ContactPerson" For="@(() => _model.ContactPerson)" Required="false" RequiredError="@L["contact person is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.PhoneNumber)]" @bind-Value="_model.PhoneNumber" For="@(() => _model.PhoneNumber)" Required="false" RequiredError="@L["phone number is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.Fax)]" @bind-Value="_model.Fax" For="@(() => _model.Fax)" Required="false" RequiredError="@L["fax is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.Email)]" @bind-Value="_model.Email" For="@(() => _model.Email)" Required="false" RequiredError="@L["email is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="6">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.Description)]" For="@(() => _model.Description)" @bind-Value="_model.Description"></MudTextField>
					</MudItem>
					<MudItem xs="12">
						<MudStack Row Spacing="2" AlignItems="AlignItems.Center">
							<MudText Typo="Typo.subtitle2" Class="mt-2">@L["Zones"]</MudText>
							<MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddZone">@L["Add"]</MudButton>
						</MudStack>
						@if (_model.Zones != null && _model.Zones.Any())
						{
							<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" @bind-ActivePanelIndex="_activeIndex">
								@foreach (var zone in _model.Zones)
								{
									<MudTabPanel Text="@zone.Name.Code">
										<MudGrid Spacing="2">
											<MudItem xs="12" md="4">
												<MudTextField Label="@L["Zone Code"]" @bind-Value="zone.Name.Code" T="string" Required="true" RequiredError="@L["zone code is required!"]"></MudTextField>
											</MudItem>
											<MudItem xs="12" md="4">
												<MudTextField Label="@L["Zone Name"]" @bind-Value="zone.Name.Tc" T="string" Required="true" RequiredError="@L["zone name is required!"]"></MudTextField>
											</MudItem>
											<MudItem xs="12" md="4">
												<MudTextField Label="@L["Zone En Name"]" @bind-Value="zone.Name.En" T="string" Required="true" RequiredError="@L["zone en name is required!"]"></MudTextField>
											</MudItem>
											<MudItem xs="4">
												<MudCheckBox Label="@L["Is Main"]" @bind-Value="zone.IsMain" T="bool"></MudCheckBox>
											</MudItem>
											<MudItem xs="4">
												<MudCheckBox Label="@L["Is Open Cashbox"]" @bind-Value="zone.IsOpenCashbox" T="bool"></MudCheckBox>
											</MudItem>
											<MudItem xs="4">
												<MudTextField Label="@L["Description"]" @bind-Value="zone.Description" T="string"></MudTextField>
											</MudItem>
											<MudItem xs="12">
												<MudText>@L["Holiday Options"]</MudText>
												<MudStack Row Spacing="2">
													<MudCheckBox Label="@L["PH"]" Value="@(zone.HolidaySets!.Split(',')[0] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 0))"></MudCheckBox>
													<MudCheckBox Label="@L["Mon"]" Value="@(zone.HolidaySets!.Split(',')[1] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 1))"></MudCheckBox>
													<MudCheckBox Label="@L["Tue"]" Value="@(zone.HolidaySets!.Split(',')[2] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 2))"></MudCheckBox>
													<MudCheckBox Label="@L["Wed"]" Value="@(zone.HolidaySets!.Split(',')[3] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 3))"></MudCheckBox>
													<MudCheckBox Label="@L["Thu"]" Value="@(zone.HolidaySets!.Split(',')[4] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 4))"></MudCheckBox>
													<MudCheckBox Label="@L["Fri"]" Value="@(zone.HolidaySets!.Split(',')[5] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 5))"></MudCheckBox>
													<MudCheckBox Label="@L["Sat"]" Value="@(zone.HolidaySets!.Split(',')[6] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 6))"></MudCheckBox>
													<MudCheckBox Label="@L["Sun"]" Value="@(zone.HolidaySets!.Split(',')[7] == "1")" T="bool" ValueChanged="@((t) => HolidayValueChange(zone, t, 7))"></MudCheckBox>
												</MudStack>
											</MudItem>
										</MudGrid>
										<MudGrid Spacing="2">
											<MudItem xs="12" Class="mt-4">
												<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
													<MudText>@L["Vehicles Allowed in the Zone"]</MudText>
													<MudButton StartIcon="@Icons.Material.Filled.Add">@L["Add"]</MudButton>
												</MudStack>
												
											</MudItem>
											@if (zone.Vehicles != null && zone.Vehicles.Any())
											{

											}
										</MudGrid>
									</MudTabPanel>
								}
							</MudTabs>
						}
					</MudItem>


				</MudGrid>
			</MudForm>
		</MudCardContent>
		<MudCardActions Class="d-flex justify-end gap-2">
			<MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
		</MudCardActions>
	</MudCard>
</MudContainer>


@code {
	public string? Title { get; private set; }
	MudForm _carparkForm = new();
	private bool _saving = false;
	private List<BreadcrumbItem>? _breadcrumbItems;
	private CreateCarparkCommand _model = new();
	protected override Task OnInitializedAsync()
	{
		Title = L["New Carpark"];
		_breadcrumbItems = new List<BreadcrumbItem>
		{
			new BreadcrumbItem(L["Home"], href: "/"),
			new BreadcrumbItem(L["Carparks"], href: "/pages/carparks"),
			new BreadcrumbItem(L["Create Carpark"], href:null, disabled:true)
		};
		return Task.CompletedTask;
	}
	void HolidayValueChange(ZoneDto zone, bool value, int index)
	{

		var holidaySets = zone.HolidaySets?.Split(',') ?? new string[] { "0", "0", "0", "0", "0", "0", "0" };
		holidaySets[index] = value ? "1" : "0";
		zone.HolidaySets = string.Join(',', holidaySets);

	}
	private int _activeIndex = 0;
	private async Task AddZone()
	{
		await _carparkForm.Validate();
		if (!_carparkForm.IsValid) return;
		if (_model.Zones == null)
		{
			_model.Zones = new List<ZoneDto>();
		}
		var count = _model.Zones.Count;
		_model.Zones.Add(new ZoneDto
		{
			Name = new MultiCodeName("Z" + (count + 1).ToString("###0"), "", ""),
			IsMain = _model.Zones.Count == 0,
			IsOpenCashbox = false,
			Gates = new List<GateDto>() { new GateDto() { } },
			Vehicles = new List<VehicleDto>() { new VehicleDto() { } },
			SpaceGroups = new List<SpaceGroupDto>() { new SpaceGroupDto() { } }

		});
		_activeIndex = _model.Zones.Count - 1;
	}
	async Task OnSubmit()
	{
		try
		{
			_saving = true;
			await _carparkForm.Validate().ConfigureAwait(false);
			if (!_carparkForm.IsValid)
				return;
			var result = await Mediator.Send(_model);
			result.Match(
				data =>
				{
					Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
					Navigation.NavigateTo($"/pages/Carparks");
				},
				errors =>
				{
					Snackbar.Add(errors, MudBlazor.Severity.Error);
				});
		}
		finally
		{
			_saving = false;
		}
	}
}