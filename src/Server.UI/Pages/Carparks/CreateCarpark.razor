@page "/pages/carparks/create"
@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.Create

@inherits MudComponentBase
@inject IValidationService Validator
@attribute [Authorize(Policy = Permissions.Carparks.Create)]

<PageTitle>Nuevo Parqueadero</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems" AllowdGoBack="true"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">
    <MudCard Class="pa-2">
        <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Nuevo Parqueadero</MudText></CardHeaderContent></MudCardHeader>
        <MudCardContent>
            <MudForm Model="@_model" @ref="@_form">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="4">
                        <MudTextField Label="Codigo" @bind-Value="_model.Name.Code" ReadOnly="true" Variant="Variant.Outlined"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudTextField Label="Nombre" @bind-Value="_model.Name.Tc" Required="true" Variant="Variant.Outlined"
                                      RequiredError="El nombre es obligatorio"></MudTextField>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Label="Direccion" @bind-Value="_model.Address.Tc" Variant="Variant.Outlined"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Label="Persona Contacto" @bind-Value="_model.ContactPerson" Variant="Variant.Outlined"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField Label="Telefono" @bind-Value="_model.PhoneNumber" Variant="Variant.Outlined"></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField Label="Cap. Carros" @bind-Value="_carCapacity" Min="0" Variant="Variant.Outlined"></MudNumericField>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField Label="Cap. Motos" @bind-Value="_motoCapacity" Min="0" Variant="Variant.Outlined"></MudNumericField>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-end gap-2">
            <MudLoadingButton Color="Color.Primary" Variant="Variant.Filled" Loading="@_saving" OnClick="OnSubmit">Guardar</MudLoadingButton>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    MudForm _form = new();
    private bool _saving;
    private int _carCapacity;
    private int _motoCapacity;
    private List<BreadcrumbItem>? _breadcrumbItems;
    private CreateCarparkCommand _model = new() { Name = new("", "", ""), Address = new("", ""), CompanyName = new("", "") };

    protected override Task OnInitializedAsync()
    {
        _model.Name.Code = $"PK-{DateTime.Now:yyMMdd}-{Random.Shared.Next(100, 999)}";
        _breadcrumbItems = new() { new("Inicio", "/"), new("Parqueaderos", "/pages/carparks"), new("Nuevo", null, true) };
        return Task.CompletedTask;
    }

    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _form.Validate();
            if (!_form.IsValid) return;
            _model.Name.En = _model.Name.Tc;
            _model.Address.En = _model.Address.Tc;
            _model.CompanyName = new(_model.Name.Tc, _model.Name.Tc);
            _model.Description = $"Carros: {_carCapacity}, Motos: {_motoCapacity}";
            var result = await Mediator.Send(_model);
            result.Match(data => { Snackbar.Add("Parqueadero creado", Severity.Success); Navigation.NavigateTo("/pages/carparks"); },
                          errors => Snackbar.Add(errors, Severity.Error));
        }
        finally { _saving = false; }
    }
}
