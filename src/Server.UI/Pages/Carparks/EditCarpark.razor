@page "/pages/carparks/edit/{id:int}"
@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.Update
@using CleanArchitecture.Blazor.Application.Features.Carparks.Queries.GetById
@using CleanArchitecture.Blazor.Application.Features.Charges.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Server.UI.Components.Sessions
@using CleanArchitecture.Blazor.Server.UI.Pages.Carparks.Components

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Carparks> L
@attribute [Authorize(Policy = Permissions.Carparks.Edit)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
	@if (_model != null)
	{
		<MudCard Class="pa-2">
			<MudCardHeader>
				<CardHeaderContent>
					<MudText Typo="Typo.h6">@Title</MudText>
				</CardHeaderContent>
			</MudCardHeader>
			<MudCardContent>
				<MudForm Model="@_model" @ref="@_carparkForm" Validation="@(Validator.ValidateValue(_model))">
					<MudGrid Spacing="2">
						<MudItem xs="12" md="4">
							<MudTextField Label="@L["Code"]" @bind-Value="_model.Name.Code" T="string" Required="true" RequiredError="@L["code is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="4">
							<MudTextField Label="@L["Name"]" @bind-Value="_model.Name.Tc" T="string" Required="true" RequiredError="@L["tc is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="4">
							<MudTextField Label="@L["En Name"]" @bind-Value="_model.Name.En" T="string" Required="true" RequiredError="@L["en is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L["Company Name"]" @bind-Value="_model.CompanyName.Tc" T="string" Required="true" RequiredError="@L["company name is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L["Company En Name"]" @bind-Value="_model.CompanyName.En" T="string" Required="true" RequiredError="@L["company name is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L["Address"]" @bind-Value="_model.Address.Tc" T="string" Required="true" RequiredError="@L["address name is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L["En Address"]" @bind-Value="_model.Address.En" T="string" Required="true" RequiredError="@L["address name is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="4">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.AppKey)]" @bind-Value="_model.AppKey" For="@(() => _model.AppKey)" Required="true" RequiredError="@L["app key is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="4">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.MachineCode)]" @bind-Value="_model.MachineCode" For="@(() => _model.MachineCode)" Required="false" RequiredError="@L["machine code is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="4">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.RegistrationCode)]" @bind-Value="_model.RegistrationCode" For="@(() => _model.RegistrationCode)" Required="false" RequiredError="@L["registration code is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.ContactPerson)]" @bind-Value="_model.ContactPerson" For="@(() => _model.ContactPerson)" Required="false" RequiredError="@L["contact person is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.PhoneNumber)]" @bind-Value="_model.PhoneNumber" For="@(() => _model.PhoneNumber)" Required="false" RequiredError="@L["phone number is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.Fax)]" @bind-Value="_model.Fax" For="@(() => _model.Fax)" Required="false" RequiredError="@L["fax is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.Email)]" @bind-Value="_model.Email" For="@(() => _model.Email)" Required="false" RequiredError="@L["email is required!"]"></MudTextField>
						</MudItem>
						<MudItem xs="12" md="6">
							<MudTextField Label="@L[_model.GetMemberDescription(x => x.Description)]" For="@(() => _model.Description)" @bind-Value="_model.Description"></MudTextField>
						</MudItem>
						<MudItem xs="12">
					<MudStack Row Spacing="2" AlignItems="AlignItems.Center">
						<MudText Typo="Typo.subtitle2" Class="mt-2">@L["Zones"]</MudText>
					</MudStack>
					<CarparkZonesEditor Zones="@_model.Zones" ValidateParent="@ValidateParentForm" />
						</MudItem>


					</MudGrid>
				</MudForm>
			</MudCardContent>
			<MudCardActions Class="d-flex justify-end gap-2">
				<MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
			</MudCardActions>
		</MudCard>
	}
</MudContainer>


@code {
	public string? Title { get; private set; }
	[Parameter]
	public int Id { get; set; }
	MudForm _carparkForm = new();
	private bool _saving = false;
	private List<BreadcrumbItem>? _breadcrumbItems;
	private UpdateCarparkCommand? _model;
	protected override async Task OnInitializedAsync()
	{
		Title = L["Edit Carpark"];
		_breadcrumbItems = new List<BreadcrumbItem>
		{
			new BreadcrumbItem(L["Home"], href: "/"),
			new BreadcrumbItem(L["Carparks"], href: "/pages/carparks")
		};
		var result = await Mediator.Send(new GetCarparkByIdQuery() { Id = Id });
		result.Map(data =>
		{
			_model = Mapper.Map<UpdateCarparkCommand>(data);
			return data;
		}).Match(data =>
		{
			_breadcrumbItems.Add(new BreadcrumbItem(data.Name.Code, href: $"/pages/carparks/edit/{Id}"));
		}, errors =>
		{
			Snackbar.Add($"{errors}", Severity.Error);
		});

	}
	void HolidayValueChange(ZoneDto zone, bool value, int index)
	{

		var holidaySets = zone.HolidaySets?.Split(',') ?? new string[] { "0", "0", "0", "0", "0", "0", "0" };
		holidaySets[index] = value ? "1" : "0";
		zone.HolidaySets = string.Join(',', holidaySets);

	}
	private async Task<bool> ValidateParentForm()
	{
		await _carparkForm.Validate();
		return _carparkForm.IsValid;
	}
	async Task OnSubmit()
	{
		try
		{
			_saving = true;
			await _carparkForm.Validate().ConfigureAwait(false);
			if (!_carparkForm.IsValid)
				return;
			var result = await Mediator.Send(_model);
			result.Match(
				data =>
				{
					Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
				},
				errors =>
				{
					Snackbar.Add(errors, MudBlazor.Severity.Error);
				});
		}
		finally
		{
			_saving = false;
		}
	}
}
