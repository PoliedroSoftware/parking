@page "/pages/carparks/edit/{id:int}"
@using CleanArchitecture.Blazor.Application.Features.Carparks.Commands.Update
@using CleanArchitecture.Blazor.Application.Features.Carparks.Queries.GetById

@inherits MudComponentBase
@inject IValidationService Validator
@attribute [Authorize(Policy = Permissions.Carparks.Edit)]

<PageTitle>Editar Parqueadero</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems" AllowdGoBack="true"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">
    @if (_model != null)
    {
        <MudCard Class="pa-2">
            <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Editar Parqueadero</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                <MudForm Model="@_model" @ref="@_form">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Codigo" @bind-Value="_model.Name.Code" ReadOnly="true" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12" md="8">
                            <MudTextField Label="Nombre" @bind-Value="_model.Name.Tc" Required="true" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Label="Direccion" @bind-Value="_model.Address.Tc" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Persona Contacto" @bind-Value="_model.ContactPerson" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField Label="Telefono" @bind-Value="_model.PhoneNumber" Variant="Variant.Outlined"></MudTextField>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudNumericField Label="Cap. Carros" @bind-Value="_carCapacity" Min="0" Variant="Variant.Outlined"></MudNumericField>
                        </MudItem>
                        <MudItem xs="12" md="2">
                            <MudNumericField Label="Cap. Motos" @bind-Value="_motoCapacity" Min="0" Variant="Variant.Outlined"></MudNumericField>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudCardContent>
            <MudCardActions Class="d-flex justify-end gap-2">
                <MudLoadingButton Color="Color.Primary" Variant="Variant.Filled" Loading="@_saving" OnClick="OnSubmit">Guardar</MudLoadingButton>
            </MudCardActions>
        </MudCard>
    }
</MudContainer>

@code {
    MudForm _form = new();
    private bool _saving;
    private int _carCapacity;
    private int _motoCapacity;
    private UpdateCarparkCommand? _model;
    private List<BreadcrumbItem>? _breadcrumbItems;

    [Parameter] public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await Mediator.Send(new GetCarparkByIdQuery { Id = Id });
        if (result.Succeeded)
        {
            _model = Mapper.Map<UpdateCarparkCommand>(result.Data);
            var parts = result.Data.Description?.Replace("Carros: ", "").Replace("Motos: ", "").Split(",");
            if (parts?.Length >= 2)
            {
                int.TryParse(parts[0].Trim(), out _carCapacity);
                int.TryParse(parts[1].Trim(), out _motoCapacity);
            }
        }
        _breadcrumbItems = new() { new("Inicio", "/"), new("Parqueaderos", "/pages/carparks"), new("Editar", null, true) };
    }

    async Task OnSubmit()
    {
        if (_model == null) return;
        try
        {
            _saving = true;
            _model.Name.En = _model.Name.Tc;
            _model.Address.En = _model.Address.Tc;
            _model.Description = $"Carros: {_carCapacity}, Motos: {_motoCapacity}";
            var result = await Mediator.Send(_model);
            result.Match(data => { Snackbar.Add("Parqueadero actualizado", Severity.Success); Navigation.NavigateTo("/pages/carparks"); },
                          errors => Snackbar.Add(errors, Severity.Error));
        }
        finally { _saving = false; }
    }
}
