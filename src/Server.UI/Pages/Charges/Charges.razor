@page "/pages/charges"

@using CleanArchitecture.Blazor.Application.Features.Charges.Caching
@using CleanArchitecture.Blazor.Application.Features.Charges.DTOs
@using CleanArchitecture.Blazor.Application.Features.Charges.Specifications
@using CleanArchitecture.Blazor.Application.Features.Charges.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Charges.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.Charges.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Charges.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Charges.Commands.AddEdit
@using CleanArchitecture.Blazor.Server.UI.Pages.Charges.Components

@inject IStringLocalizer<Charges> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.Charges.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
                  FixedHeader="true"
                  FixedFooter="false"
                  Virtualize="false"
                  @bind-RowsPerPage="_defaultPageSize"
                  Loading="@_loading"
                  MultiSelection="true"
                  T="ChargeDto"
                  SelectOnRowClick="false"
                  RowClick="@(s=>OnDataGridRowClick(s.Item))"
                  @bind-SelectedItems="_selectedCharges"
                  Hover="true" @ref="_chargesGrid">
            <ToolBarContent>
                 <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="ChargeListView" ValueChanged="OnListViewChanged" Value="_chargesQuery.ListView" Dense="true" Label="@L["List View"]">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="OnCreate">
                            @AppStrings.New
                        </MudButton>
                    }
                    @if (_accessRights.Delete)
                    {
                            <MudButton Disabled="@(!(_selectedCharges.Count > 0))"
                                       StartIcon="@Icons.Material.Outlined.DeleteOutline"
                                         OnClick="OnDeleteSelectedCharges">
                                @AppStrings.Delete
                            </MudButton>
                    }
                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">
                        @if (_accessRights.Clone)
                        {
                            <MudMenuItem Disabled="@(_selectedCharges.Count != 1)" OnClick="OnCloneCharge">@AppStrings.Clone</MudMenuItem>
                        }
                        
                        @if (_accessRights.Export)
                        {
                            <MudMenuItem Disabled="@_exporting"
                                         OnClick="OnExport">
                                @AppStrings.Export
                            </MudMenuItem>
                        }
                        @if (_accessRights.Import)
                        {
                            <MudMenuItem>
                                <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                                    <ActivatorContent>
                                        <MudButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
                                                   Variant="Variant.Text"
                                                   Disabled="@_uploading">
                                            @AppStrings.Import
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Search)
                    {
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_chargesQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
            </ToolBarContent>
            <Columns>
                <SelectColumn ShowInFooter="false"></SelectColumn>
                <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
                    <CellTemplate>
                        @if (_accessRights.Edit || _accessRights.Delete)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
                                     Dense="true"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                                @if (_accessRights.Edit)
                                {
                                    <MudMenuItem OnClick="@(()=>OnEditCharge(context.Item))">@AppStrings.Edit</MudMenuItem>
                                }
                                @if (_accessRights.Delete)
                                {
                                    <MudMenuItem OnClick="@(()=>OnDeleteCharge(context.Item))">@AppStrings.Delete</MudMenuItem>
                                }
                            </MudMenu>
                        }
                        else
                        {
                            <MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
                                <MudIconButton Variant="Variant.Outlined"  
                                               Disabled="true"
                                               Icon="@Icons.Material.Filled.DoNotTouch"
                                               Size="Size.Small"
                                               Color="Color.Surface">
                                    @AppStrings.NoAllowed
                                </MudIconButton>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Name" Title="@L[_chargeDto.GetMemberDescription(x=>x.Name)]"> 
   <CellTemplate>
      <div class="d-flex flex-column">
        <MudText Typo="Typo.body1">@context.Item.Name</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
     </div>
    </CellTemplate>
</PropertyColumn>
                <PropertyColumn Property="x => x.EffectiveDate" Title="@L[_chargeDto.GetMemberDescription(x=>x.EffectiveDate)]" />
                <PropertyColumn Property="x => x.TenantId" Title="@L[_chargeDto.GetMemberDescription(x=>x.TenantId)]" />

            </Columns>
            <NoRecordsContent>
                <MudText>@AppStrings.NoRecords</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>@AppStrings.Loading</MudText>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100,500,1000})" />
            </PagerContent>
</MudDataGrid>



@code {
    public string? Title { get; private set; }
    private int _defaultPageSize = 15;
    private HashSet<ChargeDto> _selectedCharges = new HashSet<ChargeDto>();
    private MudDataGrid<ChargeDto> _chargesGrid = default!;
    private ChargeDto _chargeDto = new();
    private bool _loading;
    private bool _uploading;
    private bool _exporting;
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter]
    private UserProfile? UserProfile { get; set; }


    private ChargesWithPaginationQuery _chargesQuery { get; set; } = new();
    private ChargesAccessRights _accessRights = new();

    protected override async Task OnInitializedAsync()
    {
        Title = L[_chargeDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<ChargesAccessRights>(); 
    }
     
    private async Task<GridData<ChargeDto>> ServerReload(GridState<ChargeDto> state)
    {
        try
        {
            _loading = true;
            _chargesQuery.CurrentUser = UserProfile;
            var sortDefinition = state.SortDefinitions.FirstOrDefault();
            _chargesQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
            _chargesQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
                                      ? SortDirection.Descending.ToString()
                                      : SortDirection.Ascending.ToString();
            _chargesQuery.PageNumber = state.Page + 1;
            _chargesQuery.PageSize = state.PageSize;
            var result = await Mediator.Send(_chargesQuery).ConfigureAwait(false);
            return new GridData<ChargeDto>() { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }

    }
    private async Task OnSearch(string text)
    {
        _selectedCharges.Clear();
        _chargesQuery.Keyword = text;
        await _chargesGrid.ReloadServerData();
    }
    private async Task OnListViewChanged(ChargeListView listview)
    {
        _chargesQuery.ListView = listview;
        await _chargesGrid.ReloadServerData();
    }
    private async Task OnRefresh()
    {
        ChargeCacheKey.Refresh();
        _selectedCharges.Clear();
        _chargesQuery.Keyword  = string.Empty;
        await _chargesGrid.ReloadServerData();
    }
    private Task ShowEditFormDialog(string title, AddEditChargeCommand command)
    {
        return DialogServiceHelper.ShowFormDialogAsync<ChargeFormDialog, AddEditChargeCommand>(
            title,
            new DialogParameters<ChargeFormDialog>()
			{
				{x => x._model, command }
			},
            async () =>
            {
                await _chargesGrid.ReloadServerData();
                _selectedCharges.Clear();
            });
    }
    private void OnDataGridRowClick(ChargeDto dto)
    {
        Navigation.NavigateTo($"/pages/charges/view/{dto.Id}");
    }
    private Task OnCreate()
    {
        var command = new AddEditChargeCommand();
        return ShowEditFormDialog(L["New Charge"], command);
    }
    private Task OnCloneCharge()
    {
        var dto = _selectedCharges.First();
        var command = new AddEditChargeCommand()
        {
                    Name = dto.Name, 
        EffectiveDate = dto.EffectiveDate, 
        Description = dto.Description, 
        TenantId = dto.TenantId, 

        };
        return ShowEditFormDialog(L["Clone Charge"], command);
    }
    private Task OnEditCharge(ChargeDto dto)
    {
       //var command = Mapper.Map<AddEditChargeCommand>(dto);
       //return ShowEditFormDialog(L["Edit Charge"], command);
       Navigation.NavigateTo($"/pages/charges/edit/{dto.Id}");
       return Task.CompletedTask;
    }

    private Task OnDeleteCharge(ChargeDto dto)
    {
        var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Name);
        var command = new DeleteChargeCommand(new int[] { dto.Id });
        return DeleteChargesInternal(command, contentText); 
    }

    private Task OnDeleteSelectedCharges()
    {
        var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedCharges.Count);
        var command = new DeleteChargeCommand(_selectedCharges.Select(x => x.Id).ToArray());
        return DeleteChargesInternal(command, contentText);
    }

    private Task DeleteChargesInternal(DeleteChargeCommand command, string contentText)
    {
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                await _chargesGrid.ReloadServerData();
                _selectedCharges.Clear();
            });
    }


    private async Task OnExport()
    {
        _exporting = true;
        var request = new ExportChargesQuery()
            {
                Keyword = _chargesQuery.Keyword,
                CurrentUser = UserProfile,
                ListView = _chargesQuery.ListView,
                OrderBy = _chargesGrid.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                SortDirection = (_chargesGrid.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
            };
        var result = await Mediator.Send(request);
        await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["Charges"]}.xlsx", result.Data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _exporting = false;
    }
    private async Task OnImportData(IBrowserFile file)
    {
        _uploading = true;
        var stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);
        var command = new ImportChargesCommand(file.Name, stream.ToArray());
        var result = await Mediator.Send(command);
        await result.MatchAsync(
            async data =>
            {
                await _chargesGrid.ReloadServerData();
                Snackbar.Add($"{AppStrings.ImportSuccess}", MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _uploading = false;
    }

}
