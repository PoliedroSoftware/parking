@page "/pages/gates"

@using CleanArchitecture.Blazor.Application.Features.Gates.Caching
@using CleanArchitecture.Blazor.Application.Features.Gates.DTOs
@using CleanArchitecture.Blazor.Application.Features.Gates.Specifications
@using CleanArchitecture.Blazor.Application.Features.Gates.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Gates.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.Gates.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Gates.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Gates.Commands.AddEdit
@using CleanArchitecture.Blazor.Server.UI.Pages.Gates.Components

@inject IStringLocalizer<Gates> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.Gates.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
                  FixedHeader="true"
                  FixedFooter="false"
                  Virtualize="false"
                  @bind-RowsPerPage="_defaultPageSize"
                  Loading="@_loading"
                  MultiSelection="true"
                  T="GateDto"
                  SelectOnRowClick="false"
                  RowClick="@(s=>OnDataGridRowClick(s.Item))"
                  @bind-SelectedItems="_selectedGates"
                  Hover="true" @ref="_gatesGrid">
            <ToolBarContent>
                 <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="GateListView" ValueChanged="OnListViewChanged" Value="_gatesQuery.ListView" Dense="true" Label="@L["List View"]">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="OnCreate">
                            @AppStrings.New
                        </MudButton>
                    }
                    @if (_accessRights.Delete)
                    {
                            <MudButton Disabled="@(!(_selectedGates.Count > 0))"
                                       StartIcon="@Icons.Material.Outlined.DeleteOutline"
                                         OnClick="OnDeleteSelectedGates">
                                @AppStrings.Delete
                            </MudButton>
                    }
                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">
                 
                        
                        @if (_accessRights.Export)
                        {
                            <MudMenuItem Disabled="@_exporting"
                                         OnClick="OnExport">
                                @AppStrings.Export
                            </MudMenuItem>
                        }
                        @if (_accessRights.Import)
                        {
                            <MudMenuItem>
                                <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                                    <ActivatorContent>
                                        <MudButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
                                                   Variant="Variant.Text"
                                                   Disabled="@_uploading">
                                            @AppStrings.Import
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Search)
                    {
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_gatesQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
            </ToolBarContent>
            <Columns>
                <SelectColumn ShowInFooter="false"></SelectColumn>
                <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
                    <CellTemplate>
                        @if (_accessRights.Edit || _accessRights.Delete)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
                                     Dense="true"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                                @if (_accessRights.Edit)
                                {
                                    <MudMenuItem OnClick="@(()=>OnEditGate(context.Item))">@AppStrings.Edit</MudMenuItem>
                                }
                                @if (_accessRights.Delete)
                                {
                                    <MudMenuItem OnClick="@(()=>OnDeleteGate(context.Item))">@AppStrings.Delete</MudMenuItem>
                                }
                            </MudMenu>
                        }
                        else
                        {
                            <MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
                                <MudIconButton Variant="Variant.Outlined"  
                                               Disabled="true"
                                               Icon="@Icons.Material.Filled.DoNotTouch"
                                               Size="Size.Small"
                                               Color="Color.Surface">
                                    @AppStrings.NoAllowed
                                </MudIconButton>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Name" Title="@L[_gateDto.GetMemberDescription(x=>x.Name)]"> 
   <CellTemplate>
      <div class="d-flex flex-column">
        <MudText Typo="Typo.body1">@context.Item.Name</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
     </div>
    </CellTemplate>
</PropertyColumn>
                <PropertyColumn Property="x => x.ZoneId" Title="@L[_gateDto.GetMemberDescription(x=>x.ZoneId)]" />
                <PropertyColumn Property="x => x.GateType" Title="@L[_gateDto.GetMemberDescription(x=>x.GateType)]">
                <CellTemplate>
						<MudChip T="string"  Value="@context.Item.GateType?.GetDescription()" />
                </CellTemplate>
</PropertyColumn>
                <PropertyColumn Property="x => x.LaneNo" Title="@L[_gateDto.GetMemberDescription(x=>x.LaneNo)]" />
                <PropertyColumn Property="x => x.IsUpper" Title="@L[_gateDto.GetMemberDescription(x=>x.IsUpper)]" />
                <PropertyColumn Property="x => x.IsLefthand" Title="@L[_gateDto.GetMemberDescription(x=>x.IsLefthand)]" />
                <PropertyColumn Property="x => x.IsActive" Title="@L[_gateDto.GetMemberDescription(x=>x.IsActive)]" />

            </Columns>
            <NoRecordsContent>
                <MudText>@AppStrings.NoRecords</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>@AppStrings.Loading</MudText>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100,500,1000})" />
            </PagerContent>
</MudDataGrid>



@code {
    public string? Title { get; private set; }
    private int _defaultPageSize = 15;
    private HashSet<GateDto> _selectedGates = new HashSet<GateDto>();
    private MudDataGrid<GateDto> _gatesGrid = default!;
    private GateDto _gateDto = new();
    private bool _loading;
    private bool _uploading;
    private bool _exporting;
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter]
    private UserProfile? UserProfile { get; set; }


    private GatesWithPaginationQuery _gatesQuery { get; set; } = new();
    private GatesAccessRights _accessRights = new();

    protected override async Task OnInitializedAsync()
    {
        Title = L[_gateDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<GatesAccessRights>(); 
    }
     
    private async Task<GridData<GateDto>> ServerReload(GridState<GateDto> state)
    {
        try
        {
            _loading = true;
            _gatesQuery.CurrentUser = UserProfile;
            var sortDefinition = state.SortDefinitions.FirstOrDefault();
            _gatesQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
            _gatesQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
                                      ? SortDirection.Descending.ToString()
                                      : SortDirection.Ascending.ToString();
            _gatesQuery.PageNumber = state.Page + 1;
            _gatesQuery.PageSize = state.PageSize;
            var result = await Mediator.Send(_gatesQuery).ConfigureAwait(false);
            return new GridData<GateDto>() { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }

    }
    private async Task OnSearch(string text)
    {
        _selectedGates.Clear();
        _gatesQuery.Keyword = text;
        await _gatesGrid.ReloadServerData();
    }
    private async Task OnListViewChanged(GateListView listview)
    {
        _gatesQuery.ListView = listview;
        await _gatesGrid.ReloadServerData();
    }
    private async Task OnRefresh()
    {
        GateCacheKey.Refresh();
        _selectedGates.Clear();
        _gatesQuery.Keyword  = string.Empty;
        await _gatesGrid.ReloadServerData();
    }
    private Task ShowEditFormDialog(string title, AddEditGateCommand command)
    {
        return DialogServiceHelper.ShowFormDialogAsync<GateFormDialog, AddEditGateCommand>(
            title,
            new DialogParameters<GateFormDialog>()
			{
				{x => x._model, command }
			},
            async () =>
            {
                await _gatesGrid.ReloadServerData();
                _selectedGates.Clear();
            });
    }
    private void OnDataGridRowClick(GateDto dto)
    {
        Navigation.NavigateTo($"/pages/gates/view/{dto.Id}");
    }
    private Task OnCreate()
    {
        var command = new AddEditGateCommand();
        return ShowEditFormDialog(L["New Gate"], command);
    }
     
    private Task OnEditGate(GateDto dto)
    {
       //var command = Mapper.Map<AddEditGateCommand>(dto);
       //return ShowEditFormDialog(L["Edit Gate"], command);
       Navigation.NavigateTo($"/pages/gates/edit/{dto.Id}");
       return Task.CompletedTask;
    }

    private Task OnDeleteGate(GateDto dto)
    {
        var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Name);
        var command = new DeleteGateCommand(new int[] { dto.Id });
        return DeleteGatesInternal(command, contentText); 
    }

    private Task OnDeleteSelectedGates()
    {
        var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedGates.Count);
        var command = new DeleteGateCommand(_selectedGates.Select(x => x.Id).ToArray());
        return DeleteGatesInternal(command, contentText);
    }

    private Task DeleteGatesInternal(DeleteGateCommand command, string contentText)
    {
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                await _gatesGrid.ReloadServerData();
                _selectedGates.Clear();
            });
    }


    private async Task OnExport()
    {
        _exporting = true;
        var request = new ExportGatesQuery()
            {
                Keyword = _gatesQuery.Keyword,
                CurrentUser = UserProfile,
                ListView = _gatesQuery.ListView,
                OrderBy = _gatesGrid.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                SortDirection = (_gatesGrid.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
            };
        var result = await Mediator.Send(request);
        await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["Gates"]}.xlsx", result.Data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _exporting = false;
    }
    private async Task OnImportData(IBrowserFile file)
    {
        _uploading = true;
        var stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);
        var command = new ImportGatesCommand(file.Name, stream.ToArray());
        var result = await Mediator.Send(command);
        await result.MatchAsync(
            async data =>
            {
                await _gatesGrid.ReloadServerData();
                Snackbar.Add($"{AppStrings.ImportSuccess}", MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _uploading = false;
    }

}
