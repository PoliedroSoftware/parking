@using CleanArchitecture.Blazor.Application.Features.Holidays.Commands.AddEdit

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Holidays> L

<MudDialog>
	<DialogContent>
		<MudForm Model="@_model" @ref="@_holidayForm" Validation="@(Validator.ValidateValue(_model))">
			<MudGrid>
				<MudItem xs="12">
					<MudDatePicker Label="@L[_model.GetMemberDescription(x => x.Date)]" ShowToolbar="false" @bind-Date="_model.Date" For="@(() => _model.Date)" Required="false" RequiredError="@L["date is required!"]"></MudDatePicker>
				</MudItem>
				<MudItem xs="12">
					<MudTextField Label="@L[_model.GetMemberDescription(x => x.Name_En)]" @bind-Value="_model.Name_En" For="@(() => _model.Name_En)" Required="false" RequiredError="@L["name _ en is required!"]"></MudTextField>
				</MudItem>
				<MudItem xs="12">
					<MudTextField Label="@L[_model.GetMemberDescription(x => x.Name_Tc)]" @bind-Value="_model.Name_Tc" For="@(() => _model.Name_Tc)" Required="false" RequiredError="@L["name _ tc is required!"]"></MudTextField>
				</MudItem>

			</MudGrid>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>
 
		<MudLoadingButton Color="Color.Primary" Variant="Variant.Filled" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
	</DialogActions>
</MudDialog>

@code {
	MudForm _holidayForm = new();
	private bool _saving = false;
	private bool _savingnew = false;
	[CascadingParameter]
	IMudDialogInstance MudDialog { get; set; } = default!;
	[EditorRequired][Parameter] public AddEditHolidayCommand _model { get; set; } = null!;
	async Task OnSubmit()
	{
		try
		{
			_saving = true;
			await _holidayForm.Validate().ConfigureAwait(false);
			if (!_holidayForm.IsValid)
				return;
			var result = await Mediator.Send(_model);
			result.Match(data =>
			{
				MudDialog.Close(DialogResult.Ok(true));
				Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
			}, errors =>
			{
				Snackbar.Add(errors, MudBlazor.Severity.Error);
			});
		}
		finally
		{
			_saving = false;
		}
	}
	 
	void Cancel() => MudDialog.Cancel();
}