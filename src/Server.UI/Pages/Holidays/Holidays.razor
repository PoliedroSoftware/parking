@page "/pages/holidays"

@using CleanArchitecture.Blazor.Application.Features.Holidays.Caching
@using CleanArchitecture.Blazor.Application.Features.Holidays.DTOs
@using CleanArchitecture.Blazor.Application.Features.Holidays.Specifications
@using CleanArchitecture.Blazor.Application.Features.Holidays.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Holidays.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.Holidays.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Holidays.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Holidays.Commands.AddEdit
@using CleanArchitecture.Blazor.Server.UI.Pages.Holidays.Components

@inject IStringLocalizer<Holidays> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.Holidays.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
                  FixedHeader="true"
                  FixedFooter="false"
                  Virtualize="false"
                  @bind-RowsPerPage="_defaultPageSize"
                  Loading="@_loading"
                  MultiSelection="true"
                  T="HolidayDto"
                  SelectOnRowClick="false"
                  RowClick="@(s=>OnDataGridRowClick(s.Item))"
                  @bind-SelectedItems="_selectedHolidays"
                  Hover="true" @ref="_holidaysGrid">
            <ToolBarContent>
                 <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="HolidayListView" ValueChanged="OnListViewChanged" Value="_holidaysQuery.ListView" Dense="true" Label="@L["List View"]">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="OnCreate">
                            @AppStrings.New
                        </MudButton>
                    }
                    @if (_accessRights.Delete)
                    {
                            <MudButton Disabled="@(!(_selectedHolidays.Count > 0))"
                                       StartIcon="@Icons.Material.Outlined.DeleteOutline"
                                         OnClick="OnDeleteSelectedHolidays">
                                @AppStrings.Delete
                            </MudButton>
                    }
                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">
                        @if (_accessRights.Clone)
                        {
                            <MudMenuItem Disabled="@(_selectedHolidays.Count != 1)" OnClick="OnCloneHoliday">@AppStrings.Clone</MudMenuItem>
                        }
                        
                        @if (_accessRights.Export)
                        {
                            <MudMenuItem Disabled="@_exporting"
                                         OnClick="OnExport">
                                @AppStrings.Export
                            </MudMenuItem>
                        }
                        @if (_accessRights.Import)
                        {
                            <MudMenuItem>
                                <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                                    <ActivatorContent>
                                        <MudButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
                                                   Variant="Variant.Text"
                                                   Disabled="@_uploading">
                                            @AppStrings.Import
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Search)
                    {
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_holidaysQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
            </ToolBarContent>
            <Columns>
                <SelectColumn ShowInFooter="false"></SelectColumn>
                <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
                    <CellTemplate>
                        @if (_accessRights.Edit || _accessRights.Delete)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
                                     Dense="true"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                                @if (_accessRights.Edit)
                                {
                                    <MudMenuItem OnClick="@(()=>OnEditHoliday(context.Item))">@AppStrings.Edit</MudMenuItem>
                                }
                                @if (_accessRights.Delete)
                                {
                                    <MudMenuItem OnClick="@(()=>OnDeleteHoliday(context.Item))">@AppStrings.Delete</MudMenuItem>
                                }
                            </MudMenu>
                        }
                        else
                        {
                            <MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
                                <MudIconButton Variant="Variant.Outlined"  
                                               Disabled="true"
                                               Icon="@Icons.Material.Filled.DoNotTouch"
                                               Size="Size.Small"
                                               Color="Color.Surface">
                                    @AppStrings.NoAllowed
                                </MudIconButton>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                                <PropertyColumn Property="x => x.Date" Title="@L[_holidayDto.GetMemberDescription(x=>x.Date)]" Format="d" />
                <PropertyColumn Property="x => x.Name_En" Title="@L[_holidayDto.GetMemberDescription(x=>x.Name_En)]" />
                <PropertyColumn Property="x => x.Name_Tc" Title="@L[_holidayDto.GetMemberDescription(x=>x.Name_Tc)]" />

            </Columns>
            <NoRecordsContent>
                <MudText>@AppStrings.NoRecords</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>@AppStrings.Loading</MudText>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100,500,1000})" />
            </PagerContent>
</MudDataGrid>



@code {
	public string? Title { get; private set; }
	private int _defaultPageSize = 15;
	private HashSet<HolidayDto> _selectedHolidays = new HashSet<HolidayDto>();
	private MudDataGrid<HolidayDto> _holidaysGrid = default!;
	private HolidayDto _holidayDto = new();
	private bool _loading;
	private bool _uploading;
	private bool _exporting;
	[CascadingParameter]
	private Task<AuthenticationState> AuthState { get; set; } = default!;
	[CascadingParameter]
	private UserProfile? UserProfile { get; set; }


	private HolidaysWithPaginationQuery _holidaysQuery { get; set; } = new();
	private HolidaysAccessRights _accessRights = new();

	protected override async Task OnInitializedAsync()
	{
		Title = L[_holidayDto.GetClassDescription()];
		_accessRights = await PermissionService.GetAccessRightsAsync<HolidaysAccessRights>(); 
	}

	private async Task<GridData<HolidayDto>> ServerReload(GridState<HolidayDto> state)
	{
		try
		{
			_loading = true;
			_holidaysQuery.CurrentUser = UserProfile;
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_holidaysQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
			_holidaysQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
											? SortDirection.Descending.ToString()
											: SortDirection.Ascending.ToString();
			_holidaysQuery.PageNumber = state.Page + 1;
			_holidaysQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_holidaysQuery).ConfigureAwait(false);
			return new GridData<HolidayDto>() { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}

	}
	private async Task OnSearch(string text)
	{
		_selectedHolidays.Clear();
		_holidaysQuery.Keyword = text;
		await _holidaysGrid.ReloadServerData();
	}
	private async Task OnListViewChanged(HolidayListView listview)
	{
		_holidaysQuery.ListView = listview;
		await _holidaysGrid.ReloadServerData();
	}
	private async Task OnRefresh()
	{
		HolidayCacheKey.Refresh();
		_selectedHolidays.Clear();
		_holidaysQuery.Keyword  = string.Empty;
		await _holidaysGrid.ReloadServerData();
	}
	private Task ShowEditFormDialog(string title, AddEditHolidayCommand command)
	{
		return DialogServiceHelper.ShowFormDialogAsync<HolidayFormDialog, AddEditHolidayCommand>(
			title,
			new DialogParameters<HolidayFormDialog>()
			{
				{ x=>x._model, command }
			},
			async () =>
			{
				await _holidaysGrid.ReloadServerData();
				_selectedHolidays.Clear();
			},new DialogOptions() { CloseButton=true,MaxWidth= MaxWidth.Small  });
	}
    private void OnDataGridRowClick(HolidayDto dto)
    {
        Navigation.NavigateTo($"/pages/holidays/view/{dto.Id}");
    }
    private Task OnCreate()
    {
        var command = new AddEditHolidayCommand();
        return ShowEditFormDialog(L["New Holiday"], command);
    }
    private Task OnCloneHoliday()
    {
        var dto = _selectedHolidays.First();
        var command = new AddEditHolidayCommand()
        {
                    Date = dto.Date, 
        Name_En = dto.Name_En, 
        Name_Tc = dto.Name_Tc, 

        };
        return ShowEditFormDialog(L["Clone Holiday"], command);
    }
    private Task OnEditHoliday(HolidayDto dto)
    {
       var command = Mapper.Map<AddEditHolidayCommand>(dto);
       return ShowEditFormDialog(L["Edit Holiday"], command);
       
    }

    private Task OnDeleteHoliday(HolidayDto dto)
    {
		var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Id);
        var command = new DeleteHolidayCommand(new int[] { dto.Id });
        return DeleteHolidaysInternal(command, contentText); 
    }

    private Task OnDeleteSelectedHolidays()
    {
		var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedHolidays.Count);
        var command = new DeleteHolidayCommand(_selectedHolidays.Select(x => x.Id).ToArray());
        return DeleteHolidaysInternal(command, contentText);
    }

    private Task DeleteHolidaysInternal(DeleteHolidayCommand command, string contentText)
    {
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                await _holidaysGrid.ReloadServerData();
                _selectedHolidays.Clear();
            });
    }


    private async Task OnExport()
    {
        _exporting = true;
        var request = new ExportHolidaysQuery()
            {
                Keyword = _holidaysQuery.Keyword,
                CurrentUser = UserProfile,
                ListView = _holidaysQuery.ListView,
                OrderBy = _holidaysGrid.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                SortDirection = (_holidaysGrid.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
            };
        var result = await Mediator.Send(request);
        await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["Holidays"]}.xlsx", result.Data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _exporting = false;
    }
    private async Task OnImportData(IBrowserFile file)
    {
        _uploading = true;
        var stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);
        var command = new ImportHolidaysCommand(file.Name, stream.ToArray());
        var result = await Mediator.Send(command);
        await result.MatchAsync(
            async data =>
            {
                await _holidaysGrid.ReloadServerData();
                Snackbar.Add($"{AppStrings.ImportSuccess}", MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _uploading = false;
    }

}
