@page "/pages/memberrentals/create"
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Members.DTOs
@using CleanArchitecture.Blazor.Domain.Constants
@using CleanArchitecture.Blazor.Domain.Entities

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<MemberRentals> L
@inject IApplicationDbContextFactory DbFactory
@attribute [Authorize(Policy = Permissions.MemberRentals.Create)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                 <MudText Typo="Typo.h6">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudForm Model="@_model" @ref="@_memberrentalForm" Validation="@(Validator.ValidateValue(_model))">
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MemberAutocomplete T="MemberDto" Label="Miembro" Value="_model.Member" ValueChanged="OnMemberChanged" For="@(() => _model.Member)" Required="true" RequiredError="El miembro es requerido"></MemberAutocomplete>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Placa" @bind-Value="_model.LicensePlate" For="@(() => _model.LicensePlate)" ReadOnly></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Tarjeta ID" @bind-Value="_model.CardId" For="@(() => _model.CardId)" ReadOnly></MudTextField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudDatePicker ShowToolbar="false" Label="Fecha Inicio" @bind-Date="_model.StartDate" For="@(() => _model.StartDate)" Required="true" RequiredError="La fecha de inicio es requerida"></MudDatePicker>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudDatePicker ShowToolbar="false" Label="Fecha Vencimiento" @bind-Date="_model.ExpiryDate" For="@(() => _model.ExpiryDate)" Required="true" RequiredError="La fecha de vencimiento es requerida"></MudDatePicker>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="int?" Label="Tarifa mensual" Value="_selectedMonthlyRateId" ValueChanged="OnMonthlyRateSelected" Clearable="true">
                            @foreach (var rate in _monthlyRates)
                            {
                                <MudSelectItem T="int?" Value="@((int?)rate.Id)">
                                    @rate.Name - @rate.VehicleType.GetDescription() ($ @rate.MonthlyFee.ToString("N0"))
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField Label="Cuota Mensual" @bind-Value="_model.RentalFee" For="@(() => _model.RentalFee)" Min="0.00m" Required="true" RequiredError="La cuota es requerida"></MudNumericField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField Label="Deposito" @bind-Value="_model.Deposit" For="@(() => _model.Deposit)" Min="0.00m"></MudNumericField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField Label="Saldo Pendiente" @bind-Value="_model.AmountDue" For="@(() => _model.AmountDue)" Min="0.00m"></MudNumericField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudNumericField Label="Monto Pagado" @bind-Value="_model.AmountPaid" For="@(() => _model.AmountPaid)" Min="0.00m"></MudNumericField>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudDatePicker ShowToolbar="false" Label="Fecha de Pago" @bind-Date="_model.PaymentTime" For="@(() => _model.PaymentTime)"></MudDatePicker>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudEnumSelect TEnum="Nullable<PaymentMethods>" Label="Metodo de Pago" @bind-Value="_model.PaymentMethodId" For="@(() => _model.PaymentMethodId)"></MudEnumSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField Label="Notas" @bind-Value="_model.Notes" For="@(() => _model.Notes)" Lines="2"></MudTextField>
                    </MudItem>
                </MudGrid>
            </MudForm>
        </MudCardContent>
         <MudCardActions Class="d-flex justify-end gap-2">
                    <MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
         </MudCardActions>
    </MudCard>
</MudContainer>


@code {
    public string? Title { get; private set; }
    MudForm _memberrentalForm = new();
    private bool _saving = false;
    private List<BreadcrumbItem>? _breadcrumbItems;
    private AddEditMemberRentalCommand _model = new();
    private List<MonthlyRate> _monthlyRates = new();
    private int? _selectedMonthlyRateId;

    protected override async Task OnInitializedAsync()
    {
        Title = "Nueva Mensualidad";
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Inicio", href: "/"),
            new BreadcrumbItem("Mensualidades", href: "/pages/memberrentals"),
            new BreadcrumbItem("Nueva Mensualidad", href:null, disabled:true)
        };
        await LoadMonthlyRates();
    }

    private async Task LoadMonthlyRates()
    {
        await using var db = await DbFactory.CreateAsync();
        _monthlyRates = await db.MonthlyRates
            .AsNoTracking()
            .Where(x => x.IsActive &&
                        (x.Description == null || !x.Description.StartsWith(MonthlyRateDefaults.BaseMarker)))
            .OrderBy(x => x.VehicleType)
            .ThenBy(x => x.Name)
            .ToListAsync();
    }

    void OnMemberChanged(MemberDto? member)
    {
        _model.Member = member;
        _model.CardId = member?.CardId;
        _model.LicensePlate = member?.LicensePlate;
    }

    private Task OnMonthlyRateSelected(int? monthlyRateId)
    {
        _selectedMonthlyRateId = monthlyRateId;
        var rate = _monthlyRates.FirstOrDefault(x => x.Id == monthlyRateId);
        if (rate is null)
            return Task.CompletedTask;

        _model.RentalFee = rate.MonthlyFee;
        _model.Deposit = rate.Deposit;
        _model.AmountDue = rate.MonthlyFee + rate.Deposit;

        return Task.CompletedTask;
    }

    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _memberrentalForm.Validate().ConfigureAwait(false);
            if (!_memberrentalForm.IsValid)
                return;
            var result = await Mediator.Send(_model);
            result.Match(
                data=>
                {
                    Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                    Navigation.NavigateTo("/pages/memberrentals");
                },
                errors=>
                {
                    Snackbar.Add(errors, MudBlazor.Severity.Error);
                });
        }
        finally
        {
            _saving = false;
        }
    }
}
