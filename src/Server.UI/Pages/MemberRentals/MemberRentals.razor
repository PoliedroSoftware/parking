@page "/pages/memberrentals"

@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Caching
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.DTOs
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Specifications
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.MemberRentals.Commands.AddEdit
@using CleanArchitecture.Blazor.Server.UI.Pages.MemberRentals.Components

@inject IStringLocalizer<MemberRentals> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.MemberRentals.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
			 FixedHeader="true"
			 FixedFooter="false"
			 Virtualize="false"
			 @bind-RowsPerPage="_defaultPageSize"
			 Loading="@_loading"
			 MultiSelection="true"
			 T="MemberRentalDto"
			 SelectOnRowClick="false"
			 RowClick="@(s=>OnDataGridRowClick(s.Item))"
			 @bind-SelectedItems="_selectedMemberRentals"
			 Hover="true" @ref="_memberrentalsGrid">
	<ToolBarContent>
		<MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
			<MudStack Row AlignItems="AlignItems.Start">
				<MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
				<MudStack Spacing="0">
					<MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
					<MudEnumSelect Style="min-width:120px" TEnum="MemberRentalListView" ValueChanged="OnListViewChanged" Value="_memberrentalsQuery.ListView" Dense="true" Label="@L["List View"]">
					</MudEnumSelect>
				</MudStack>
			</MudStack>
			<MudStack Spacing="0" AlignItems="AlignItems.End">
				<MudToolBar Dense WrapContent="true" Class="py-1 px-0">
					<MudButton Disabled="@_loading"
							   OnClick="@(() => OnRefresh())"
							   StartIcon="@Icons.Material.Outlined.Refresh">
						@AppStrings.Refresh
					</MudButton>

					@if (_accessRights.Export)
					{
						<MudButton Disabled="@_exporting"
								   OnClick="OnExport">
							@AppStrings.Export
						</MudButton>
					}

				</MudToolBar>
				<MudStack Row Spacing="1">
					@if (_accessRights.Search)
					{
						<MudTextField T="string" ValueChanged="@(s => OnLicenseSearch(s))" Value="@_memberrentalsQuery.LicensePlate" Placeholder="@L["Search by license plate"]" Adornment="Adornment.End"
									  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
						</MudTextField>
						<MudTextField T="string" ValueChanged="@(s => OnCardIdSearch(s))" Value="@_memberrentalsQuery.CardId" Placeholder="@L["Search by card id"]" Adornment="Adornment.End"
									  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
						</MudTextField>
						<MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_memberrentalsQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
									  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
						</MudTextField>
					}
				</MudStack>
			</MudStack>
		</MudStack>
	</ToolBarContent>
	<Columns>
		<SelectColumn ShowInFooter="false"></SelectColumn>

		<PropertyColumn Property="x => x.MemberId" Title="@L[_memberrentalDto.GetMemberDescription(x => x.Member)]">
			<CellTemplate>
				<MudText>@context.Item.Member?.Name</MudText>
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.LicensePlate" Title="@L[_memberrentalDto.GetMemberDescription(x => x.LicensePlate)]" />
		<PropertyColumn Property="x => x.CardId" Title="@L[_memberrentalDto.GetMemberDescription(x => x.CardId)]" />
		<PropertyColumn Property="x => x.StartDate" Title="@L[_memberrentalDto.GetMemberDescription(x => x.StartDate)]" Format="d" />
		<PropertyColumn Property="x => x.ExpiryDate" Title="@L[_memberrentalDto.GetMemberDescription(x => x.ExpiryDate)]" Format="d" />
		<PropertyColumn Property="x => x.RentalFee" Title="@L[_memberrentalDto.GetMemberDescription(x => x.RentalFee)]" />
		<PropertyColumn Property="x => x.Deposit" Title="@L[_memberrentalDto.GetMemberDescription(x => x.Deposit)]" />
		<PropertyColumn Property="x => x.AmountDue" Title="@L[_memberrentalDto.GetMemberDescription(x => x.AmountDue)]" />
		<PropertyColumn Property="x => x.AmountPaid" Title="@L[_memberrentalDto.GetMemberDescription(x => x.AmountPaid)]" />
		<PropertyColumn Property="x => x.PaymentTime" Title="@L[_memberrentalDto.GetMemberDescription(x => x.PaymentTime)]" />
		<PropertyColumn Property="x => x.PaymentMethodId" Title="@L[_memberrentalDto.GetMemberDescription(x => x.PaymentMethodId)]">
			<CellTemplate>
				<MudChip T="string" Value="@context.Item.PaymentMethodId?.GetDescription()" />
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.Notes" Title="@L[_memberrentalDto.GetMemberDescription(x => x.Notes)]" />

	</Columns>
	<NoRecordsContent>
		<MudText>@AppStrings.NoRecords</MudText>
	</NoRecordsContent>
	<LoadingContent>
		<MudText>@AppStrings.Loading</MudText>
	</LoadingContent>
	<PagerContent>
		<MudDataGridPager PageSizeOptions="@(new int[] { 10, 15, 30, 50, 100, 500, 1000 })" />
	</PagerContent>
</MudDataGrid>



@code {
	public string? Title { get; private set; }
	private int _defaultPageSize = 15;
	private HashSet<MemberRentalDto> _selectedMemberRentals = new HashSet<MemberRentalDto>();
	private MudDataGrid<MemberRentalDto> _memberrentalsGrid = default!;
	private MemberRentalDto _memberrentalDto = new();
	private bool _loading;
	private bool _uploading;
	private bool _exporting;
	[CascadingParameter]
	private Task<AuthenticationState> AuthState { get; set; } = default!;
	[CascadingParameter]
	private UserProfile? UserProfile { get; set; }


	private MemberRentalsWithPaginationQuery _memberrentalsQuery { get; set; } = new();
	private MemberRentalsAccessRights _accessRights = new();

	protected override async Task OnInitializedAsync()
	{
		Title = L[_memberrentalDto.GetClassDescription()];
		_accessRights = await PermissionService.GetAccessRightsAsync<MemberRentalsAccessRights>();
	}

	private async Task<GridData<MemberRentalDto>> ServerReload(GridState<MemberRentalDto> state)
	{
		try
		{
			_loading = true;
			_memberrentalsQuery.CurrentUser = UserProfile;
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_memberrentalsQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
			_memberrentalsQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
									  ? SortDirection.Descending.ToString()
									  : SortDirection.Ascending.ToString();
			_memberrentalsQuery.PageNumber = state.Page + 1;
			_memberrentalsQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_memberrentalsQuery).ConfigureAwait(false);
			return new GridData<MemberRentalDto>() { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}

	}
	private async Task OnLicenseSearch(string text)
	{
		_selectedMemberRentals.Clear();
		_memberrentalsQuery.LicensePlate = text;
		await _memberrentalsGrid.ReloadServerData();
	}
	private async Task OnCardIdSearch(string text)
	{
		_selectedMemberRentals.Clear();
		_memberrentalsQuery.CardId = text;
		await _memberrentalsGrid.ReloadServerData();
	}
	private async Task OnSearch(string text)
	{
		_selectedMemberRentals.Clear();
		_memberrentalsQuery.Keyword = text;
		await _memberrentalsGrid.ReloadServerData();
	}
	private async Task OnListViewChanged(MemberRentalListView listview)
	{
		_memberrentalsQuery.ListView = listview;
		await _memberrentalsGrid.ReloadServerData();
	}
	private async Task OnRefresh()
	{
		MemberRentalCacheKey.Refresh();
		_selectedMemberRentals.Clear();
		_memberrentalsQuery.Keyword = string.Empty;
		await _memberrentalsGrid.ReloadServerData();
	}
	private Task ShowEditFormDialog(string title, AddEditMemberRentalCommand command)
	{
		return DialogServiceHelper.ShowFormDialogAsync<MemberRentalFormDialog, AddEditMemberRentalCommand>(
			title,
			new DialogParameters<MemberRentalFormDialog>()
			{
				{x => x._model, command }
			},
			async () =>
			{
				await _memberrentalsGrid.ReloadServerData();
				_selectedMemberRentals.Clear();
			});
	}
	private void OnDataGridRowClick(MemberRentalDto dto)
	{
		//Navigation.NavigateTo($"/pages/memberrentals/view/{dto.Id}");
	}
	private Task OnCreate()
	{
		var command = new AddEditMemberRentalCommand();
		return ShowEditFormDialog(L["New MemberRental"], command);
	}

	private Task OnEditMemberRental(MemberRentalDto dto)
	{
		var command = Mapper.Map<AddEditMemberRentalCommand>(dto);
		return ShowEditFormDialog(L["Edit MemberRental"], command);
		// Navigation.NavigateTo($"/pages/memberrentals/edit/{dto.Id}");
		// return Task.CompletedTask;
	}

	private Task OnDeleteMemberRental(MemberRentalDto dto)
	{
		var contentText = string.Format(AppStrings.DeleteConfirmation, dto.CardId);
		var command = new DeleteMemberRentalCommand(new int[] { dto.Id });
		return DeleteMemberRentalsInternal(command, contentText);
	}

	private Task OnDeleteSelectedMemberRentals()
	{
		var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedMemberRentals.Count);
		var command = new DeleteMemberRentalCommand(_selectedMemberRentals.Select(x => x.Id).ToArray());
		return DeleteMemberRentalsInternal(command, contentText);
	}

	private Task DeleteMemberRentalsInternal(DeleteMemberRentalCommand command, string contentText)
	{
		return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
			command,
			AppStrings.DeleteConfirmationTitle,
			contentText,
			async () =>
			{
				await _memberrentalsGrid.ReloadServerData();
				_selectedMemberRentals.Clear();
			});
	}


	private async Task OnExport()
	{
		_exporting = true;
		var request = new ExportMemberRentalsQuery()
		{
			Keyword = _memberrentalsQuery.Keyword,
			CurrentUser = UserProfile,
			ListView = _memberrentalsQuery.ListView,
			OrderBy = _memberrentalsGrid.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
			SortDirection = (_memberrentalsGrid.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
		};
		var result = await Mediator.Send(request);
		await result.MatchAsync(
			async data =>
			{
				if (result.Data != null)
				{
					await BlazorDownloadFileService.DownloadFileAsync($"{L["remberrentalreport"]}.xlsx", result.Data, contentType: "application/octet-stream");
					Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
				}
				else
				{
					Snackbar.Add("导出失败", MudBlazor.Severity.Error);
				}
			},
			errors =>
			{
				Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
				return Task.CompletedTask;
			});
		_exporting = false;
	}

}
