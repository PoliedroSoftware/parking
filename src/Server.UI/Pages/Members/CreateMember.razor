@page "/pages/members/create"
@using CleanArchitecture.Blazor.Application.Features.Members.Commands.Create
@using CleanArchitecture.Blazor.Application.Features.Members.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Server.UI.Pages.Members.Components
@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Members> L
@attribute [Authorize(Policy = Permissions.Members.Create)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
	<MudCard Class="pa-2">
		<MudCardHeader>
			<CardHeaderContent>
				<MudText Typo="Typo.h6">@Title</MudText>
			</CardHeaderContent>
		</MudCardHeader>
		<MudCardContent>
			<MudForm Model="@_model" @ref="@_memberForm" Validation="@(Validator.ValidateValue(_model))">
				<MudGrid Spacing="2">
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.LicensePlate)]" @bind-Value="_model.LicensePlate" For="@(() => _model.LicensePlate)" Required="true" RequiredError="@L["license plate is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.CardId)]" @bind-Value="_model.CardId" For="@(() => _model.CardId)" Required="true" RequiredError="@L["card id is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudCheckBox Label="@L[_model.GetMemberDescription(x => x.IsActive)]" @bind-Value="_model.IsActive" For="@(() => _model.IsActive)" Color="Color.Primary"></MudCheckBox>
					</MudItem>

					<MudItem xs="12" md="4">
						<MudDatePicker ShowToolbar="false" Label="@L[_model.GetMemberDescription(x => x.StartDate)]" @bind-Date="_model.StartDate" For="@(() => _model.StartDate)" Required="true" RequiredError="@L["start date is required!"]"></MudDatePicker>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudDatePicker ShowToolbar="false" Label="@L[_model.GetMemberDescription(x => x.ExpiryDate)]" @bind-Date="_model.ExpiryDate" For="@(() => _model.ExpiryDate)" Required="false" RequiredError="@L["expiry date is required!"]"></MudDatePicker>
					</MudItem>
					<MudItem xs="12" md="4">

					</MudItem>
					<MudItem xs="12" md="4">
						<SpaceGroupAutocomplete T="SpaceGroupDto" Label="@L[_model.GetMemberDescription(x => x.SpaceGroup)]" @bind-Value="_model.SpaceGroup" For="@(() => _model.SpaceGroup)"  Required="true" RequiredError="@L["space group id is required!"]"></SpaceGroupAutocomplete>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L["Space Group Capacity"]" Value="_model.SpaceGroup?.Capacity" ReadOnly></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L["Space Group Description"]" Value="_model.SpaceGroup?.Description" ReadOnly></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudEnumSelect TEnum="Nullable<SpaceTypes>" Label="@L[_model.GetMemberDescription(x => x.SpaceType)]" @bind-Value="_model.SpaceType" For="@(() => _model.SpaceType)" Required="false" RequiredError="@L["space type is required!"]"></MudEnumSelect>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.SpaceNo)]" @bind-Value="_model.SpaceNo" For="@(() => _model.SpaceNo)" Required="true" RequiredError="@L["space no is required!"]"></MudTextField>
					</MudItem>

					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.Name)]" @bind-Value="_model.Name" For="@(() => _model.Name)" Required="true" RequiredError="@L["name is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.PhoneNumber)]" @bind-Value="_model.PhoneNumber" For="@(() => _model.PhoneNumber)" Required="true" RequiredError="@L["phone number is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.MobileNumber)]" @bind-Value="_model.MobileNumber" For="@(() => _model.MobileNumber)" Required="true" RequiredError="@L["mobile number is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.Email)]" @bind-Value="_model.Email" For="@(() => _model.Email)" Required="true" RequiredError="@L["email is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.Address)]" @bind-Value="_model.Address" For="@(() => _model.Address)" Required="true" RequiredError="@L["address is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12" md="4">
						<MudTextField Label="@L[_model.GetMemberDescription(x => x.Notes)]" @bind-Value="_model.Notes" For="@(() => _model.Notes)" Required="false" RequiredError="@L["notes is required!"]"></MudTextField>
					</MudItem>
					<MudItem xs="12">
						<MudStack Row Spacing="2" AlignItems="AlignItems.Center">
							<MudText Typo="Typo.subtitle2" Class="mt-2">@L["Vehicles"]</MudText>
							<MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddMemberVehicle">@L["Add"]</MudButton>
						</MudStack>
						@if(_model.MemberVehicles != null && _model.MemberVehicles.Any())
						{
							<MudTable Items="@_model.MemberVehicles" Breakpoint="Breakpoint.Sm" Dense>
								<HeaderContent>
									<MudTh>@L["Name"]</MudTh>
									<MudTh>@L["Service Categories"]</MudTh>
									<MudTh>@L["Vehicle Types"]</MudTh>
									<MudTh>@L["Zone"]</MudTh>
									<MudTh>@L["Charge"]</MudTh>
									<MudTh>@L["Capacity"]</MudTh>
									<MudTh>@L["IsActive"]</MudTh>
									<MudTh></MudTh>
								</HeaderContent>
								<RowTemplate>
									<MudTd>@context.Name</MudTd>
									<MudTd>@context.ServiceCategoryId?.GetDescription()</MudTd>
									<MudTd>@context.VehicleTypeId?.GetDescription()</MudTd>
									<MudTd>@($"{context.Zone?.Name.Code} - {context.Zone?.Name.Tc}")" </MudTd>
									<MudTd>@($"{context.Charge?.Name} - {context.Charge?.Description}")"</MudTd>
									<MudTd>@context.Capacity</MudTd>
									<MudTd>@(context.IsActive ? L["Yes"] : L["No"])</MudTd>
									<MudTd DataLabel="Molar">
										<MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => _model.MemberVehicles.Remove(context))"> @L["Delete"]</MudIconButton></MudTd>
								</RowTemplate>
							</MudTable>
						}
					</MudItem>
					<MudItem xs="12">
						<MudStack Row Spacing="2" AlignItems="AlignItems.Center">
							<MudText Typo="Typo.subtitle2" Class="mt-2">@L["Rental"]</MudText>
							<MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddMemberRental">@L["Add"]</MudButton>
						</MudStack>
						@if (_model.MemberRentals != null && _model.MemberRentals.Any())
						{
							<MudTable Items="@_model.MemberRentals" Breakpoint="Breakpoint.Sm" Dense>
								<HeaderContent>
									<MudTh>@L["Start Date"]</MudTh>
									<MudTh>@L["Expiry Date"]</MudTh>
									<MudTh>@L["Rental Fee"]</MudTh>
									<MudTh>@L["Deposit"]</MudTh>
									<MudTh>@L["Amount Due"]</MudTh>
									<MudTh>@L["Amount Paid"]</MudTh>
									<MudTh>@L["Payment Time"]</MudTh>
									<MudTh>@L["Payment Methods"]</MudTh>
									<MudTh>@L["Notes"]</MudTh>
									<MudTh></MudTh>
								</HeaderContent>
								<RowTemplate>
									<MudTd>@context.StartDate?.ToString("d")</MudTd>
									<MudTd>@context.ExpiryDate?.ToString("d")</MudTd>
									<MudTd>@context.RentalFee</MudTd>
									<MudTd>@context.Deposit</MudTd>
									<MudTd>@context.AmountDue</MudTd>
									<MudTd>@context.AmountPaid</MudTd>
									<MudTd>@context.PaymentTime</MudTd>
									<MudTd>@context.PaymentMethodId</MudTd>
									<MudTd>@context.Notes</MudTd>
									<MudTd DataLabel="Molar">
										<MudIconButton Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditMemberRental(context))"> @L["Edit"]</MudIconButton>
										<MudIconButton Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => _model.MemberRentals.Remove(context))"> @L["Delete"]</MudIconButton></MudTd>
								</RowTemplate>
							</MudTable>
						}
					</MudItem>

				</MudGrid>
			</MudForm>
		</MudCardContent>
		<MudCardActions Class="d-flex justify-end gap-2">
			<MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
		</MudCardActions>
	</MudCard>
</MudContainer>


@code {
	[CascadingParameter]
	private UserProfile? UserProfile { get; set; }
	public string? Title { get; private set; }
	MudForm _memberForm = new();
	private bool _saving = false;
	private List<BreadcrumbItem>? _breadcrumbItems;
	private CreateMemberCommand _model = new() { MemberRentals=new List<MemberRentalDto>() { },MemberVehicles=new List<VehicleDto>() };
	protected override Task OnInitializedAsync()
	{
		Title = L["New Member"];
		_breadcrumbItems = new List<BreadcrumbItem>
		{
			new BreadcrumbItem(L["Home"], href: "/"),
			new BreadcrumbItem(L["Members"], href: "/pages/members"),
			new BreadcrumbItem(L["Create Member"], href:null, disabled:true)
		};
		return Task.CompletedTask;
	}
	async Task AddMemberVehicle()
	{
		await _memberForm.Validate();
		if (!_memberForm.IsValid) return;

		var parameters = new DialogParameters<SelectVehiclesDialog>(){
			{  x=>x.UserProfile, UserProfile }
			};
		var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = await DialogService.ShowAsync<SelectVehiclesDialog>(L["Select Vehicles"], parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			var list = (HashSet<VehicleDto>)result.Data!;
			foreach(var item in list)
			{
				if (!_model.MemberVehicles!.Any(x => x.Id == item.Id))
				{
					_model.MemberVehicles!.Add(item);
				}
			}
			await InvokeAsync(StateHasChanged);
		}
	}
	async Task AddMemberRental()
	{
		await _memberForm.Validate();
		if (!_memberForm.IsValid) return;
		if (_model.MemberRentals == null)
		{
			_model.MemberRentals = new List<MemberRentalDto>();
		}
		var item = new MemberRentalDto
			{
				StartDate = DateTime.Today,
				ExpiryDate = DateTime.Today.AddYears(1),
				RentalFee = 0,
				Deposit = 0,
				AmountDue = 0,
				AmountPaid = 0,
				PaymentTime = DateTime.Now,
				PaymentMethodId = PaymentMethods.None,
				Notes = string.Empty
			};
		var parameters = new DialogParameters<MemberRentalDialog>(){
			{  x=>x.MemberRental, item }
			};
		var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
		var dialog = await DialogService.ShowAsync<MemberRentalDialog>(L["Edit Member Rental"], parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			_model.MemberRentals.Add((MemberRentalDto)result.Data!);
			await InvokeAsync(StateHasChanged);
		}
	}
	async Task EditMemberRental(MemberRentalDto rental)
	{
		await _memberForm.Validate();
		if (!_memberForm.IsValid) return;
		var parameters = new DialogParameters<MemberRentalDialog>(){
			{  x=>x.MemberRental, rental }
			};
		var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true};
		var dialog = await DialogService.ShowAsync<MemberRentalDialog>(L["Edit Member Rental"], parameters, options);
		var result = await dialog.Result;
		if (!result.Canceled)
		{
			await InvokeAsync(StateHasChanged);
		}
	}
	async Task OnSubmit()
	{
		try
		{
			_saving = true;
			await _memberForm.Validate().ConfigureAwait(false);
			if (!_memberForm.IsValid)
				return;
			var result = await Mediator.Send(_model);
			result.Match(
				data =>
				{
					Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
					Navigation.NavigateTo($"/pages/Members");
				},
				errors =>
				{
					Snackbar.Add(errors, MudBlazor.Severity.Error);
				});
		}
		finally
		{
			_saving = false;
		}
	}
}