@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Services
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.Services

@inherits MudComponentBase
@inject IValidationService Validator
@inject ICarparkService CarparkService
@inject IZoneService ZoneService
<MudDialog>
    <DialogContent>
        <MudForm Model="@_model">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="CarparkDto" Label="Parqueadero" Value="_carpark" ValueChanged="OnCarparkChanged"
                               ToStringFunc="@(x => x?.Name.Code ?? "")">
                        @foreach (var c in CarparkService.DataSource)
                        {
                            <MudSelectItem T="CarparkDto" Value="c">@c.Name.Code</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudSelect T="ZoneDto" Label="Zona" @bind-Value="_model.Zone" ToStringFunc="@(x => x?.Name.Code ?? "")">
                        @foreach (var z in ZoneService.DataSource.Where(x => x.CarparkId == _carpark?.Id))
                        {
                            <MudSelectItem T="ZoneDto" Value="z">@z.Name.Code</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nombre Grupo" @bind-Value="_model.Name" Required="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField Label="Capacidad" @bind-Value="_model.Capacity" Min="0"></MudNumericField>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Descripcion" @bind-Value="_model.Description"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudLoadingButton Loading="@_saving" OnClick="OnSubmit" Color="Color.Primary" Variant="Variant.Filled">Guardar</MudLoadingButton>
    </DialogActions>
</MudDialog>

@code {
    MudForm _spacegroupForm = new();
    private bool _saving;
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CarparkDto? _carpark { get; set; }
    [EditorRequired] [Parameter] public AddEditSpaceGroupCommand _model { get; set; } = null!;

    void OnCarparkChanged(CarparkDto? c) { _carpark = c; _model.Zone = null; }

    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            var result = await Mediator.Send(_model);
            result.Match(data => { MudDialog.Close(DialogResult.Ok(true)); Snackbar.Add("Grupo guardado", Severity.Success); },
                          errors => Snackbar.Add(errors, Severity.Error));
        }
        finally { _saving = false; }
    }

    void Cancel() => MudDialog.Cancel();
}
