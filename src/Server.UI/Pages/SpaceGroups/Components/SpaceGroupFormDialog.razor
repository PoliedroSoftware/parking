@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Services
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.Services

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<SpaceGroups> L
@inject ICarparkService CarparkService
@inject IZoneService ZoneService
<MudDialog>
	<DialogContent>
		<MudForm Model="@_model" @ref="@_spacegroupForm" Validation="@(Validator.ValidateValue(_model))">
			<MudGrid>
				<MudItem xs="12">
					<MudSelect T="CarparkDto" Label="@L["Select carpark"]" Value="_carpark" ValueChanged="OnCarparkChanged" ToStringFunc="@(x => $"{x?.Name.Code} - {x?.Name.Tc}")">

						@foreach (var carpark in CarparkService.DataSource)
						{
							<MudSelectItem T="CarparkDto" Value="carpark">@($"{carpark.Name.Code} - {carpark.Name.Tc}") </MudSelectItem>
						}
					</MudSelect>
				</MudItem>
				<MudItem xs="12">
					<MudSelect T="ZoneDto" Label="@L["Zone"]" @bind-Value="_model.Zone" ToStringFunc="@(x => $"{x?.Name.Code} - {x?.Name.Tc}")">

						@foreach (var zone in ZoneService.DataSource.Where(x => x.CarparkId == _carpark?.Id))
						{
							<MudSelectItem T="ZoneDto" Value="zone">@($"{zone.Name.Code} - {zone.Name.Tc}") </MudSelectItem>
						}
					</MudSelect>
				</MudItem>
				<MudItem xs="12">
					<MudTextField Label="@L[_model.GetMemberDescription(x => x.Name)]" @bind-Value="_model.Name" For="@(() => _model.Name)" Required="true" RequiredError="@L["name is required!"]"></MudTextField>
				</MudItem>
				<MudItem xs="12">
					<MudNumericField Label="@L[_model.GetMemberDescription(x => x.Capacity)]" @bind-Value="_model.Capacity" For="@(() => _model.Capacity)" Min="0" Required="false" RequiredError="@L["capacity is required!"]"></MudNumericField>
				</MudItem>

				<MudItem xs="12">
					<MudTextField Label="@L[_model.GetMemberDescription(x => x.Description)]" For="@(() => _model.Description)" @bind-Value="_model.Description"></MudTextField>
				</MudItem>

			</MudGrid>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>

		<MudLoadingButton Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
	</DialogActions>
</MudDialog>

@code {
	MudForm _spacegroupForm = new();
	private bool _saving = false;
	private bool _savingnew = false;
	[CascadingParameter]
	IMudDialogInstance MudDialog { get; set; } = default!;
	[Parameter]
	public CarparkDto? _carpark { get; set; }
	[EditorRequired][Parameter] public AddEditSpaceGroupCommand _model { get; set; } = null!;
	void OnCarparkChanged(CarparkDto? carpark)
	{
		_carpark = carpark;
		_model.Zone = null;
	}
	async Task OnSubmit()
	{
		try
		{
			_saving = true;
			await _spacegroupForm.Validate().ConfigureAwait(false);
			if (!_spacegroupForm.IsValid)
				return;
			var result = await Mediator.Send(_model);
			result.Match(data =>
			{
				MudDialog.Close(DialogResult.Ok(true));
				Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
			}, errors =>
			{
				Snackbar.Add(errors, MudBlazor.Severity.Error);
			});
		}
		finally
		{
			_saving = false;
		}
	}

	void Cancel() => MudDialog.Cancel();
}