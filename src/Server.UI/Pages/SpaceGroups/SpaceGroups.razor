@page "/pages/spacegroups"

@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Caching
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.DTOs
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Specifications
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.SpaceGroups.Commands.AddEdit
@using CleanArchitecture.Blazor.Server.UI.Pages.SpaceGroups.Components

@inject IStringLocalizer<SpaceGroups> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.SpaceGroups.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
                  FixedHeader="true"
                  FixedFooter="false"
                  Virtualize="false"
                  @bind-RowsPerPage="_defaultPageSize"
                  Loading="@_loading"
                  MultiSelection="true"
                  T="SpaceGroupDto"
                  SelectOnRowClick="false"
                  RowClick="@(s=>OnDataGridRowClick(s.Item))"
                  @bind-SelectedItems="_selectedSpaceGroups"
                  Hover="true" @ref="_spacegroupsGrid">
            <ToolBarContent>
                 <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="SpaceGroupListView" ValueChanged="OnListViewChanged" Value="_spacegroupsQuery.ListView" Dense="true" Label="@L["List View"]">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="OnCreate">
                            @AppStrings.New
                        </MudButton>
                    }
                    @if (_accessRights.Delete)
                    {
                            <MudButton Disabled="@(!(_selectedSpaceGroups.Count > 0))"
                                       StartIcon="@Icons.Material.Outlined.DeleteOutline"
                                         OnClick="OnDeleteSelectedSpaceGroups">
                                @AppStrings.Delete
                            </MudButton>
                    }
                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">
                        @if (_accessRights.Clone)
                        {
                            <MudMenuItem Disabled="@(_selectedSpaceGroups.Count != 1)" OnClick="OnCloneSpaceGroup">@AppStrings.Clone</MudMenuItem>
                        }
                        
                        @if (_accessRights.Export)
                        {
                            <MudMenuItem Disabled="@_exporting"
                                         OnClick="OnExport">
                                @AppStrings.Export
                            </MudMenuItem>
                        }
                        @if (_accessRights.Import)
                        {
                            <MudMenuItem>
                                <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                                    <ActivatorContent>
                                        <MudButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
                                                   Variant="Variant.Text"
                                                   Disabled="@_uploading">
                                            @AppStrings.Import
                                        </MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">
                    @if (_accessRights.Search)
                    {
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_spacegroupsQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    }
                </MudStack>
            </MudStack>
        </MudStack>
            </ToolBarContent>
            <Columns>
                <SelectColumn ShowInFooter="false"></SelectColumn>
                <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
                    <CellTemplate>
                        @if (_accessRights.Edit || _accessRights.Delete)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
                                     Dense="true"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                                @if (_accessRights.Edit)
                                {
                                    <MudMenuItem OnClick="@(()=>OnEditSpaceGroup(context.Item))">@AppStrings.Edit</MudMenuItem>
                                }
                                @if (_accessRights.Delete)
                                {
                                    <MudMenuItem OnClick="@(()=>OnDeleteSpaceGroup(context.Item))">@AppStrings.Delete</MudMenuItem>
                                }
                            </MudMenu>
                        }
                        else
                        {
                            <MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
                                <MudIconButton Variant="Variant.Outlined"  
                                               Disabled="true"
                                               Icon="@Icons.Material.Filled.DoNotTouch"
                                               Size="Size.Small"
                                               Color="Color.Surface">
                                    @AppStrings.NoAllowed
                                </MudIconButton>
                            </MudTooltip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Name" Title="@L[_spacegroupDto.GetMemberDescription(x=>x.Name)]"> 
   <CellTemplate>
      <div class="d-flex flex-column">
        <MudText Typo="Typo.body1">@context.Item.Name</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.Description</MudText>
     </div>
    </CellTemplate>
</PropertyColumn>
                <PropertyColumn Property="x => x.Capacity" Title="@L[_spacegroupDto.GetMemberDescription(x=>x.Capacity)]" />
                <PropertyColumn Property="x => x.ZoneId" Title="@L[_spacegroupDto.GetMemberDescription(x=>x.ZoneId)]" />

            </Columns>
            <NoRecordsContent>
                <MudText>@AppStrings.NoRecords</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>@AppStrings.Loading</MudText>
            </LoadingContent>
            <PagerContent>
                <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100,500,1000})" />
            </PagerContent>
</MudDataGrid>



@code {
    public string? Title { get; private set; }
    private int _defaultPageSize = 15;
    private HashSet<SpaceGroupDto> _selectedSpaceGroups = new HashSet<SpaceGroupDto>();
    private MudDataGrid<SpaceGroupDto> _spacegroupsGrid = default!;
    private SpaceGroupDto _spacegroupDto = new();
    private bool _loading;
    private bool _uploading;
    private bool _exporting;
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;
    [CascadingParameter]
    private UserProfile? UserProfile { get; set; }


    private SpaceGroupsWithPaginationQuery _spacegroupsQuery { get; set; } = new();
    private SpaceGroupsAccessRights _accessRights = new();

    protected override async Task OnInitializedAsync()
    {
        Title = L[_spacegroupDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<SpaceGroupsAccessRights>(); 
    }
     
    private async Task<GridData<SpaceGroupDto>> ServerReload(GridState<SpaceGroupDto> state)
    {
        try
        {
            _loading = true;
            _spacegroupsQuery.CurrentUser = UserProfile;
            var sortDefinition = state.SortDefinitions.FirstOrDefault();
            _spacegroupsQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
            _spacegroupsQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
                                      ? SortDirection.Descending.ToString()
                                      : SortDirection.Ascending.ToString();
            _spacegroupsQuery.PageNumber = state.Page + 1;
            _spacegroupsQuery.PageSize = state.PageSize;
            var result = await Mediator.Send(_spacegroupsQuery).ConfigureAwait(false);
            return new GridData<SpaceGroupDto>() { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }

    }
    private async Task OnSearch(string text)
    {
        _selectedSpaceGroups.Clear();
        _spacegroupsQuery.Keyword = text;
        await _spacegroupsGrid.ReloadServerData();
    }
    private async Task OnListViewChanged(SpaceGroupListView listview)
    {
        _spacegroupsQuery.ListView = listview;
        await _spacegroupsGrid.ReloadServerData();
    }
    private async Task OnRefresh()
    {
        SpaceGroupCacheKey.Refresh();
        _selectedSpaceGroups.Clear();
        _spacegroupsQuery.Keyword  = string.Empty;
        await _spacegroupsGrid.ReloadServerData();
    }
    private Task ShowEditFormDialog(string title, AddEditSpaceGroupCommand command)
    {
        return DialogServiceHelper.ShowFormDialogAsync<SpaceGroupFormDialog, AddEditSpaceGroupCommand>(
            title,
            new DialogParameters<SpaceGroupFormDialog>()
			{
				{x => x._model, command }
			},
            async () =>
            {
                await _spacegroupsGrid.ReloadServerData();
                _selectedSpaceGroups.Clear();
            });
    }
    private void OnDataGridRowClick(SpaceGroupDto dto)
    {
        Navigation.NavigateTo($"/pages/spacegroups/view/{dto.Id}");
    }
    private Task OnCreate()
    {
        var command = new AddEditSpaceGroupCommand();
        return ShowEditFormDialog(L["New SpaceGroup"], command);
    }
    private Task OnCloneSpaceGroup()
    {
        var dto = _selectedSpaceGroups.First();
        var command = new AddEditSpaceGroupCommand()
        {
                    Name = dto.Name, 
        Capacity = dto.Capacity, 
        ZoneId = dto.ZoneId, 
        Description = dto.Description, 

        };
        return ShowEditFormDialog(L["Clone SpaceGroup"], command);
    }
    private Task OnEditSpaceGroup(SpaceGroupDto dto)
    {
       //var command = Mapper.Map<AddEditSpaceGroupCommand>(dto);
       //return ShowEditFormDialog(L["Edit SpaceGroup"], command);
       Navigation.NavigateTo($"/pages/spacegroups/edit/{dto.Id}");
       return Task.CompletedTask;
    }

    private Task OnDeleteSpaceGroup(SpaceGroupDto dto)
    {
        var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Name);
        var command = new DeleteSpaceGroupCommand(new int[] { dto.Id });
        return DeleteSpaceGroupsInternal(command, contentText); 
    }

    private Task OnDeleteSelectedSpaceGroups()
    {
        var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedSpaceGroups.Count);
        var command = new DeleteSpaceGroupCommand(_selectedSpaceGroups.Select(x => x.Id).ToArray());
        return DeleteSpaceGroupsInternal(command, contentText);
    }

    private Task DeleteSpaceGroupsInternal(DeleteSpaceGroupCommand command, string contentText)
    {
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                await _spacegroupsGrid.ReloadServerData();
                _selectedSpaceGroups.Clear();
            });
    }


    private async Task OnExport()
    {
        _exporting = true;
        var request = new ExportSpaceGroupsQuery()
            {
                Keyword = _spacegroupsQuery.Keyword,
                CurrentUser = UserProfile,
                ListView = _spacegroupsQuery.ListView,
                OrderBy = _spacegroupsGrid.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                SortDirection = (_spacegroupsGrid.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
            };
        var result = await Mediator.Send(request);
        await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["SpaceGroups"]}.xlsx", result.Data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _exporting = false;
    }
    private async Task OnImportData(IBrowserFile file)
    {
        _uploading = true;
        var stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);
        var command = new ImportSpaceGroupsCommand(file.Name, stream.ToArray());
        var result = await Mediator.Send(command);
        await result.MatchAsync(
            async data =>
            {
                await _spacegroupsGrid.ReloadServerData();
                Snackbar.Add($"{AppStrings.ImportSuccess}", MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        _uploading = false;
    }

}
