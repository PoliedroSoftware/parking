@code {
    public string? Title { get; private set; }
    private string _licensePlate = string.Empty;
    private VehicleTypes _vehicleType = VehicleTypes.PrivateCar;
    private string _vehicleTypeName = "Carro";
    private bool _processing;
    private string? _lastMessage;
    private Severity _lastSeverity = Severity.Info;
    private List<MovementRecord> _movements = new();
    private List<ActiveParkingViewModel> _activeViewModels = new();
    private MudAutocomplete<string>? _plateInput;
    private Timer? _refreshTimer;
    private bool _disposed;
    private ParkingPaymentsAccessRights _parkingPaymentAccessRights = new();
    private const string ActiveParkingStatus = "Activo";
    private const string CompletedParkingStatus = "Completado";
    private const int ParkingHourlyRate = 3500;

    protected override async Task OnInitializedAsync()
    {
        Title = L["Parqueo"];
        _parkingPaymentAccessRights = await PermissionService.GetAccessRightsAsync<ParkingPaymentsAccessRights>();
        await LoadParkingStateSafeAsync(showSnackbar: true);
        _refreshTimer = new Timer(_ => _ = InvokeAsync(async () =>
        {
            if (_disposed)
                return;

            await LoadParkingStateSafeAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await FocusPlateInputAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _refreshTimer?.Dispose();
    }

    private async Task LoadParkingStateSafeAsync(bool showSnackbar = false)
    {
        try
        {
            await LoadParkingStateAsync();
        }
        catch (Exception ex)
        {
            _lastMessage = $"Error cargando parqueos: {ex.Message}";
            _lastSeverity = Severity.Error;

            if (showSnackbar)
                Snackbar.Add(_lastMessage, Severity.Error);
        }
    }

    private async Task LoadParkingStateAsync()
    {
        await using var db = await DbFactory.CreateAsync();
        var today = DateTime.Today;
        var tomorrow = today.AddDays(1);

        var records = await db.ParkingRecords
            .AsNoTracking()
            .Where(p => (p.EntryTime >= today && p.EntryTime < tomorrow) ||
                        (p.ExitTime.HasValue && p.ExitTime.Value >= today && p.ExitTime.Value < tomorrow) ||
                        p.Status == ActiveParkingStatus)
            .OrderByDescending(p => p.ExitTime ?? p.EntryTime)
            .ToListAsync();

        _movements = records
            .Where(p => p.EntryTime >= today && p.EntryTime < tomorrow ||
                        p.ExitTime.HasValue && p.ExitTime.Value >= today && p.ExitTime.Value < tomorrow)
            .Select(ToMovementRecord)
            .ToList();

        _activeViewModels = records
            .Where(p => p.Status == ActiveParkingStatus)
            .OrderBy(p => p.EntryTime)
            .Select(p => new ActiveParkingViewModel
            {
                LicensePlate = p.LicensePlate,
                EntryTime = p.EntryTime,
                TicketNumber = p.TicketNumber ?? string.Empty,
                VehicleType = ParseVehicleType(p.Notes),
                EstimatedAmount = CalculateAmount(DateTime.Now - p.EntryTime)
            })
            .ToList();
    }

    private async Task RefreshMovements()
    {
        await LoadParkingStateSafeAsync(showSnackbar: true);
        StateHasChanged();
    }

    private static int CalculateAmount(TimeSpan duration)
    {
        var hours = Math.Ceiling(duration.TotalHours);
        return Math.Max(2000, (int)(hours * ParkingHourlyRate));
    }

    private async Task OnPlateKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_licensePlate) && !_processing)
        {
            await ProcessPlate();
        }
    }

    private Task<IEnumerable<string>> SearchActivePlates(string search, CancellationToken cancellationToken)
    {
        var normalizedSearch = NormalizePlate(search);
        var matches = _activeViewModels
            .Select(vm => vm.LicensePlate)
            .Where(plate => !string.IsNullOrWhiteSpace(plate))
            .Distinct(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(normalizedSearch))
        {
            matches = matches
                .Where(plate => NormalizePlate(plate).Contains(normalizedSearch, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(plate => NormalizePlate(plate).StartsWith(normalizedSearch, StringComparison.OrdinalIgnoreCase))
                .ThenBy(plate => plate);
        }
        else
        {
            matches = matches.OrderBy(plate => plate);
        }

        return Task.FromResult(matches.Take(8));
    }

    private async Task ProcessPlate()
    {
        if (_processing) return;

        var plate = NormalizePlate(_licensePlate);
        if (string.IsNullOrEmpty(plate)) return;

        _processing = true;
        await ClearPlateInputAsync();
        await InvokeAsync(StateHasChanged);

        try
        {
            var activeRecord = await GetActiveParkingRecordAsync(plate);
            if (activeRecord is not null)
            {
                await DoCheckout(activeRecord.LicensePlate, "");
            }
            else
            {
                var dialog = await DialogService.ShowAsync<VehicleTypeDialog>("",
                    options: new DialogOptions
                    {
                        CloseButton = false,
                        MaxWidth = MaxWidth.ExtraLarge,
                        FullWidth = true,
                        NoHeader = true
                    });
                var result = await dialog.Result;
                if (result.Canceled || result.Data is not string vehicleTypeName)
                {
                    await FocusPlateInputAsync();
                    return;
                }
                _vehicleTypeName = vehicleTypeName;
                await DoEntry(plate);
            }
        }
        catch (Exception ex)
        {
            _lastMessage = $"Error procesando placa {plate}: {ex.Message}";
            _lastSeverity = Severity.Error;
            Snackbar.Add(_lastMessage, Severity.Error);
            await ClearPlateInputAsync();
            await InvokeAsync(StateHasChanged);
            await FocusPlateInputAsync();
        }
        finally
        {
            _processing = false;
        }
    }

    private async Task DoEntry(string plate)
    {
        var entryTime = DateTime.Now;
        var ticketNo = TicketService.GenerateTicketNumber();

        await using var db = await DbFactory.CreateAsync();
        db.ParkingRecords.Add(new ParkingRecord
        {
            LicensePlate = plate,
            EntryTime = entryTime,
            TicketNumber = ticketNo,
            Status = ActiveParkingStatus,
            Amount = 0,
            Notes = _vehicleType.ToString()
        });
        await db.SaveChangesAsync(CancellationToken.None);

        ParkingService.RegisterEntry(new ParkingSession
        {
            LicensePlate = plate,
            EntryTime = entryTime,
            VehicleType = _vehicleTypeName,
            TicketNumber = ticketNo
        });

        MovementTracker.AddMovement(new MovementRecord
        {
            Time = entryTime,
            Type = "Entrada",
            LicensePlate = plate,
            CustomerName = "",
            Amount = 0,
            Status = ActiveParkingStatus
        });

        var ticketData = new TicketData
        {
            Type = TicketType.Entry,
            LicensePlate = plate,
            DateTime = entryTime,
            TicketNumber = ticketNo,
            OperatorName = "Operador",
            VehicleType = _vehicleType.GetDescription()
        };

        await PrintPosTicket(ticketData);

        _lastMessage = $"ENTRADA: {plate} - {FormatTime(entryTime, includeSeconds: true)}";
        _lastSeverity = Severity.Info;
        Snackbar.Add($"Entrada: {plate}", Severity.Success);

        await ClearPlateAndReloadAsync();
    }

    private async Task DoCheckout(string plate, string customerName)
    {
        await using var db = await DbFactory.CreateAsync();
        var normalizedPlate = NormalizePlate(plate);
        var record = await db.ParkingRecords
            .Where(p => p.Status == ActiveParkingStatus &&
                        p.LicensePlate.Replace("-", "").Replace(" ", "").ToUpper() == normalizedPlate)
            .OrderByDescending(p => p.EntryTime)
            .FirstOrDefaultAsync();

        if (record is null)
        {
            Snackbar.Add($"No hay parqueo activo para la placa {plate}.", Severity.Warning);
            await ClearPlateAndReloadAsync();
            return;
        }

        var exitTime = DateTime.Now;
        var duration = exitTime - record.EntryTime;
        var amount = CalculateAmount(duration);
        var customer = string.IsNullOrWhiteSpace(customerName) ? "Consumidor Final" : customerName.Trim();
        var formattedDuration = FormatDuration(duration);

        ParkingService.Checkout(plate);

        record.ExitTime = exitTime;
        record.Amount = amount;
        record.Status = CompletedParkingStatus;
        record.CustomerName = customer;
        await db.SaveChangesAsync(CancellationToken.None);

        var updated = MovementTracker.UpdateExit(plate, customer, amount, formattedDuration);
        if (updated is null)
        {
            MovementTracker.AddMovement(new MovementRecord
            {
                Time = exitTime,
                Type = "Entrada",
                LicensePlate = plate,
                CustomerName = customer == "Consumidor Final" ? "" : customer,
                Amount = amount,
                Status = CompletedParkingStatus,
                ExitTime = exitTime,
                FormattedDuration = formattedDuration
            });
        }

        var exitTicketData = new TicketData
        {
            Type = TicketType.Exit,
            LicensePlate = plate,
            DateTime = exitTime,
            EntryTime = record.EntryTime,
            TicketNumber = record.TicketNumber,
            Amount = amount,
            GrossAmount = amount,
            DiscountAmount = 0,
            HourlyRate = ParkingHourlyRate,
            Duration = duration,
            CustomerName = customer == "Consumidor Final" ? null : customer,
            OperatorName = "Operador",
            VehicleType = ParseVehicleType(record.Notes)
        };

        await PrintPosTicket(exitTicketData);

        _lastMessage = $"SALIDA: {plate} - {formattedDuration} - $ {amount:N0}";
        _lastSeverity = Severity.Success;
        Snackbar.Add($"Salida: {plate} - $ {amount:N0}", Severity.Success);

        await ClearPlateAndReloadAsync();
    }

    private async Task CheckoutFromList(ActiveParkingViewModel vm)
    {
        await DoCheckout(vm.LicensePlate, "");
    }

    private async Task CheckoutByPlate(string plate)
    {
        await DoCheckout(NormalizePlate(plate), "");
    }

    private async Task<ParkingRecord?> GetActiveParkingRecordAsync(string plate)
    {
        var normalizedPlate = NormalizePlate(plate);
        await using var db = await DbFactory.CreateAsync();
        return await db.ParkingRecords
            .AsNoTracking()
            .Where(p => p.Status == ActiveParkingStatus &&
                        p.LicensePlate.Replace("-", "").Replace(" ", "").ToUpper() == normalizedPlate)
            .OrderByDescending(p => p.EntryTime)
            .FirstOrDefaultAsync();
    }

    private static string NormalizePlate(string? plate)
    {
        return string.IsNullOrWhiteSpace(plate)
            ? string.Empty
            : plate.Trim().Replace("-", string.Empty).Replace(" ", string.Empty).ToUpperInvariant();
    }

    private async Task ClearPlateAndReloadAsync()
    {
        await ClearPlateInputAsync();
        await LoadParkingStateSafeAsync(showSnackbar: true);
        await InvokeAsync(StateHasChanged);
        await FocusPlateInputAsync();
    }

    private async Task ClearPlateInputAsync()
    {
        _licensePlate = string.Empty;

        if (_plateInput is not null)
        {
            await _plateInput.ClearAsync();
        }
    }

    private async Task FocusPlateInputAsync()
    {
        try
        {
            if (_plateInput is not null)
                await _plateInput.FocusAsync();
        }
        catch
        {
            // The input can be unavailable while the print popup opens or the circuit is closing.
        }
    }

    private static bool CanAdjustParkingPayment(MovementRecord movement)
    {
        return movement.RecordId > 0 && movement.Status == CompletedParkingStatus && movement.ExitTime.HasValue;
    }

    private async Task AdjustParkingPayment(MovementRecord movement)
    {
        if (!_parkingPaymentAccessRights.Adjust ||
            !await PermissionService.HasPermissionAsync(Permissions.ParkingPayments.Adjust))
        {
            Snackbar.Add("No tiene permiso para ajustar pagos de parqueo.", Severity.Error);
            return;
        }

        if (!CanAdjustParkingPayment(movement))
        {
            Snackbar.Add("Solo se puede ajustar el pago de un parqueo finalizado.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<AdjustParkingPaymentDialog>
        {
            { x => x.LicensePlate, movement.LicensePlate },
            { x => x.CurrentAmount, movement.Amount }
        };
        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<AdjustParkingPaymentDialog>(
            "Ajustar pago de parqueo",
            parameters,
            options);
        var dialogResult = await dialog.Result;
        if (dialogResult is null || dialogResult.Canceled ||
            dialogResult.Data is not ParkingPaymentAdjustmentInput adjustment)
            return;

        var result = await Mediator.Send(new AdjustParkingPaymentCommand
        {
            ParkingRecordId = movement.RecordId,
            NewAmount = adjustment.NewAmount,
            Reason = adjustment.Reason
        });

        if (result.Succeeded)
        {
            Snackbar.Add("Pago de parqueo ajustado.", Severity.Success);
            await LoadParkingStateSafeAsync(showSnackbar: true);
            StateHasChanged();
            return;
        }

        Snackbar.Add(result.Errors.FirstOrDefault() ?? "No se pudo ajustar el pago de parqueo.", Severity.Error);
    }

    private static MovementRecord ToMovementRecord(ParkingRecord record)
    {
        var duration = record.ExitTime.HasValue ? record.ExitTime.Value - record.EntryTime : (TimeSpan?)null;
        return new MovementRecord
        {
            RecordId = record.Id,
            Id = record.TicketNumber ?? record.Id.ToString(),
            Time = record.EntryTime,
            Type = "Entrada",
            LicensePlate = record.LicensePlate,
            CustomerName = record.CustomerName ?? string.Empty,
            Amount = (int)record.Amount,
            GrossAmount = duration.HasValue ? CalculateAmount(duration.Value) : (int)record.Amount,
            DiscountAmount = duration.HasValue ? Math.Max(0, CalculateAmount(duration.Value) - (int)record.Amount) : 0,
            Status = record.Status,
            ExitTime = record.ExitTime,
            FormattedDuration = duration.HasValue ? FormatDuration(duration) : string.Empty,
            VehicleType = ParseVehicleType(record.Notes)
        };
    }

    private static string ParseVehicleType(string? notes)
    {
        if (string.IsNullOrWhiteSpace(notes))
            return "Carro";

        var vehicleTypeName = notes.Split('|', 2)[0].Trim();
        return Enum.TryParse<VehicleTypes>(vehicleTypeName, out var vehicleType)
            ? vehicleType.GetDescription()
            : vehicleTypeName;
    }

    private async Task ReprintTicket(MovementRecord m)
    {
        var type = m.Type == "Lavado" ? TicketType.Wash
                 : m.Type == "Mensualidad" ? TicketType.Monthly
                 : TicketType.Exit;

        var ticketNo = m.Type == "Entrada" ? $"TK-ENT-{m.Id}" : m.Id;
        var ticketData = new TicketData
        {
            Type = type,
            LicensePlate = m.LicensePlate,
            DateTime = m.ExitTime ?? m.Time,
            EntryTime = m.Time,
            TicketNumber = ticketNo,
            Amount = m.Amount,
            GrossAmount = m.GrossAmount,
            DiscountAmount = m.DiscountAmount,
            HourlyRate = type == TicketType.Exit ? ParkingHourlyRate : null,
            Duration = !string.IsNullOrEmpty(m.FormattedDuration) && m.FormattedDuration != "--"
                ? ParseDuration(m.FormattedDuration) : null,
            CustomerName = string.IsNullOrEmpty(m.CustomerName) || m.CustomerName == "Consumidor Final" ? null : m.CustomerName,
            OperatorName = "Operador"
        };

        await PrintPosTicket(ticketData);
    }

    private async Task DownloadPdf(MovementRecord m)
    {
        var type = m.Type == "Lavado" ? TicketType.Wash
                 : m.Type == "Mensualidad" ? TicketType.Monthly
                 : TicketType.Exit;

        var duration = !string.IsNullOrEmpty(m.FormattedDuration) && m.FormattedDuration != "--"
            ? ParseDuration(m.FormattedDuration) : null;

        var ticketData = new TicketData
        {
            Type = type, LicensePlate = m.LicensePlate,
            DateTime = m.ExitTime ?? m.Time, EntryTime = m.Time,
            TicketNumber = m.Id, Amount = m.Amount,
            GrossAmount = m.GrossAmount,
            DiscountAmount = m.DiscountAmount,
            HourlyRate = type == TicketType.Exit ? ParkingHourlyRate : null,
            Duration = duration,
            CustomerName = m.CustomerName == "Consumidor Final" ? null : m.CustomerName,
            OperatorName = "Operador"
        };
        await CompanyInformationService.ApplyAsync(ticketData);
        var pdf = TicketPdfService.GenerateTicketPdf(ticketData);
        await BlazorDownloadFileService.DownloadFileAsync($"Ticket_{m.LicensePlate}_{m.Id}.pdf", pdf, "application/pdf");
        Snackbar.Add("PDF descargado", Severity.Success);
    }

    private static TimeSpan? ParseDuration(string formatted)
    {
        try
        {
            var days = 0;
            if (formatted.Contains('d'))
            {
                var dayParts = formatted.Split('d', 2);
                days = int.Parse(dayParts[0].Trim());
                formatted = dayParts.Length > 1 ? dayParts[1].Trim() : string.Empty;
            }

            if (formatted.Contains('h'))
            {
                var parts = formatted.Split('h', 'm');
                var hours = int.Parse(parts[0].Trim());
                var mins = parts.Length > 1 && parts[1].Trim().Length > 0 ? int.Parse(parts[1].Trim()) : 0;
                return new TimeSpan(days, hours, mins, 0);
            }
            if (formatted.EndsWith("min"))
            {
                var mins = int.Parse(formatted.Replace("min", "").Trim());
                return new TimeSpan(days, 0, mins, 0);
            }

            if (days > 0)
                return new TimeSpan(days, 0, 0, 0);
        }
        catch { }
        return null;
    }

    private async Task PrintPosTicket(TicketData ticketData)
    {
        var result = await PosTicketPrintService.PrintAsync(ticketData);
        ShowPrintResult(result);
    }

    private void ShowPrintResult(PosTicketPrintResult result)
    {
        var severity = result.PrintedDirectly
            ? Severity.Success
            : result.PreviewOpened ? Severity.Warning : Severity.Error;
        Snackbar.Add(result.Message, severity);
    }

    private static string FormatDuration(TimeSpan? duration)
    {
        if (duration == null) return "--";
        var d = duration.Value;
        if (d.TotalDays >= 1)
            return $"{d.Days}d {d.Hours}h {d.Minutes}m";
        if (d.TotalHours >= 1)
            return $"{(int)d.TotalHours}h {d.Minutes}m";
        return $"{d.Minutes} min";
    }

    private static string FormatTime(DateTime value, bool includeSeconds = false)
    {
        var format = includeSeconds ? "hh:mm:ss tt" : "hh:mm tt";
        return value.ToString(format, CultureInfo.InvariantCulture);
    }

    private Color GetStatusColor(MovementRecord m)
    {
        if (m.Type == "Lavado") return Color.Warning;
        if (m.Type == "Mensualidad") return Color.Primary;
        return m.Status == ActiveParkingStatus ? Color.Info : Color.Success;
    }

    private string GetStatusLabel(MovementRecord m)
    {
        if (m.Type == "Lavado") return "LAVADO";
        if (m.Type == "Mensualidad") return "MENSUAL";
        return m.Status == ActiveParkingStatus ? "ACTIVO" : "COMPLETADO";
    }

