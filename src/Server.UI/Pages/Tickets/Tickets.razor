@page "/pages/tickets"

@using CleanArchitecture.Blazor.Server.UI.Services
@using CleanArchitecture.Blazor.Application.Features.ParkingPayments.Commands.Adjust
@using CleanArchitecture.Blazor.Server.UI.Pages.Tickets.Components
@using CleanArchitecture.Blazor.Domain.Enums
@using System.Collections.Concurrent
@using System.Globalization

@inject IStringLocalizer<Tickets> L
@inject TicketService TicketService
@inject CompanyInformationService CompanyInformationService
@inject PosTicketPrintService PosTicketPrintService
@inject TicketPdfService TicketPdfService
@inject ParkingSessionService ParkingService
@inject ISnackbar Snackbar
@inject IApplicationDbContextFactory DbFactory
@inject BlazorDownloadFileService BlazorDownloadFileService
@attribute [Authorize]
@implements IDisposable

<PageTitle>@Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="parking-shell">
    <section class="parking-header">
        <div>
            <MudText Typo="Typo.h4" Class="parking-title">@L["Parqueo"]</MudText>
            <MudText Typo="Typo.body1" Class="parking-subtitle">@L["Entrada y salida de vehiculos"]</MudText>
        </div>
        <div class="parking-date">@DateTime.Today.ToString("dd/MM/yyyy")</div>
    </section>

    <MudGrid Spacing="2" Class="parking-metrics">
        <MudItem xs="12" sm="4">
            <div class="metric-card">
                <span class="metric-label">@L["Activos"]</span>
                <strong>@_activeViewModels.Count</strong>
            </div>
        </MudItem>
        <MudItem xs="12" sm="4">
            <div class="metric-card">
                <span class="metric-label">Movimientos</span>
                <strong>@_movements.Count</strong>
            </div>
        </MudItem>
        <MudItem xs="12" sm="4">
            <div class="metric-card metric-card-total">
                <span class="metric-label">Total del dia</span>
                <strong>$ @_movements.Sum(m => m.Amount).ToString("N0")</strong>
            </div>
        </MudItem>
    </MudGrid>

    @* PLATE INPUT *@
    <MudPaper Elevation="0" Class="parking-entry-panel">
        <div class="entry-heading">
            <div>
                <MudText Typo="Typo.subtitle1" Class="entry-title">@L["Placa del vehiculo"]</MudText>
                <MudText Typo="Typo.body2" Class="entry-subtitle">Entrada / salida</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.LocalParking" Class="entry-icon" />
        </div>
        <div class="entry-form">
            <MudAutocomplete T="string" @bind-Value="_licensePlate" Immediate="true"
                             @ref="_plateInput"
                             SearchFunc="SearchActivePlates"
                             CoerceText="true"
                             CoerceValue="true"
                             ResetValueOnEmptyText="false"
                             MaxItems="8"
                             Style="width:100%;"
                             Variant="Variant.Outlined"
                             Placeholder="ABC123"
                             AutoFocus="true"
                             Class="plate-input"
                             Adornment="Adornment.End"
                             AdornmentIcon="@Icons.Material.Filled.Search"
                             OnKeyUp="OnPlateKeyUp" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="process-button"
                       OnClick="ProcessPlate" StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="@(string.IsNullOrWhiteSpace(_licensePlate))">
                @L["PROCESAR"]
            </MudButton>
        </div>
    </MudPaper>

    @* FEEDBACK *@
    @if (_lastMessage != null)
    {
        <MudAlert Severity="@_lastSeverity" Variant="Variant.Filled" Class="parking-alert">
            @_lastMessage
        </MudAlert>
    }

    @* ACTIVE PARKING SESSIONS *@
    @if (_activeViewModels.Any())
    {
        <MudCard Elevation="0" Class="parking-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Class="section-title active-title">
                        <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Class="mr-2" />
                        Parqueos Activos
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div class="mud-data-grid-responsive">
                <MudTable Items="@_activeViewModels" Hover="true" Dense="true" FixedHeader="true" Height="280px" Class="parking-table">
                    <HeaderContent>
                        <MudTh>Placa</MudTh>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Entrada</MudTh>
                        <MudTh>Tiempo Transcurrido</MudTh>
                        <MudTh Style="text-align:right;">A Pagar</MudTh>
                        <MudTh Style="text-align:center;">Accion</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><strong class="plate-cell">@context.LicensePlate</strong></MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.VehicleType</MudChip>
                        </MudTd>
                        <MudTd>@FormatTime(context.EntryTime)</MudTd>
                        <MudTd>@FormatDuration(DateTime.Now - context.EntryTime)</MudTd>
                        <MudTd Class="amount-cell">$ @context.EstimatedAmount.ToString("N0")</MudTd>
                        <MudTd Style="text-align:center;">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       OnClick="@(() => CheckoutFromList(context))" StartIcon="@Icons.Material.Filled.Logout">
                                DAR SALIDA
                            </MudButton>
                        </MudTd>
                        <MudTd></MudTd>
                    </RowTemplate>
                </MudTable>
                </div>
            </MudCardContent>
        </MudCard>
    }

    @* MOVIMIENTOS DEL DIA *@
    <MudCard Elevation="0" Class="parking-card movements-card">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6" Class="section-title">Movimientos del Dia</MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="RefreshMovements" StartIcon="@Icons.Material.Filled.Refresh">
                    Actualizar
                </MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @if (_movements.Any())
            {
                <div class="mud-data-grid-responsive">
                <MudTable Items="@_movements" Hover="true" Dense="true" FixedHeader="true" Height="350px" Class="parking-table">
                    <HeaderContent>
                        <MudTh>Entrada</MudTh>
                        <MudTh>Salida</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Placa</MudTh>
                        <MudTh>Tipo</MudTh>
                        <MudTh>Cliente</MudTh>
                        <MudTh>Duracion</MudTh>
                        <MudTh Style="text-align:right;">Descuento</MudTh>
                        <MudTh Style="text-align:right;">Valor</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@FormatTime(context.Time)</MudTd>
                        <MudTd>@(context.ExitTime.HasValue ? FormatTime(context.ExitTime.Value) : "--")</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context)">
                                @GetStatusLabel(context)
                            </MudChip>
                        </MudTd>
                        <MudTd><strong class="plate-cell small">@context.LicensePlate</strong></MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@(string.IsNullOrEmpty(context.VehicleType) ? "-" : context.VehicleType)</MudChip>
                        </MudTd>
                        <MudTd>@(string.IsNullOrEmpty(context.CustomerName) ? "Consumidor Final" : context.CustomerName)</MudTd>
                        <MudTd>@context.FormattedDuration</MudTd>
                        <MudTd Class="amount-cell">
                            @if (context.DiscountAmount > 0)
                            {
                                <span class="discount-cell">-$ @context.DiscountAmount.ToString("N0")</span>
                            }
                            else
                            {
                                <span style="color:#999;">-</span>
                            }
                        </MudTd>
                        <MudTd Class="amount-cell">
                            @if (context.Amount > 0)
                            {
                                <span>$ @context.Amount.ToString("N0")</span>
                            }
                            else
                            {
                                <span style="color:#999;">-</span>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.Status == ActiveParkingStatus)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                           OnClick="@(() => CheckoutByPlate(context.LicensePlate))" StartIcon="@Icons.Material.Filled.Logout">
                                    SALIDA
                                </MudButton>
                            }
                            else if (context.Status == CompletedParkingStatus)
                            {
                                <MudStack Row Spacing="1">
                                    @if (context.Amount > 0)
                                    {
                                        <MudIconButton Variant="Variant.Outlined" Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.Print"
                                                       Color="Color.Info"
                                                       OnClick="@(() => ReprintTicket(context))" />
                                        <MudIconButton Variant="Variant.Outlined" Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.PictureAsPdf"
                                                       Color="Color.Error"
                                                       OnClick="@(() => DownloadPdf(context))" />
                                    }
                                    @if (_parkingPaymentAccessRights.Adjust && CanAdjustParkingPayment(context))
                                    {
                                        <MudIconButton Variant="Variant.Outlined" Size="Size.Small"
                                                       Icon="@Icons.Material.Filled.EditNote"
                                                       Color="Color.Warning"
                                                       OnClick="@(() => AdjustParkingPayment(context))" />
                                    }
                                </MudStack>
                            }
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="7" Style="text-align:right;font-weight:700;">TOTAL DEL DIA</MudTd>
                        <MudTd Style="text-align:right;font-weight:700;font-size:16px;">$ @_movements.Sum(m => m.Amount).ToString("N0")</MudTd>
                        <MudTd></MudTd>
                    </FooterContent>
                </MudTable>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="text-align:center;padding:20px;">
                    Sin movimientos registrados hoy
                </MudText>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

