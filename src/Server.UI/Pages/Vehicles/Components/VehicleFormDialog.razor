@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Services
@using CleanArchitecture.Blazor.Application.Features.Charges.Services
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.Services

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Vehicles> L
@inject ICarparkService CarparkService
@inject IZoneService ZoneService
@inject IChargesService ChargesService
<MudDialog>
	<DialogContent>
		<MudForm Model="@_model" @ref="@_vehicleForm" Validation="@(Validator.ValidateValue(_model))">
			<MudGrid>
				<MudItem xs="12" md="6">
					<MudSelect T="CarparkDto" Label="@L["Select carpark"]" Value="_carpark" ValueChanged="OnCarparkChanged" ToStringFunc="@(x => $"{x?.Name.Code} - {x?.Name.Tc}")">

					@foreach (var carpark in CarparkService.DataSource)
					{
						<MudSelectItem T="CarparkDto" Value="carpark">@($"{carpark.Name.Code} - {carpark.Name.Tc}") </MudSelectItem>
					}
				</MudSelect>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudSelect T="ZoneDto" Label="@L["Zone"]" @bind-Value="_model.Zone" ToStringFunc="@(x => $"{x?.Name.Code} - {x?.Name.Tc}")">

						@foreach (var zone in ZoneService.DataSource.Where(x => x.CarparkId == _carpark?.Id))
					{
						<MudSelectItem T="ZoneDto" Value="zone">@($"{zone.Name.Code} - {zone.Name.Tc}") </MudSelectItem>
					}
				</MudSelect>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudTextField Label="@L[_model.GetMemberDescription(x => x.Name)]" @bind-Value="_model.Name" For="@(() => _model.Name)" Required="true" RequiredError="@L["name is required!"]"></MudTextField>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudEnumSelect TEnum="Nullable<ServiceCategories>" Label="@L[_model.GetMemberDescription(x => x.ServiceCategoryId)]" @bind-Value="_model.ServiceCategoryId" For="@(() => _model.ServiceCategoryId)" Required="false" RequiredError="@L["service category id is required!"]"></MudEnumSelect>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudEnumSelect TEnum="Nullable<VehicleTypes>" Label="@L[_model.GetMemberDescription(x => x.VehicleTypeId)]" @bind-Value="_model.VehicleTypeId" For="@(() => _model.VehicleTypeId)" Required="false" RequiredError="@L["vehicle type id is required!"]"></MudEnumSelect>
				</MudItem>
			 
				<MudItem xs="12" md="6">
					<MudSelect Label="@L[_model.GetMemberDescription(x => x.Charge)]" @bind-Value="_model.Charge" For="@(() => _model.Charge)" ToStringFunc="@(x => $"{x?.Name}")" Required="false" RequiredError="@L["charge  is required!"]">
						@foreach (var charge in ChargesService.DataSource)
						{
							<MudSelectItem Value="charge">@($"{charge.Name}") </MudSelectItem>
						}
					</MudSelect>
				</MudItem>
				
				<MudItem xs="12" md="6">
					<MudCheckBox Label="@L[_model.GetMemberDescription(x => x.AllowEntryWhenFull)]" @bind-Value="_model.AllowEntryWhenFull" For="@(() => _model.AllowEntryWhenFull)" Color="Color.Primary"></MudCheckBox>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudCheckBox Label="@L[_model.GetMemberDescription(x => x.ManualFull)]" @bind-Value="_model.ManualFull" For="@(() => _model.ManualFull)" Color="Color.Primary"></MudCheckBox>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudCheckBox Label="@L[_model.GetMemberDescription(x => x.CanRecognizePlate)]" @bind-Value="_model.CanRecognizePlate" For="@(() => _model.CanRecognizePlate)" Color="Color.Primary"></MudCheckBox>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudCheckBox Label="@L[_model.GetMemberDescription(x => x.IsActive)]" @bind-Value="_model.IsActive" For="@(() => _model.IsActive)" Color="Color.Primary"></MudCheckBox>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudNumericField Label="@L[_model.GetMemberDescription(x => x.Capacity)]" @bind-Value="_model.Capacity" For="@(() => _model.Capacity)" Min="0" Required="false" RequiredError="@L["capacity is required!"]"></MudNumericField>
				</MudItem>
				<MudItem xs="12" md="6">
					<MudNumericField Label="@L[_model.GetMemberDescription(x => x.Occupied)]" @bind-Value="_model.Occupied" For="@(() => _model.Occupied)" Min="0" ReadOnly="true"></MudNumericField>
				</MudItem>

			</MudGrid>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>
		<MudLoadingButton Loading="@_saving" OnClick="OnSubmit" Color="Color.Primary" Variant="Variant.Filled">@AppStrings.Save</MudLoadingButton>
	</DialogActions>
</MudDialog>

@code {
	MudForm _vehicleForm = new();
	private bool _saving = false;
	private bool _savingnew = false;
	[Parameter]
	public CarparkDto? _carpark{ get; set; }
	[CascadingParameter]
	IMudDialogInstance MudDialog { get; set; } = default!;
	[EditorRequired][Parameter] public AddEditVehicleCommand _model { get; set; } = null!;
	protected override async Task OnInitializedAsync()
	{
		await	ChargesService.RefreshAsync();
	}
	private void OnCarparkChanged(CarparkDto? carpark)
	{
		_carpark = carpark;
	}	
	async Task OnSubmit()
	{
		try
		{
			_saving = true;
			await _vehicleForm.Validate().ConfigureAwait(false);
			if (!_vehicleForm.IsValid)
				return;
			var result = await Mediator.Send(_model);
			result.Match(data =>
			{
				MudDialog.Close(DialogResult.Ok(true));
				Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
			}, errors =>
			{
				Snackbar.Add(errors, MudBlazor.Severity.Error);
			});
		}
		finally
		{
			_saving = false;
		}
	}
	 
	void Cancel() => MudDialog.Cancel();
}