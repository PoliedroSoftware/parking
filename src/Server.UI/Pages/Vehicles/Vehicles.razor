@page "/pages/vehicles"

@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Services
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Caching
@using CleanArchitecture.Blazor.Application.Features.Vehicles.DTOs
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Specifications
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Vehicles.Commands.AddEdit
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.Services
@using CleanArchitecture.Blazor.Server.UI.Pages.Vehicles.Components

@inject IStringLocalizer<Vehicles> L
@inject BlazorDownloadFileService BlazorDownloadFileService
@inject ICarparkService CarparkService
@inject IZoneService ZoneService
@attribute [Authorize(Policy = Permissions.Vehicles.View)]
<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
			 FixedHeader="true"
			 FixedFooter="false"
			 Virtualize="false"
			 @bind-RowsPerPage="_defaultPageSize"
			 Loading="@_loading"
			 MultiSelection="true"
			 T="VehicleDto"
			 SelectOnRowClick="false"
			 RowClick="@(s=>OnDataGridRowClick(s.Item))"
			 @bind-SelectedItems="_selectedVehicles"
			 Hover="true" @ref="_vehiclesGrid">
	<ToolBarContent>
		<MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
			<MudStack Row AlignItems="AlignItems.Start">
				<MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
				<MudStack Spacing="0">
					<MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
					<MudStack Row Spacing="1" AlignItems="AlignItems.Center">
						<MudEnumSelect Style="min-width:120px" TEnum="VehicleListView" ValueChanged="OnListViewChanged" Value="_vehiclesQuery.ListView" Dense="true" Label="@L["List View"]">
						</MudEnumSelect>
						<MudSelect T="CarparkDto" Label="@L["Filter by carpark"]" ValueChanged="OncarparkFilterChanged" Clearable>
							@foreach (var carpark in CarparkService.DataSource)
							{
								<MudSelectItem T="CarparkDto" Value="carpark">@($"{carpark.Name.Code} - {carpark.Name.Tc}") </MudSelectItem>
							}
						</MudSelect>
						<MudSelect T="ZoneDto" Label="@L["Filter by zone"]" ValueChanged="OnZoneFilterChanged" Clearable>

							@foreach (var zone in ZoneService.DataSource.Where(x=>x.CarparkId==_vehiclesQuery.CarparkId))
							{
								<MudSelectItem T="ZoneDto" Value="zone">@($"{zone.Name.Code} - {zone.Name.Tc}") </MudSelectItem>
							}
						</MudSelect>
					</MudStack>
				</MudStack>
			</MudStack>
			<MudStack Spacing="2" AlignItems="AlignItems.End">
				<MudStack Row AlignItems="AlignItems.Center" Spacing="2">
					<MudButton Disabled="@_loading" Color="Color.Primary" Variant="Variant.Filled"
							   OnClick="@(() => OnRefresh())"
							   StartIcon="@Icons.Material.Outlined.Refresh">
						@AppStrings.Refresh
					</MudButton>
					@if (_accessRights.Create)
					{
						<MudButton StartIcon="@Icons.Material.Outlined.Add" Color="Color.Primary" Variant="Variant.Filled"
								   OnClick="OnCreate">
							@AppStrings.New
						</MudButton>
					}
					@if (_accessRights.Delete)
					{
						<MudButton Disabled="@(!(_selectedVehicles.Count > 0))" Color="Color.Error" Variant="Variant.Filled"
								   StartIcon="@Icons.Material.Outlined.DeleteOutline"
								   OnClick="OnDeleteSelectedVehicles">
							@AppStrings.Delete
						</MudButton>
					}
				</MudStack>
				<MudStack Row Spacing="1">
					@if (_accessRights.Search)
					{
						<MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@_vehiclesQuery.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
									  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
						</MudTextField>
					}
				</MudStack>

			</MudStack>
		</MudStack>
	</ToolBarContent>
	<Columns>
		<SelectColumn ShowInFooter="false"></SelectColumn>
		<TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
			<CellTemplate>
				@if (_accessRights.Edit || _accessRights.Delete)
				{
					<MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" Size="Size.Small"
							 Dense="true"
							 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
						@if (_accessRights.Edit)
						{
							<MudMenuItem OnClick="@(() => OnEditVehicle(context.Item))">@AppStrings.Edit</MudMenuItem>
						}
						@if (_accessRights.Delete)
						{
							<MudMenuItem OnClick="@(() => OnDeleteVehicle(context.Item))">@AppStrings.Delete</MudMenuItem>
						}
					</MudMenu>
				}
				else
				{
					<MudTooltip Text="@AppStrings.NoAllowed" Delay="300">
						<MudIconButton Variant="Variant.Outlined"
									   Disabled="true"
									   Icon="@Icons.Material.Filled.DoNotTouch"
									   Size="Size.Small"
									   Color="Color.Surface">
							@AppStrings.NoAllowed
						</MudIconButton>
					</MudTooltip>
				}
			</CellTemplate>
		</TemplateColumn>
		<PropertyColumn Property="x => x.ZoneId" Title="@L["Carpark"]">
			<CellTemplate>
				<div class="d-flex flex-column">
					<MudText Typo="Typo.body1">@context.Item.Zone?.Carpark?.Name.Code</MudText>
					<MudText Typo="Typo.body2">@context.Item.Zone?.Carpark?.Name.Tc</MudText>
				</div>
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.ZoneId" Title="@L[_vehicleDto.GetMemberDescription(x => x.Zone)]">
			<CellTemplate>
				<div class="d-flex flex-column">
					<MudText Typo="Typo.body1">@context.Item.Zone?.Name.Code</MudText>
					<MudText Typo="Typo.body2">@context.Item.Zone?.Name.Tc</MudText>
				</div>
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.Name" Title="@L[_vehicleDto.GetMemberDescription(x => x.Name)]">
			<CellTemplate>
				<div class="d-flex flex-column">
					<MudText Typo="Typo.body1">@context.Item.Name</MudText>
				</div>
			</CellTemplate>


		</PropertyColumn>
		<PropertyColumn Property="x => x.ServiceCategoryId" Title="@L[_vehicleDto.GetMemberDescription(x => x.ServiceCategoryId)]">
			<CellTemplate>
				<MudChip T="string" Value="@context.Item.ServiceCategoryId?.GetDescription()" />
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.VehicleTypeId" Title="@L[_vehicleDto.GetMemberDescription(x => x.VehicleTypeId)]">
			<CellTemplate>
				<MudChip T="string" Value="@context.Item.VehicleTypeId?.GetDescription()" />
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.Capacity" Title="@L[_vehicleDto.GetMemberDescription(x => x.Capacity)]" />
		<PropertyColumn Property="x => x.AllowEntryWhenFull" Title="@L[_vehicleDto.GetMemberDescription(x => x.AllowEntryWhenFull)]">
			<CellTemplate>
				@if (context.Item.AllowEntryWhenFull)
				{
					<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
				}
				else
				{
					<MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" />
				}
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.ManualFull" Title="@L[_vehicleDto.GetMemberDescription(x => x.ManualFull)]">
			<CellTemplate>
				@if (context.Item.AllowEntryWhenFull)
				{
					<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
				}
				else
				{
					<MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" />
				}
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.CanRecognizePlate" Title="@L[_vehicleDto.GetMemberDescription(x => x.CanRecognizePlate)]">
			<CellTemplate>
				@if (context.Item.CanRecognizePlate)
				{
					<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
				}
				else
				{
					<MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" />
				}
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.IsActive" Title="@L[_vehicleDto.GetMemberDescription(x => x.IsActive)]">
			<CellTemplate>
				@if (context.Item.IsActive)
				{
					<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
				}
				else
				{
					<MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Default" />
				}
			</CellTemplate>
		</PropertyColumn>
		<PropertyColumn Property="x => x.Occupied" Title="@L[_vehicleDto.GetMemberDescription(x => x.Occupied)]" />

	</Columns>
	<NoRecordsContent>
		<MudText>@AppStrings.NoRecords</MudText>
	</NoRecordsContent>
	<LoadingContent>
		<MudText>@AppStrings.Loading</MudText>
	</LoadingContent>
	<PagerContent>
		<MudDataGridPager PageSizeOptions="@(new int[] { 10, 15, 30, 50, 100, 500, 1000 })" />
	</PagerContent>
</MudDataGrid>



@code {
	public string? Title { get; private set; }
	private int _defaultPageSize = 15;
	private HashSet<VehicleDto> _selectedVehicles = new HashSet<VehicleDto>();
	private MudDataGrid<VehicleDto> _vehiclesGrid = default!;
	private VehicleDto _vehicleDto = new();
	private bool _loading;
	private bool _uploading;
	private bool _exporting;
	[CascadingParameter]
	private Task<AuthenticationState> AuthState { get; set; } = default!;
	[CascadingParameter]
	private UserProfile? UserProfile { get; set; }


	private VehiclesWithPaginationQuery _vehiclesQuery { get; set; } = new();
	private VehiclesAccessRights _accessRights = new();

	protected override async Task OnInitializedAsync()
	{
		Title = L[_vehicleDto.GetClassDescription()];
		_accessRights = await PermissionService.GetAccessRightsAsync<VehiclesAccessRights>();
		await ZoneService.RefreshAsync();
		await CarparkService.RefreshAsync();
	}

	private async Task<GridData<VehicleDto>> ServerReload(GridState<VehicleDto> state)
	{
		try
		{
			_loading = true;
			_vehiclesQuery.CurrentUser = UserProfile;
			var sortDefinition = state.SortDefinitions.FirstOrDefault();
			_vehiclesQuery.OrderBy = sortDefinition?.SortBy ?? "Id";
			_vehiclesQuery.SortDirection = (sortDefinition != null && sortDefinition.Descending)
									  ? SortDirection.Descending.ToString()
									  : SortDirection.Ascending.ToString();
			_vehiclesQuery.PageNumber = state.Page + 1;
			_vehiclesQuery.PageSize = state.PageSize;
			var result = await Mediator.Send(_vehiclesQuery).ConfigureAwait(false);
			return new GridData<VehicleDto>() { TotalItems = result.TotalItems, Items = result.Items };
		}
		finally
		{
			_loading = false;
		}

	}
	private async Task OncarparkFilterChanged(CarparkDto? carpark)
	{
		_selectedVehicles.Clear();
		_vehiclesQuery.CarparkId = carpark?.Id;
		await _vehiclesGrid.ReloadServerData();
	}
	private async Task OnZoneFilterChanged(ZoneDto? zone)
	{
		_selectedVehicles.Clear();
		_vehiclesQuery.ZoneId = zone?.Id;
		await _vehiclesGrid.ReloadServerData();
	}
	private async Task OnSearch(string text)
	{
		_selectedVehicles.Clear();
		_vehiclesQuery.Keyword = text;
		await _vehiclesGrid.ReloadServerData();
	}
	private async Task OnListViewChanged(VehicleListView listview)
	{
		_vehiclesQuery.ListView = listview;
		await _vehiclesGrid.ReloadServerData();
	}
	private async Task OnRefresh()
	{
		VehicleCacheKey.Refresh();
		_selectedVehicles.Clear();
		_vehiclesQuery.Keyword = string.Empty;
		await _vehiclesGrid.ReloadServerData();
	}
	private Task ShowEditFormDialog(string title, AddEditVehicleCommand command)
	{
		return DialogServiceHelper.ShowFormDialogAsync<VehicleFormDialog, AddEditVehicleCommand>(
			title,
			new DialogParameters<VehicleFormDialog>()
			{
				{x => x._model, command },
				{x=>x._carpark, command.Zone?.Carpark  }
			},
			async () =>
			{
				await _vehiclesGrid.ReloadServerData();
				_selectedVehicles.Clear();
			});
	}
	private void OnDataGridRowClick(VehicleDto dto)
	{
		// Navigation.NavigateTo($"/pages/vehicles/view/{dto.Id}");
	}
	private Task OnCreate()
	{
		var command = new AddEditVehicleCommand();
		return ShowEditFormDialog(L["New Vehicle"], command);
	}

	private Task OnEditVehicle(VehicleDto dto)
	{
		var command = Mapper.Map<AddEditVehicleCommand>(dto);
		return ShowEditFormDialog(L["Edit Vehicle"], command);

	}

	private Task OnDeleteVehicle(VehicleDto dto)
	{
		var contentText = string.Format(AppStrings.DeleteConfirmation, dto.Name);
		var command = new DeleteVehicleCommand(new int[] { dto.Id });
		return DeleteVehiclesInternal(command, contentText);
	}

	private Task OnDeleteSelectedVehicles()
	{
		var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedVehicles.Count);
		var command = new DeleteVehicleCommand(_selectedVehicles.Select(x => x.Id).ToArray());
		return DeleteVehiclesInternal(command, contentText);
	}

	private Task DeleteVehiclesInternal(DeleteVehicleCommand command, string contentText)
	{
		return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
			command,
			AppStrings.DeleteConfirmationTitle,
			contentText,
			async () =>
			{
				await _vehiclesGrid.ReloadServerData();
				_selectedVehicles.Clear();
			});
	}




}
