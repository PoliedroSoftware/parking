@using CleanArchitecture.Blazor.Application.Features.Carparks.DTOs
@using CleanArchitecture.Blazor.Application.Features.Carparks.Services
@using CleanArchitecture.Blazor.Application.Features.Zones.Commands.AddEdit

@inherits MudComponentBase
@inject IValidationService Validator
@inject ICarparkService CarparkService
<MudDialog>
    <DialogContent>
        <MudForm Model="@_model" @ref="@_zoneForm" Validation="@(Validator.ValidateValue(_model))">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="CarparkDto" Label="Parqueadero" ToStringFunc="@(s => s?.Name.Code ?? "")"
                               @bind-Value="_model.Carpark" Required="true">
                        @foreach (var c in CarparkService.DataSource)
                        {
                            <MudSelectItem T="CarparkDto" Value="c">@c.Name.Code</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Codigo Zona" @bind-Value="_model.Name.Code" Required="true"></MudTextField>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nombre Zona" @bind-Value="_model.Name.Tc" Required="true"></MudTextField>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Label="Descripcion" @bind-Value="_model.Description"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudLoadingButton Loading="@_saving" OnClick="OnSubmit" Color="Color.Primary" Variant="Variant.Filled">Guardar</MudLoadingButton>
    </DialogActions>
</MudDialog>

@code {
    MudForm _zoneForm = new();
    private bool _saving;
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [EditorRequired] [Parameter] public AddEditZoneCommand _model { get; set; } = null!;

    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _zoneForm.Validate();
            if (!_zoneForm.IsValid) return;
            var result = await Mediator.Send(_model);
            result.Match(data => { MudDialog.Close(DialogResult.Ok(true)); Snackbar.Add("Zona guardada", Severity.Success); },
                          errors => Snackbar.Add(errors, Severity.Error));
        }
        finally { _saving = false; }
    }

    void Cancel() => MudDialog.Cancel();
}
