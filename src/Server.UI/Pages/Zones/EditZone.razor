@page "/pages/zones/edit/{id:int}"
@using CleanArchitecture.Blazor.Application.Features.Zones.Commands.Update
@using CleanArchitecture.Blazor.Application.Features.Zones.Queries.GetById
@using CleanArchitecture.Blazor.Server.UI.Components.Sessions

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Zones> L
@attribute [Authorize(Policy = Permissions.Zones.Edit)]

<PageTitle>@Title</PageTitle>
<Breadcrumbs OnSaveButtonClick="OnSubmit" Saving="_saving" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
@if (_model != null)
{
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                 <MudText Typo="Typo.h6">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
        <ActiveUserSession PageComponent="@($"{nameof(EditZone)}/{ _model.Id }")" />
        <MudForm Model="@_model" @ref="@_zoneForm" Validation="@(Validator.ValidateValue(_model))">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6"> 
                        <MudCheckBox Label="@L[_model.GetMemberDescription(x=>x.IsMain)]" @bind-Value="_model.IsMain" For="@(() => _model.IsMain)" Color="Color.Primary" ></MudCheckBox>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudNumericField  Label="@L[_model.GetMemberDescription(x=>x.CarparkId)]" @bind-Value="_model.CarparkId" For="@(() => _model.CarparkId)" Min="0" Required="false" RequiredError="@L["carpark id is required!"]"></MudNumericField >
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.HolidaySets)]" @bind-Value="_model.HolidaySets" For="@(() => _model.HolidaySets)" Required="false" RequiredError="@L["holiday sets is required!"]"></MudTextField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudCheckBox Label="@L[_model.GetMemberDescription(x=>x.IsOpenCashbox)]" @bind-Value="_model.IsOpenCashbox" For="@(() => _model.IsOpenCashbox)" Color="Color.Primary" ></MudCheckBox>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.Description)]"  For="@(() => _model.Description)" @bind-Value="_model.Description"></MudTextField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <MudTextField Label="@L[_model.GetMemberDescription(x=>x.Identifier)]" @bind-Value="_model.Identifier" For="@(() => _model.Identifier)" Required="false" RequiredError="@L["identifier is required!"]"></MudTextField>
                </MudItem> 

            </MudGrid>
        </MudForm>
        </MudCardContent>
        <MudCardActions Class="d-flex justify-end gap-2">
                    <MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
        </MudCardActions>
        </MudCard>
    }
</MudContainer>
 

@code {
    public string? Title { get; private set; }
    [Parameter]
    public int Id { get; set; }
    MudForm _zoneForm = new();
    private bool _saving = false;
    private List<BreadcrumbItem>? _breadcrumbItems;
    private UpdateZoneCommand? _model;
    protected override async Task OnInitializedAsync()
    {
        Title = L["Edit Zone"];
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem(L["Home"], href: "/"),
            new BreadcrumbItem(L["Zones"], href: "/pages/zones")
        };
        var result = await Mediator.Send(new GetZoneByIdQuery() { Id = Id });
        result.Map(data =>
        {
            _model = Mapper.Map<UpdateZoneCommand>(data);
            return data;
        }).Match(data =>
        {
            _breadcrumbItems.Add(new BreadcrumbItem(data.Name.Code, href: $"/pages/zones/edit/{Id}"));
        }, errors =>
        {
            Snackbar.Add($"{errors}", Severity.Error);
        });

    }
    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _zoneForm.Validate().ConfigureAwait(false);
            if (!_zoneForm.IsValid)
                return;
            var result = await Mediator.Send(_model);
            result.Match(
                data=>
                {
                    Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                },
                errors=>
                {
                    Snackbar.Add(errors, MudBlazor.Severity.Error);
                });
        }
        finally
        {
            _saving = false;
        }
    }
}
