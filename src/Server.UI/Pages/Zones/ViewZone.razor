@page "/pages/zones/view/{id:int}"
@using CleanArchitecture.Blazor.Application.Features.Zones.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Zones.DTOs
@using CleanArchitecture.Blazor.Application.Features.Zones.Queries.GetById
@inherits MudComponentBase
@inject IStringLocalizer<Zones> L
@attribute [Authorize(Policy = Permissions.Zones.View)]
<PageTitle>@Title</PageTitle>
<Breadcrumbs  OnGoEditClick="GoEdit" OnDeleteClick="Delete" BreadcrumbItems="_breadcrumbItems"></Breadcrumbs>
<MudContainer Class="mt-3" MaxWidth="MaxWidth.Large">
@if (_model != null)
{
    <MudCard Class="pa-2">
        <MudCardHeader>
            <CardHeaderContent>
                 <MudText Typo="Typo.h6">@Title</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid Spacing="3" Class="readonly-grid">
                <MudItem xs="12" md="6"> 
                        <ReadOnlyField CheckBox="true" Label="@L[_model.GetMemberDescription(x=>x.IsMain)]" Value="_model.IsMain"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.CarparkId)]" Value="_model.CarparkId"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.HolidaySets)]" Value="_model.HolidaySets"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField CheckBox="true" Label="@L[_model.GetMemberDescription(x=>x.IsOpenCashbox)]" Value="_model.IsOpenCashbox"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.Description)]" Value="_model.Description"></ReadOnlyField>
                </MudItem> 
<MudItem xs="12" md="6"> 
                        <ReadOnlyField Label="@L[_model.GetMemberDescription(x=>x.Identifier)]" Value="_model.Identifier"></ReadOnlyField>
                </MudItem> 

            </MudGrid>
        </MudCardContent>
        <MudCardActions></MudCardActions>
    </MudCard>
 }
</MudContainer>
 

@code {
    public string? Title { get; private set; }
    [Parameter]
    public int Id { get; set; }
    private List<BreadcrumbItem>? _breadcrumbItems; 
    private ZoneDto? _model;
    protected override async Task OnInitializedAsync()
    {
        Title = L["Zone"];
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem(L["Home"], href: "/"),
            new BreadcrumbItem(L["Zones"], href: "/pages/zones")
        };
        var result = await Mediator.Send(new GetZoneByIdQuery() { Id = Id });
        result.Map(data =>
        {
            _model = data;
            return data;
        }).Match(data =>
        {
            _breadcrumbItems.Add(new BreadcrumbItem(data.Name.Code, null, disabled: true));
        }, errors =>
        {
            Snackbar.Add(errors, MudBlazor.Severity.Error);
        });

    }
    void GoEdit()
    {
        Navigation.NavigateTo($"/pages/Zones/edit/{Id}");
    }
    async Task Delete()
    {
        var contentText = string.Format(AppStrings.DeleteConfirmation, _model.Name);
        var command = new DeleteZoneCommand(new int[] { _model.Id });
        await DialogServiceHelper.ShowDeleteConfirmationDialogAsync(command, AppStrings.DeleteConfirmationTitle, contentText, async () =>
        {
            await InvokeAsync(() =>
            {
                Navigation.NavigateTo($"/pages/Zones");
            });
        });
    }
}
